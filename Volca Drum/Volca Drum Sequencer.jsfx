  : fphit ? (fpset(fillp + n < -1 ? NPAT - 1 : fillp + n >= NPAT ? -1 : fillp + n);)
  : chslot >= 0 && chslot < chlen ? (CHL[chslot] = (CHL[chslot] + n + NPAT) % NPAT; sprintf(#rd, "CHAIN %s", chstr()); msgt = now; bump();)
  : hreg == 3 ? (
