// v0.58: one undo snapshot per wheel gesture (same control, pauses under 1 s), not per notch
function wsnap() ( now - wsnt > 1 || hreg != wsnh || hp != wsnp ? snap(); wsnt = now; wsnh = hreg; wsnp = hp; );
mouse_wheel != 0 ? (
