desc:Volca Drum Sequencer
// VOLCA DRUM SEQUENCER 1.0 by NH4X - step sequencer for the Korg volca drum, as one JSFX.
// Part of the NH4X Volca Drum Suite: https://github.com/NH4Xnet/volca-drum-suite  (manual + setup in the README there)
// Music: https://nh4x.bandcamp.com/
//
// SETUP
//  1. Install via ReaPack (repository above). Track with the volca's MIDI hardware output:
//     "JS: Volca Drum Sequencer" FIRST, then "JS: Volca Drum Panel" after it. The order matters:
//     the sequencer sends notes 65/67/69/71/72/74 on channel 1, the panel turns them into part 1-6 (channel 1-6)
//     and gives the sequencer its sound values for p-locks.
//  2. Volca: split channel mode, firmware vdcf 1.22 by hj-oja recommended (velocity 63 = panel LEVEL, below = ghost,
//     above = accent). Turn MIDI clock to the volca's port off, or the volca's own sequencer starts with REAPER.
//  3. Run the action "Volca listener (start)" once and answer Yes (needed for REGIONS = patterns only).
//
// WHAT IT DOES
//  6 lanes x 64 steps, per-lane length + rate (polymeter), per-step velocity, slice (ratchets), condition (chance,
//  A:B, 1ST, FILL, PRE, NEI), offset, ramp, trigless p-locks. 16 patterns, chain, fill pattern, regions = patterns,
//  kit per pattern, swing, humanize, direction, mute/solo, evolve, chaos, density, beat generator, accent row,
//  duck trigger (C1 on channel 10, see the action "Volca duck to selected tracks"), tap record.
//  SYNC REAPER = locked to the project position (loops, jumps, render); FREE = own play button and tempo.
//  Rest the mouse 1 s on a control = a short tip in the readout. Pattern data is saved with the project.
//  Ctrl+C / V / A / Z stay with REAPER: use the right-click menus for copy / paste / undo.

options:no_meter gmem=NH4XVolca maxmem=1048576
in_pin:none
out_pin:none

slider1:0<0,1,1{REAPER,FREE}>-Sync
slider2:120<20,300,0.1>-Free BPM
slider3:0<0,1,1{Project tempo,Own BPM}>-Free tempo
slider4:0<0,1,1{Stopped,Running}>-Free run
slider5:0<0,1000000,1>-Edit counter
slider6:0<0,7,1{OFF,1/2 bar,1 bar,2 bars,3 bars,4 bars,8 bars,16 bars}>-Master length
slider7:0<0,1,1{Off,On}>-Fill
slider8:1<1,16,1>-Pattern
slider9:50<50,75,1>-Swing
slider10:0<0,1,1{Off,On}>-Chain
slider11:0<0,13,1{Classic red,Sleeve red,Hazard,Cold steel,Amber CRT,Field olive,Concrete,Xerox,Plant light,Blueprint,Night vision,Oxblood,Rust,Plant grey}>-Color
slider12:0<0,1,1{Classic,Sleeve}>-Look
slider13:0<0,63,1>-Mute bits
slider14:0<0,63,1>-Solo bits
slider15:0<0,100,1>-Chaos
slider16:0<0,63,1>-Duck bits
slider17:0<0,1,1{Off,On}>-Tap record
slider18:0<-100,200,1>-Tap record compensation (ms)
slider19:0<0,4,1{OFF,1 bar,2 bars,4 bars,8 bars}>-Evolve every
slider20:2<1,3,1>-Evolve changes
slider21:63<0,63,1>-Evolve parts
slider22:0<0,1,1{Off,On}>-Regions = patterns
slider23:0<0,4,1{OFF,2 bars,4 bars,8 bars,16 bars}>-Auto fill every
slider24:0<-100,100,1>-Density

@init
ext_noinit = 1;
gfx_ext_retina = 1;   // sharp canvas on HiDPI screens (layout scales from gfx_w / gfx_h)
NP = 6; NSTEP = 64; NR = 8; NSL = 23; NC = 20;
// memory map
ON = 0; VEL = 400; LEN = 800; RATE = 810; NOTE = 820; CUR = 840; OFFAT = 850; RQ = 870; MBARS = 880; SW = 890; DIR = 900; CHL = 910; RMP = 1000;
SLC = 2000; CND = 2400; OFS = 2800; HT = 3200; HV = 3210; CHN = 4400;   // CHN = chance per step 0-100 (2026-11-04)
DEC = 3300; DECK = 3700; STARTL = 4100; LASTRES = 4110;
// v0.57 per lane: DHW = highest grid time decided in this run, LCB / LCL = grid time of a step that was decided too late
// for its early hit + the earliest moment it can still play (catch-up)
DHW = 4120; LCB = 4130; LCL = 4140;
LFB = 4150; SWK = 4160;   // v0.58.2 per lane: LFB = grid time of the last step with a hit before its grid time, SWK = switch-point step the new pattern skips
SLP = 4200; CNM = 4260; CTYPE = 4300; CA = 4330; CB = 4360;
EV = 10000;
// P-LOCKS (2026-11-04): PL[(lane*64 + step)*26 + k] = locked value 0-127 or -1. k 0-21 = the lane's panel params
// (L1 x7, L2 x7, PAN BIT FOLD DRIVE GAIN SEND FILT CLIP), 22-25 = waveguide (MODEL DECAY BODY TUNE).
// Panel values / CC / channel come from the panel via gmem[1000+n] / [1200+n] / [1400+n], gmem[999] = panel present.
NPL = 26; PL = 40000; LKSENT = 50000; LKACT = 50400; LKVAL = 50600; WGOWN = 50800;
LKRST = 52000;   // v0.37.2: restores (back to the panel value) go out half a step early, once per played step
// PATTERNS (2026-11-04): the arrays above are the CURRENT pattern; 16 stored copies live in the bank
// (per pattern: ON +0, VEL +400, SLC +800, CND +1200, OFS +1600, CHN +2000, LEN +2400, RATE +2410, HT +2420, HV +2430, PL +2440,
//  SW +12430, DIR +12440)
NPAT = 16; PB = 100000; PSZ = 12500; PCLIP = 300000;
RMPB = 320000; PRCLIP = 326200;   // ramps: own bank (16 x 384) + pattern clipboard
PIT = 1400; PBNOTE = 1800; PON = 1810; OFFN = 1820; OFFC = 1830;   // pitch per step, lane base note + on/off, note-off note + channel
PITB = 330000; PPCLIP = 336200;   // pitch: own bank (16 x 384) + pattern clipboard
GRV = 1840; GAM = 1850; GT = 38000; GV = 38200; NGR = 9;
CTG = 6000; CTGB = 340000; PCTCLIP = 346200; UCT = 39000;
KITB = 380000; KITCLIP = 382400;   // v0.50 kit per pattern: 136 panel values + [136] flag, per slot (16 x 140) + clipboard
UKIT = 382600;   // v0.51: kit copy for undo of RESET PATTERN (ukp = pattern it belongs to, -1 = none)
KPSV = 383000;   // v0.57.2: panel sound (136 values) from just before a kit pre-send
KCLIP = 382800; kcfull = 0;   // v0.52: kit clipboard of the KIT tab (140), kcfull = 1 when it holds a kit
TQ = 7000;   // tap record queue: offset, lane, velocity (max 32 per block)
// tap record: hit at QN position t -> nearest step of lane p (same step math as playback: master cycle, direction)
function tput(p, t, v) local(sl, tln, tlc, c, j, k, st, ix) (
  sl = RQ[RATE[p]]; tln = max(1, LEN[p]); tlc = (DIR[p] == 2 && tln > 1 ? 2 * tln - 2 : tln);
  c = (b_m > 0 ? floor(t / b_m) : 0);
  j = floor((t - c * b_m) / sl + 0.5);
  b_m > 0 && j * sl >= b_m - 0.000001 ? (c += 1; j = 0;);   // rounded past the cycle end = step 1 of the next cycle
  k = j % tlc;
  st = (DIR[p] == 1 ? tln - 1 - k : DIR[p] == 2 ? (k < tln ? k : tlc - k) : k);   // RANDOM records like forward
  ix = p * NSTEP + st;
  ON[ix] = 1; VEL[ix] = max(1, min(127, v));
  DECK[ix] = c * 100000 + j; DEC[ix] = 0;   // played live: the grid step stays silent in this pass
  trecn += 1;
);
AC = 6400; ACB = 350000; ACCLIP = 351400; UAC = 39500;
EVC = 360000; EVC[0] = -1000000; EVC[40] = -1000000;
LKR = 370000; memset(LKR, 0, 9984);   // LOCK RANGE: last value sent per step + param (GUI shows it as a tick)   // EVOLVE cache: 2 bars x (key + 3 changes x 6)
ACP = 6500; ACPB = 352000; ACPCLIP = 352600; UACP = 39600;   // accent param amounts (26)   // accent row: current (80) + bank (16 x 80) + pattern clipboard + undo copy
function acdef(b) ( memset(b, 0, 80); b[64] = 16; b[65] = 2; b[66] = 40; b[67] = 63; b[68] = 1; );   // condition target per step + bank + pattern clipboard + undo copy   // groove per lane (template, amount) + template tables
// groove templates: timing in % of a step (+ = late), velocity in % (+ = louder); 16 values each
function gdef(t, i, tm, vl) ( GT[t * 16 + i] = tm; GV[t * 16 + i] = vl; );
gi_ = 0;
loop(16,
  gdef(0, gi_, 0, 0);
  gdef(1, gi_, gi_ % 2 ? -12 : gi_ % 4 == 2 ? -8 : 0, 0);                                    // PUSH: offbeats early
  gdef(2, gi_, gi_ == 4 || gi_ == 12 ? 18 : gi_ % 2 ? 4 : 0, gi_ == 4 || gi_ == 12 ? 8 : 0); // LAZY: 2 and 4 late
  gdef(4, gi_, gi_ % 2 ? 16 : 0, gi_ % 2 ? -15 : 0);                                         // MPC 16: 16th shuffle
  gdef(5, gi_, gi_ % 4 == 2 ? 22 : 0, gi_ % 4 == 2 ? -10 : 0);                               // SHUFFLE 8: 8th shuffle
  gdef(6, gi_, 0, gi_ % 4 == 0 ? 25 : gi_ % 4 == 2 ? 10 : -25);                              // ACCENT HAT: loud soft mid soft
  gdef(7, gi_, gi_ % 4 == 2 ? -6 : 0, gi_ % 4 == 2 ? 30 : gi_ % 2 ? -15 : 0);                 // EBM DRIVE: offbeat pump
  gi_ += 1;
);
// DRUNK (3) and HUMAN (8): fixed tables
gi_ = 0; loop(16, GT[3 * 16 + gi_] = (gi_ == 0 ? 0 : gi_ == 1 ? 9 : gi_ == 2 ? -6 : gi_ == 3 ? 14 : gi_ == 4 ? -3 : gi_ == 5 ? 7 : gi_ == 6 ? -11 : gi_ == 7 ? 5 :
                                    gi_ == 8 ? 2 : gi_ == 9 ? -8 : gi_ == 10 ? 12 : gi_ == 11 ? -4 : gi_ == 12 ? 6 : gi_ == 13 ? -13 : gi_ == 14 ? 3 : 10);
                 GV[3 * 16 + gi_] = (gi_ % 3 == 0 ? 6 : gi_ % 3 == 1 ? -8 : 2); gi_ += 1;);
gi_ = 0; loop(16, GT[8 * 16 + gi_] = (gi_ == 0 ? 0 : gi_ == 1 ? 3 : gi_ == 2 ? -2 : gi_ == 3 ? 4 : gi_ == 4 ? 1 : gi_ == 5 ? -3 : gi_ == 6 ? 2 : gi_ == 7 ? 5 :
                                    gi_ == 8 ? 0 : gi_ == 9 ? 4 : gi_ == 10 ? -3 : gi_ == 11 ? 2 : gi_ == 12 ? 1 : gi_ == 13 ? -2 : gi_ == 14 ? 3 : 6);
                 GV[8 * 16 + gi_] = (gi_ == 0 ? 12 : gi_ == 1 ? -8 : gi_ == 2 ? 4 : gi_ == 3 ? -10 : gi_ == 4 ? 8 : gi_ == 5 ? -6 : gi_ == 6 ? 5 : gi_ == 7 ? -9 :
                                    gi_ == 8 ? 10 : gi_ == 9 ? -7 : gi_ == 10 ? 3 : gi_ == 11 ? -12 : gi_ == 12 ? 6 : gi_ == 13 ? -5 : gi_ == 14 ? 4 : -8); gi_ += 1;);
function gname(t) ( t == 0 ? "OFF" : t == 1 ? "PUSH" : t == 2 ? "LAZY" : t == 3 ? "DRUNK" : t == 4 ? "MPC 16" : t == 5 ? "SHUFFLE 8" :
                    t == 6 ? "ACCENT HAT" : t == 7 ? "EBM DRIVE" : "HUMAN"; );
// v0.56: short groove names for the lane's SWG/GRV box (4 characters)
function gshort(t) ( t == 1 ? "PUSH" : t == 2 ? "LAZY" : t == 3 ? "DRNK" : t == 4 ? "MPC" : t == 5 ? "SHF8" : t == 6 ? "AHAT" : t == 7 ? "EBM" : "HUMN"; );
// ---- BEAT generator style tables (v0.59, 2026-11-13) ----
// Styles 0-4 (EBM, AGGROTECH, TECHNO, ELECTRO, INDUSTRIAL) keep their rule code (gprob/gvel). Styles 5+ are data:
// defr(style, role, P, I, V, S, C), one char per step (a single char = all steps), roles 0 kick 1 snare 2 closed hat
// 3 open hat 4 perc 5 clap/fx. P = hit chance (. = 0, 1-9 = 10-90 %, X = 100 %), I = chance added at full INTENSITY
// (same scale), V = velocity (1-9 = 24-120, X = 127, . = 72), S = slice on a hit (1 x2, 2 x3, 3 x4, 4 x6, 5 x8; more
// likely with intensity), C = condition (2 = 1:2, 4 = 1:4, 8 = 1:8 -> step always set; L = 4:4, F = FILL -> set from
// 50 % intensity; a step that hits anyway keeps playing, only its slice waits for the condition).
// defm(style, len, rate) = meter (16 x 1/16 default; 12 x 1/8T = triplet 4/4 bar; 12 x 1/16 = 3/4 bar).
// defg(style, role, groove, amount, len, swing) = FEEL extras (0 = leave).
NSTY = 28; GTP = 400000; GTI = 403000; GTV = 406000; GTS = 409000; GTC = 412000; GSG = 415000;
GSLEN = 416000; GSRATE = 416100; GORD = 416200; GSN = 416300;
function gch(s, i) ( strlen(s) == 1 ? str_getchar(s, 0) : i < strlen(s) ? str_getchar(s, i) : '.'; );
function defr(st, ro, sp, si, sv, ss, sc) local(b, i, c) (
  b = (st * 6 + ro) * 16; i = 0;
  loop(16,
    c = gch(sp, i); GTP[b + i] = c == 88 ? 1 : c >= '1' && c <= '9' ? (c - '0') / 10 : 0;
    c = gch(si, i); GTI[b + i] = c == 88 ? 1 : c >= '1' && c <= '9' ? (c - '0') / 10 : 0;
    c = gch(sv, i); GTV[b + i] = c == 88 ? 127 : c >= '1' && c <= '9' ? (c - '0') * 12 + 12 : 72;
    c = gch(ss, i); GTS[b + i] = c >= '1' && c <= '5' ? c - '0' : 0;
    c = gch(sc, i); GTC[b + i] = c == '2' ? 1 : c == '4' ? 6 : c == '8' ? 10 : c == 76 ? 9 : c == 70 ? 14 : 0;   // 88 = X, 76 = L, 70 = F
    i += 1;
  );
);
function defm(st, n, r) ( GSLEN[st] = n; GSRATE[st] = r; );
function defg(st, ro, g, a, n, w) local(b) ( b = (st * 6 + ro) * 4; GSG[b] = g; GSG[b + 1] = a; GSG[b + 2] = n; GSG[b + 3] = w; );
memset(GTP, 0, 15000); memset(GSG, 0, 672); gi_ = 0; loop(NSTY, defm(gi_, 16, 2); gi_ += 1;);
GSN[0] = "EBM"; GSN[1] = "AGGROTECH"; GSN[2] = "TECHNO"; GSN[3] = "ELECTRO"; GSN[4] = "INDUSTRIAL";
GSN[5] = "OLD EBM"; GSN[6] = "FUTUREPOP"; GSN[7] = "RHYTHM NOISE"; GSN[8] = "ELECTRO-IND"; GSN[9] = "COLDWAVE";
GSN[10] = "HOUSE"; GSN[11] = "UK GARAGE"; GSN[12] = "DUB TECHNO"; GSN[13] = "BREAKBEAT"; GSN[14] = "DNB / JUNGLE";
GSN[15] = "BOOM BAP"; GSN[16] = "TRAP"; GSN[17] = "DEMBOW"; GSN[18] = "ROCK"; GSN[19] = "DISCO"; GSN[20] = "FUNK";
GSN[21] = "ONE DROP"; GSN[22] = "BOSSA NOVA"; GSN[23] = "SAMBA"; GSN[24] = "SWING"; GSN[25] = "WALTZ 3/4";
GSN[26] = "SHUFFLE 12/8"; GSN[27] = "MARCH";
// menu order + groups: GORD = display slot -> style; group starts at slots 0, 8, 12, 15, 18
GORD[0] = 0; GORD[1] = 1; GORD[2] = 4; GORD[3] = 5; GORD[4] = 6; GORD[5] = 7; GORD[6] = 8; GORD[7] = 9;
GORD[8] = 2; GORD[9] = 10; GORD[10] = 11; GORD[11] = 12;
GORD[12] = 3; GORD[13] = 13; GORD[14] = 14;
GORD[15] = 15; GORD[16] = 16; GORD[17] = 17;
gi_ = 18; loop(10, GORD[gi_] = gi_; gi_ += 1;);
//            P                   I                   V                   S                   C
// 5 OLD EBM (DAF / Nitzer Ebb): stiff 4/4, backbeat, almost no hats, 8th perc
defr(5, 0, "X...X...X...X...", "..............3.", "7", ".", ".");
defr(5, 1, "....X.......X...", "...............2", "7", ".", ".");
defr(5, 2, "..5...5...5...5.", "..4...4...4...4.", "5", ".", ".");
defr(5, 3, ".",                "..........3.....", "5", ".", ".");
defr(5, 4, "6.6.6.6.6.6.6.6.", "3.3.3.3.3.3.3.3.", "6.4.6.4.6.4.6.4.", ".", ".");
defr(5, 5, "....8.......8...", ".",                "6", ".", ".");
// 6 FUTUREPOP (Covenant / VNV): 4/4, snare+clap backbeat, 16th hats, offbeat open hat
defr(6, 0, "X...X...X...X...", "..............2.", "7", ".", ".");
defr(6, 1, "....X.......X...", "...........1...3", "7", ".", "...............L");
defr(6, 2, "7373737373737373", "1616161616161616", "5354535453545354", ".", ".");
defr(6, 3, "..X...X...X...X.", ".",                "6", ".", ".");
defr(6, 4, "...4...4...4...4", "...4..34...4..34", "4", ".", ".");
defr(6, 5, "....X.......X...", ".",                "6", ".", "8...............");
defg(6, 2, 1, 30, 0, 0);
// 7 RHYTHM NOISE (Noisex / Ad·ver·sus): 3-3-2 kick, perc in 12, fx in 15, noisy ghosts and rolls
defr(7, 0, "X..X..X.X..X..X.", "..............4.", "8", ".", ".");
defr(7, 1, "........X.......", "....3.......3..3", "7", "...............2", "...............L");
defr(7, 2, "5",                "4",                "4", "..2...2...2...2.", ".");
defr(7, 3, ".",                "3",                "5", ".", ".");
defr(7, 4, "X..X..X..X..",     "4",                "6", ".", ".");
defr(7, 5, "2",                "3",                "6", "3", ".");
defg(7, 2, 3, 40, 0, 0); defg(7, 4, 0, 0, 12, 0); defg(7, 5, 0, 0, 15, 0);
// 8 ELECTRO-IND (Skinny Puppy): broken kick, loose shuffled hats, metal perc
defr(8, 0, "X.....5...X..3..", "...3.......3....", "7", ".", ".");
defr(8, 1, "....X.......X...", ".3.....2.......3", "4444744444447444", ".", ".");
defr(8, 2, "7.6.7.6.7.6.7.6.", ".4.4.4.4.4.4.4.4", "6343634363436343", ".", ".");
defr(8, 3, "......4.......4.", "..2.......2.....", "5", ".", ".");
defr(8, 4, "3..5..3...5..3..", "3",                "5", ".", ".");
defr(8, 5, "............6...", "....3..........4", "6", ".", ".");
defg(8, 0, 2, 40, 0, 0); defg(8, 2, 0, 0, 0, 60); defg(8, 4, 8, 70, 0, 0);
// 9 COLDWAVE (minimal wave drum machine): plain kick/snare, steady 8th hats
defr(9, 0, "X.......X.X.....", "......3.........", "7", ".", ".");
defr(9, 1, "....X.......X...", "...............2", "7", ".", ".");
defr(9, 2, "X.X.X.X.X.X.X.X.", ".",                "6.5.6.5.6.5.6.5.", ".", ".");
defr(9, 3, ".",                "..............4.", "6", ".", ".");
defr(9, 4, ".",                "..........3..4..", "5", ".", ".");
defr(9, 5, ".",                "....3.......3...", "5", ".", ".");
// 10 HOUSE: 4/4, offbeat open hat, clap 2+4, shaker 16ths
defr(10, 0, "X...X...X...X...", ".",                "7", ".", ".");
defr(10, 1, ".",                "....3.......3..3", "6", ".", ".");
defr(10, 2, "73.373.373.373.3", "2",                "6", ".", ".");
defr(10, 3, "..X...X...X...X.", ".",                "6", ".", ".");
defr(10, 4, "4",                "6",                "3545354535453545", ".", ".");
defr(10, 5, "....X.......X...", ".",                "7", ".", ".");
defg(10, 2, 4, 50, 0, 0); defg(10, 4, 4, 60, 0, 0);
// 11 UK GARAGE (2-step): skippy kick, shuffled hats
defr(11, 0, "X.........X.....", "......3......3..", "7", ".", ".");
defr(11, 1, "....X.......X...", "..............2.", "7", ".", ".");
defr(11, 2, "..X...X...X...X.", ".3.3.3.3.3.3.3.3", "6", ".", ".");
defr(11, 3, ".",                "...........3....", "5", ".", ".");
defr(11, 4, "...5......5.....", "3",                "5", ".", ".");
defr(11, 5, "....6.......6...", ".",                "6", ".", ".");
defg(11, 0, 4, 40, 0, 0); defg(11, 2, 4, 70, 0, 0); defg(11, 4, 4, 70, 0, 0);
// 12 DUB TECHNO: soft 4/4, offbeat rim clicks, lots of space
defr(12, 0, "X...X...X...X...", ".",                "6", ".", ".");
defr(12, 1, ".",                "..............3.", "4", ".", ".");
defr(12, 2, "..6...6...6...6.", "1",                "4", ".", ".");
defr(12, 3, ".",                "..3...3...3...3.", "4", ".", ".");
defr(12, 4, "...5.....5....5.", "..3....3....3...", "5", ".", ".");
defr(12, 5, ".",                "....2.......2...", "4", ".", ".");
defg(12, 2, 0, 0, 0, 56); defg(12, 4, 8, 40, 0, 0);
// 13 BREAKBEAT (Amen-style): spread kick, backbeat with ghost snares
defr(13, 0, "X.X.......XX....", "......2.........", "7", ".", ".");
defr(13, 1, "....X..7.7..X..6", "..3..3......3...", "3333733434337334", ".", ".");
defr(13, 2, "X.X.X.X.X.X.X.X.", ".2.2.2.2.2.2.2.2", "6454645464546454", ".", ".");
defr(13, 3, ".",                "..............3.", "5", ".", ".");
defr(13, 4, ".",                "......3......3..", "5", ".", ".");
defr(13, 5, ".",                "............3...", "6", ".", ".");
defg(13, 2, 4, 50, 0, 0); defg(13, 1, 0, 0, 0, 58);
// 14 DNB / JUNGLE (two-step, think 170 BPM): kick 1 + 3&, snare 2 + 4, ghosts and rolls
defr(14, 0, "X.........X.....", "......3.......3.", "7", ".", ".");
defr(14, 1, "....X.......X...", ".3....3.3..3...3", "3333833333338333", "...............2", "...............L");
defr(14, 2, "X.X.X.X.X.X.X.X.", ".3.3.3.3.3.3.3.3", "5343534353435343", ".", ".");
defr(14, 3, ".",                "..........4.....", "5", ".", ".");
defr(14, 4, ".",                "...2...2...2...2", "4", "...2...2...2...2", ".");
defr(14, 5, ".",                "............3...", "6", ".", "...............F");
defg(14, 2, 4, 40, 0, 0);
// 15 BOOM BAP (think 90 BPM): lazy kick + snare, swung hats
defr(15, 0, "X......5..X.....", "...3......3..4..", "8", ".", ".");
defr(15, 1, "....X.......X...", "..............2.", "8", ".", ".");
defr(15, 2, "X.X.X.X.X.X.X.X.", ".2.2.2.2.2.2.2.2", "6454645464546454", ".", ".");
defr(15, 3, ".",                "..............3.", "5", ".", ".");
defr(15, 4, ".",                "...3.......3....", "4", ".", ".");
defr(15, 5, "....5.......5...", ".",                "6", ".", ".");
defg(15, 0, 2, 50, 0, 0); defg(15, 1, 2, 50, 0, 0); defg(15, 2, 0, 0, 0, 62);
// 16 TRAP (half-time): snare/clap on 3, sparse 808 kick, hats with rolls
defr(16, 0, "X.....X..X......", "...3.......3..3.", "8", ".", ".");
defr(16, 1, "........X.......", "..............2.", "8", ".", ".");
defr(16, 2, "X.X.X.X.X.X.X.X.", ".2.2.2.2.2.2.2.2", "6", "......3.......4.", ".");
defr(16, 3, ".",                "..........3.....", "5", ".", ".");
defr(16, 4, ".",                "....3.........3.", "5", ".", ".");
defr(16, 5, "........X.......", ".",                "7", ".", ".");
// 17 DEMBOW: 4/4 kick, the boom-ch-boom-chick snare
defr(17, 0, "X...X...X...X...", ".",                "7", ".", ".");
defr(17, 1, "...X..X....X..X.", ".",                "7", ".", ".");
defr(17, 2, "X.X.X.X.X.X.X.X.", ".3.3.3.3.3.3.3.3", "5", ".", ".");
defr(17, 3, ".",                "......3.......3.", "5", ".", ".");
defr(17, 4, ".",                "3",                "4", ".", ".");
defr(17, 5, "...6..6....6..6.", ".",                "5", ".", ".");
// 18 ROCK: kick 1 + 3, snare 2 + 4, 8th hats, tom fill on FILL, crash every 8 loops
defr(18, 0, "X.......X.X.....", "......3......3..", "8", ".", ".");
defr(18, 1, "....X.......X...", "...............3", "8", ".", ".");
defr(18, 2, "X.X.X.X.X.X.X.X.", ".",                "6.5.6.5.6.5.6.5.", ".", ".");
defr(18, 3, ".",                "..............4.", "6", ".", ".");
defr(18, 4, ".",                ".",                "6", ".", "............FFFF");
defr(18, 5, ".",                ".",                "7", ".", "8...............");
// 19 DISCO: 4/4, open hat offbeat, 16th hats
defr(19, 0, "X...X...X...X...", ".",                "7", ".", ".");
defr(19, 1, "....X.......X...", ".",                "7", ".", ".");
defr(19, 2, "X3.3X3.3X3.3X3.3", ".5.5.5.5.5.5.5.5", "5444544454445444", ".", ".");
defr(19, 3, "..X...X...X...X.", ".",                "6", ".", ".");
defr(19, 4, ".",                "...3......3.....", "5", ".", ".");
defr(19, 5, "....5.......5...", "....3.......3...", "6", ".", ".");
defg(19, 2, 0, 0, 0, 54);
// 20 FUNK: syncopated kick, ghost snares, 16th hats
defr(20, 0, "X.X....4..X..5..", "......3........3", "8", ".", ".");
defr(20, 1, "....X..3.3..X..3", ".3....3.....3...", "3333833333338333", ".", ".");
defr(20, 2, "X",                ".",                "6454645464546454", ".", ".");
defr(20, 3, "......5.........", ".",                "6", ".", ".");
defr(20, 4, ".",                "...3...3...3...3", "4", ".", ".");
defr(20, 5, ".",                ".",                "5", ".", ".");
defg(20, 1, 1, 30, 0, 0); defg(20, 2, 0, 0, 0, 56);
// 21 ONE DROP (reggae): kick + rim only on 3, heavy shuffle hats
defr(21, 0, "........X.......", ".",                "8", ".", ".");
defr(21, 1, "........X.......", ".",                "7", ".", ".");
defr(21, 2, "X.X.X.X.X.X.X.X.", ".3.3.3.3.3.3.3.3", "5", ".", ".");
defr(21, 3, ".",                "..............3.", "5", ".", ".");
defr(21, 4, ".",                "....3.......3...", "4", ".", ".");
defr(21, 5, ".",                ".",                "5", ".", ".");
defg(21, 2, 0, 0, 0, 66); defg(21, 4, 0, 0, 0, 66);
// 22 BOSSA NOVA: bossa kick, cross-stick clave, soft 8th hats, shaker
defr(22, 0, "X..XX..XX..XX..X", ".",                "5..45..45..45..4", ".", ".");
defr(22, 1, "X..X..X...X..X..", ".",                "5", ".", ".");
defr(22, 2, "X.X.X.X.X.X.X.X.", ".3.3.3.3.3.3.3.3", "4", ".", ".");
defr(22, 3, ".",                ".",                "5", ".", ".");
defr(22, 4, "5",                "4",                "3", ".", ".");
defr(22, 5, ".",                ".",                "5", ".", ".");
defg(22, 4, 8, 30, 0, 0);
// 23 SAMBA: surdo on 2 + 4, caixa 16ths, ganza shaker, tamborim
defr(23, 0, "X...X...X...X...", ".",                "5...7...5...7...", ".", ".");
defr(23, 1, "X.XXX.XXX.XXX.XX", ".",                "5344534453445344", ".", ".");
defr(23, 2, "X",                ".",                "3534353435343534", ".", ".");
defr(23, 3, ".",                ".",                "5", ".", ".");
defr(23, 4, "X.X..X.X..X..X..", ".",                "6", ".", ".");
defr(23, 5, ".",                "...3......3.....", "5", ".", ".");
defg(23, 2, 0, 0, 0, 56); defg(23, 4, 8, 40, 0, 0);
// 24 SWING (12 x 1/8T = one 4/4 bar in triplets): 3 = hi-hat pedal on 2 + 4, 4 = ride spang-a-lang
defm(24, 12, 3);
defr(24, 0, "X..X..X..X..",     ".",                "4", ".", ".");
defr(24, 1, "........3...",     "..3..3..3..3",     "4", ".", ".");
defr(24, 2, "...X.....X..",     ".",                "5", ".", ".");
defr(24, 3, "X..X.XX..X.X",     ".",                "6..7.56..7.5", ".", ".");
defr(24, 4, ".",                "....3......3",     "5", ".", ".");
defr(24, 5, ".",                ".",                "5", ".", ".");
// 25 WALTZ 3/4 (12 x 1/16 = one 3/4 bar; set the project to 3/4)
defm(25, 12, 2);
defr(25, 0, "X...........",     "........3...",     "7", ".", ".");
defr(25, 1, "....X...X...",     ".",                "6", ".", ".");
defr(25, 2, "X.X.X.X.X.X.",     ".3.3.3.3.3.3",     "5.4.5.4.5.4.", ".", ".");
defr(25, 3, ".",                "..........3.",     "5", ".", ".");
defr(25, 4, ".",                "...3.......3",     "5", ".", ".");
defr(25, 5, "....5...5...",     ".",                "5", ".", ".");
// 26 SHUFFLE 12/8 (12 x 1/8T = one 4/4 bar in triplets): blues shuffle
defm(26, 12, 3);
defr(26, 0, "X.....X.....",     "....3.....3.",     "7", ".", ".");
defr(26, 1, "...X.....X..",     ".",                "7", ".", ".");
defr(26, 2, "X.XX.XX.XX.X",     ".",                "6.46.46.46.4", ".", ".");
defr(26, 3, ".",                "..........3.",     "5", ".", ".");
defr(26, 4, ".",                ".",                "5", ".", ".");
defr(26, 5, "...4.....4..",     ".",                "5", ".", ".");
// 27 MARCH: bass drum on every beat, snare rudiments with rolls, cymbal on 1 + 3
defr(27, 0, "X...X...X...X...", ".",                "7", ".", ".");
defr(27, 1, "X.X.X.XXX.X.X.XX", "1",                "7.5.6.5.7.5.6.45", "......2.......2.", ".");
defr(27, 2, "X.......X.......", ".",                "6", ".", ".");
defr(27, 3, ".",                ".",                "5", ".", ".");
defr(27, 4, ".",                "3...3...3...3...", "5", ".", ".");
defr(27, 5, ".",                ".",                "7", ".", "8...............");
DEFVEL = 63;
NOTE[0] = 65; NOTE[1] = 67; NOTE[2] = 69; NOTE[3] = 71; NOTE[4] = 72; NOTE[5] = 74;
// step length in quarter notes: 1/32, 1/16T, 1/16, 1/8T, 1/8, 1/4T, 1/4, 1/2
RQ[0] = 0.125; RQ[1] = 1/6; RQ[2] = 0.25; RQ[3] = 1/3; RQ[4] = 0.5; RQ[5] = 2/3; RQ[6] = 1; RQ[7] = 2;
MBARS[0] = 0; MBARS[1] = 0.5; MBARS[2] = 1; MBARS[3] = 2; MBARS[4] = 3; MBARS[5] = 4; MBARS[6] = 8; MBARS[7] = 16;

// SLICE: o = hit, _ = rest, read left to right inside one step (patterns from the hj firmware README)
SLP[0] = "o"; SLP[1] = "oo"; SLP[2] = "ooo"; SLP[3] = "oooo"; SLP[4] = "oooooo"; SLP[5] = "oooooooo";
SLP[6] = "_o"; SLP[7] = "oo_"; SLP[8] = "o_o"; SLP[9] = "_o_"; SLP[10] = "_oo"; SLP[11] = "__o";
SLP[12] = "oo__"; SLP[13] = "o__o"; SLP[14] = "ooo_"; SLP[15] = "oo_o"; SLP[16] = "o_oo"; SLP[17] = "_o__";
SLP[18] = "_oo_"; SLP[19] = "_o_o"; SLP[20] = "_ooo"; SLP[21] = "__oo"; SLP[22] = "___o";
function slname(i) ( i == 0 ? "-" : i == 1 ? "x2" : i == 2 ? "x3" : i == 3 ? "x4" : i == 4 ? "x6" : i == 5 ? "x8" : SLP[i]; );

// CONDITION: type 0 none, 1 chance (CA = probability), 2 A:B (loop A of every B), 3 1ST, 4 !1ST,
// 5 FILL, 6 !FILL, 7 PRE, 8 !PRE, 9 NEI, 10 !NEI
function defc(i, nm, t, a, b) ( CNM[i] = nm; CTYPE[i] = t; CA[i] = a; CB[i] = b; );
defc(0, "-", 0, 0, 0);
defc(1, "1:2", 2, 1, 2); defc(2, "2:2", 2, 2, 2); defc(3, "1:3", 2, 1, 3); defc(4, "2:3", 2, 2, 3); defc(5, "3:3", 2, 3, 3);
defc(6, "1:4", 2, 1, 4); defc(7, "2:4", 2, 2, 4); defc(8, "3:4", 2, 3, 4); defc(9, "4:4", 2, 4, 4);
defc(10, "1:8", 2, 1, 8); defc(11, "8:8", 2, 8, 8);
defc(12, "1ST", 3, 0, 0); defc(13, "NO 1ST", 4, 0, 0); defc(14, "FILL", 5, 0, 0); defc(15, "NO FILL", 6, 0, 0);
defc(16, "PRE", 7, 0, 0); defc(17, "NO PRE", 8, 0, 0); defc(18, "NEI", 9, 0, 0); defc(19, "NO NEI", 10, 0, 0);

function rname(r) (
  r == 0 ? "1/32" : r == 1 ? "1/16T" : r == 2 ? "1/16" : r == 3 ? "1/8T" :
  r == 4 ? "1/8" : r == 5 ? "1/4T" : r == 6 ? "1/4" : "1/2";
);
// new run (play start, jump, loop wrap): forget decisions, 1ST and PRE history
function resetrun() local(i) (
  EVC[0] = -1000000; EVC[40] = -1000000;   // EVOLVE: pick new changes after a start / jump
  i = 0; loop(NP * NSTEP, DECK[i] = -1; i += 1;);
  i = 0; loop(NP, STARTL[i] = -1; LASTRES[i] = 0; DHW[i] = -1000000000000; LCB[i] = -1000000000000; LFB[i] = -1000000000000; SWK[i] = -1000000000000; i += 1;);
  i = 0; loop(NP * NSTEP, LKSENT[i] = -1; LKRST[i] = -1; i += 1;);
  rseed = rand(1000);
  b_cut = -1000000000000;   // v0.57.1: every new run forgets the last switch point (FREE restart at 0 stayed silent up to it)
);
// lane p silent? (mute bit set, or another lane soloed)
function lmute(p) local(m, o) ( m = slider13 | 0; o = slider14 | 0; (m & (2 ^ p)) || (o && !(o & (2 ^ p))); );
function lduck(p) ( (slider16 | 0) & (2 ^ p) );
// event list for one block, sent sorted by offset
function addev(o, a, b, c) ( EV[nev * 4] = o; EV[nev * 4 + 1] = a; EV[nev * 4 + 2] = b; EV[nev * 4 + 3] = c; nev += 1; );
// repeatable random 0..1 for one step (same answer however often a step is looked at in one run)
function hash(a, b, c) local(x) ( x = sin(a * 12.9898 + b * 78.233 + c * 37.719 + rseed * 0.6180339) * 43758.5453; x - floor(x); );
// DENSITY (v0.53): stable random (no run seed) + role weight per part (1 = goes first when thinning / comes first when filling)
function dh(a, b, c) local(x) ( x = sin(a * 12.9898 + b * 78.233 + c * 37.719) * 43758.5453; x - floor(x); );
function drole(p) ( p == 0 ? 0 : p == 1 ? 0.3 : p == 2 ? 1 : p == 3 ? 0.7 : p == 4 ? 0.85 : 0.5; );
// grid weight of a QN position: beat 1, 8th 0.5, everything else 0
function dgrid(q) local(f) ( f = q - floor(q); f < 0.001 || f > 0.999 ? 1 : abs(f - 0.5) < 0.001 ? 0.5 : 0; );
function evalcond(p, ci, key, li) local(t, r, upd) (
  t = CTYPE[ci]; r = 1; upd = 1;
  t == 1 ? (r = hash(key, p, 7) < CA[ci];)
  : t == 2 ? (r = (li % CB[ci]) == CA[ci] - 1;)
  : t == 3 ? (r = li == STARTL[p];)
  : t == 4 ? (r = li != STARTL[p];)
  : t == 5 ? (r = b_fill;)
  : t == 6 ? (r = !b_fill;)
  : t == 7 ? (r = LASTRES[p]; upd = 0;)
  : t == 8 ? (r = !LASTRES[p]; upd = 0;)
  : t == 9 ? (r = (p > 0 ? LASTRES[p - 1] : 0); upd = 0;)
  : t == 10 ? (r = (p > 0 ? !LASTRES[p - 1] : 1); upd = 0;);
  t != 0 && upd ? (LASTRES[p] = r;);
  r;
);
// condition AND chance; a chance below 100 % counts as a condition result for PRE / NEI (not on PRE/NEI steps)
function decide(p, ix, key, li) local(t, r) (
  t = CTYPE[CND[ix]];
  r = evalcond(p, CND[ix], key, li);
  CHN[ix] < 100 ? (
    r = r && (hash(key, p, 9) * 100 < CHN[ix]);
    t < 7 ? (LASTRES[p] = r;);
  );
  r;
);
// ---- p-locks ----
// v0.58.3 LINK: lnk = part p has LINK L1+L2 on in the panel; lks = slot used for the lock-range roll (same for both layers);
// plv = lock value of slot k at step base b (linked layer param: L1 lock, else L2 lock); acpv = ACCENT amount the same way
function lnk(p) ( p < 6 && gmem[1720 + p] >= 0.5; );
function lks(p, k) ( lnk(p) && k < 14 ? k % 7 : k; );
function plv(p, b, k) local(j, w) ( lnk(p) && k < 14 ? (j = k % 7; w = PL[b + j]; w < 0 ? (w = PL[b + j + 7];); w;) : PL[b + k]; );
function acpv(p, k) local(j) ( lnk(p) && k < 14 ? (j = k % 7; ACP[j] != 0 ? ACP[j] : ACP[j + 7];) : ACP[k]; );
function pidx(p, k) ( k < 22 ? p * 22 + k + 1 : 133 + k - 22; );   // panel slider number
function sendcc(o, si, v) ( addev(o, $xB0 | gmem[1400 + si], gmem[1200 + si], max(0, min(127, floor(v + 0.5)))); b_ncc += 1; );
// before a lane's next hit: its locks go out, everything it locked before goes back to the panel value
// LKACT/LKVAL: what the Volca holds now (lanes 0-5 x 26, slot 6 = waveguide, owned by the lane that locked it)
// tl = 1 (trigless step): only send this step's locks, leave everything else as it is (the next real hit cleans up)
function reconcile(p, ix, o, tl, nl, ro, acc) local(k, w, a, si, lr) (
  k = 0;
  loop(NPL,
    w = (nl ? -1 : plv(p, ix * NPL, k)); si = pidx(p, k);
    w >= 0 ? (
      lr = floor(w / 128); w = w % 128;
      lr > 0 ? (w += floor((hash(b_key, p * NPL + lks(p, k), 50) - 0.5) * 2 * lr + 0.5););   // LOCK RANGE: roll per hit
      b_ev == 5 ? (w += b_evd;);   // EVOLVE: nudge this step's locks
      w = max(0, min(127, w));
      !ro ? (LKR[ix * NPL + k] = w;);
    );
    w < 0 && acc && !tl && acpv(p, k) != 0 ? (w = max(0, min(127, floor(gmem[1000 + si] + acpv(p, k) + 0.5))););   // ACCENT param
    k < 22 ? (
      a = p * NPL + k;
      w >= 0 ? (!ro && (!LKACT[a] || LKVAL[a] != w) ? (sendcc(o, si, w); LKACT[a] = 1; LKVAL[a] = w;);)
      : LKACT[a] && !tl ? (sendcc(o, si, gmem[1000 + si]); LKACT[a] = 0;);
    ) : (
      a = 6 * NPL + k;
      w >= 0 ? (!ro && (!LKACT[a] || LKVAL[a] != w) ? (sendcc(o, si, w); LKACT[a] = 1; LKVAL[a] = w; WGOWN[k - 22] = p;);)
      : LKACT[a] && WGOWN[k - 22] == p && !tl ? (sendcc(o, si, gmem[1000 + si]); LKACT[a] = 0;);
    );
    k += 1;
  );
);
// transport stop: every active lock back to the panel value
function unlockall(o) local(p, k, a, si) (
  p = 0;
  loop(7,
    k = 0;
    loop(NPL,
      a = p * NPL + k;
      LKACT[a] ? (si = pidx(min(p, 5), k); sendcc(o, si, gmem[1000 + si]); LKACT[a] = 0;);
      k += 1;
    );
    p += 1;
  );
);
// v0.41: restore active locks nobody uses any more (lane silent, lock / step / accent amount gone)
function lksweep(o) local(p, k, a, s, used, si) (
  k = 0;
  loop(NPL,
    p = 0;
    loop(NP,
      a = (k < 22 ? p * NPL + k : 6 * NPL + k);
      LKACT[a] && (k < 22 || WGOWN[k - 22] == p) ? (
        used = !lmute(p) && acpv(p, k) != 0 && ((AC[67] | 0) & (2 ^ p));
        s = 0; !lmute(p) ? loop(max(1, LEN[p]), ON[p * NSTEP + s] && plv(p, (p * NSTEP + s) * NPL, k) >= 0 ? (used = 1;); s += 1;);
        !used ? (si = pidx(p, k); sendcc(o, si, gmem[1000 + si]); LKACT[a] = 0;);
      );
      p += 1;
    );
    k += 1;
  );
);
// play start / jump: params that have locks anywhere in this pattern go to the panel value first (the Volca may hold an
// old value; the first restore would otherwise only come after the first lock)
function presync() local(p, k, s, a, si, has, wg) (
  p = 0; wg = 0;   // wg = waveguide params already sent (they are shared: once is enough, v0.57)
  loop(NP,
    k = 0;
    loop(NPL,
      has = acpv(p, k) != 0 && ((AC[67] | 0) & (2 ^ p)); s = 0; loop(NSTEP, plv(p, (p * NSTEP + s) * NPL, k) >= 0 ? (has = 1;); s += 1;);
      has && k >= 22 ? ((wg & (2 ^ (k - 22))) ? (has = 0;) : (wg += 2 ^ (k - 22);););
      has ? (si = pidx(p, k); sendcc(0, si, gmem[1000 + si]); a = (k < 22 ? p * NPL + k : 6 * NPL + k); LKACT[a] = 0;);
      k += 1;
    );
    p += 1;
  );
);
// v0.57: a ghost hit (chaos, density, evolve) at grid time t: the lane's active locks go back to the panel value first
// (up to 6 ms before the hit, inside this block), so the ghost never sounds with the locks of the step before it
function ghostrst(p, t) (
  pnl ? reconcile(p, p * NSTEP, max(0, min(samplesblock - 1, floor((t - b_pos) / b_qps) - floor(0.006 * srate))), 0, 1, 0, 0);
);
// nt / mch = note + channel nibble (fixed: NOTE[p] on ch 1, pitched: base + step pitch on ch 11-16)
// ---- EVOLVE (v0.47) ----
function afn() ( (slider23 | 0) == 1 ? 2 : (slider23 | 0) == 2 ? 4 : (slider23 | 0) == 3 ? 8 : (slider23 | 0) == 4 ? 16 : 0; );   // AUTO FILL every n bars
// AUTO FILL: is the bar at QN position q a fill bar? (uses b_afn + b_qbar of this block)
function afbar(q) ( b_afn > 0 && q >= 0 && (floor(q / b_qbar + 0.000001) + 1) % b_afn == 0; );
function evn() ( (slider19 | 0) == 1 ? 1 : (slider19 | 0) == 2 ? 2 : (slider19 | 0) == 3 ? 4 : (slider19 | 0) == 4 ? 8 : 0; );
function lnotes(p) local(q, r) ( r = 0; q = 0; loop(max(1, LEN[p]), ON[p * NSTEP + q] ? (r = 1;); q += 1;); r; );
// step index of lane p at grid time t (same rules as the play loop, without chaos jumps); uses b_m of this block
function evstep(p, t) local(el, elc, ed, esl, ec, ej, ek) (
  el = max(1, LEN[p]); esl = RQ[RATE[p]]; ed = DIR[p]; elc = (ed == 2 && el > 1 ? 2 * el - 2 : el);
  ec = (b_m > 0 ? floor(t / b_m) : 0);
  ej = floor((t - ec * b_m) / esl + 0.5); ek = ej % elc;
  ed == 0 ? ek : ed == 1 ? el - 1 - ek : ed == 2 ? (ek < el ? ek : elc - ek) : min(el - 1, floor(hash(ec * 100000 + ej, p, 11) * el));
);
function lkany(ix) local(k, r) ( r = 0; k = 0; loop(NPL, PL[ix * NPL + k] >= 0 ? (r = 1;); k += 1;); r; );   // step has a p-lock
// does grid slot g of lane q in this bar fit change type ty (0 ADD: empty · 1 MOVE: lit, next slot empty · 2 DROP / 3 LOUDER: lit
// · 4 NUDGE: lit with a p-lock)
function evfit(q, ty, bs, sl, g, ns) local(ix, ix2) (
  ix = q * NSTEP + evstep(q, bs + g * sl); ix2 = q * NSTEP + evstep(q, bs + (g + 1) * sl);
  ty == 0 ? !ON[ix] : ty == 1 ? (ON[ix] == 1 && g < ns - 1 && !ON[ix2]) : ty == 4 ? (ON[ix] >= 1 && lkany(ix)) : ON[ix] == 1;
);
// pick the changes of bar eb: per change lane, type, slot, source velocity + pitch
function evsetup(eb) local(r, k, m, p, q, nln, cnt, pick, ty, sl, ns, bs, g, ix) (
  r = (eb % 2) * 40; EVC[r] = eb; m = slider21 | 0;
  k = 0; loop(3, EVC[r + 1 + k * 6] = -1; k += 1;);
  k = 0;
  loop(max(1, min(3, slider20 | 0)),
    nln = 0; p = 0; loop(NP, (m & (2 ^ p)) && !lmute(p) && lnotes(p) ? (nln += 1;); p += 1;);
    nln > 0 ? (
      pick = floor(hash(eb, k, 41) * nln); cnt = 0; q = -1; p = 0;
      loop(NP, (m & (2 ^ p)) && !lmute(p) && lnotes(p) ? (cnt == pick ? (q = p;); cnt += 1;); p += 1;);
      ty = floor(hash(eb, k, 42) * 5);
      sl = RQ[RATE[q]]; ns = max(1, min(64, floor(b_qbar / sl + 0.000001))); bs = eb * b_qbar;
      cnt = 0; g = 0; loop(ns, evfit(q, ty, bs, sl, g, ns) ? (cnt += 1;); g += 1;);
      ty == 4 && cnt == 0 ? (ty = 3; g = 0; loop(ns, evfit(q, ty, bs, sl, g, ns) ? (cnt += 1;); g += 1;););   // no locks in this lane: LOUDER instead
      cnt > 0 ? (
        pick = floor(hash(eb, k, 43) * cnt); cnt = 0; g = 0;
        loop(ns,
          evfit(q, ty, bs, sl, g, ns) ? (
            cnt == pick ? (
              ix = q * NSTEP + evstep(q, bs + g * sl);
              EVC[r + 1 + k * 6] = q; EVC[r + 2 + k * 6] = ty; EVC[r + 3 + k * 6] = g; EVC[r + 5 + k * 6] = PIT[ix];
              EVC[r + 4 + k * 6] = (ty == 4 ? (hash(eb, k, 45) < 0.5 ? -1 : 1) * (10 + floor(hash(eb, k, 46) * 11)) : VEL[ix]);
            );
            cnt += 1;
          );
          g += 1;
        );
      );
    );
    k += 1;
  );
);
function fire(p, h, v, hl, nt, mch) local(o) (
  o = max(0, min(samplesblock - 1, floor((h - b_pos) / b_qps)));
  OFFAT[p] >= 0 ? (addev(o, $x80 | OFFC[p], OFFN[p], 0); OFFAT[p] = -1;);
  addev(o, $x90 | mch, nt, max(1, min(127, floor(v + 0.5))));
  OFFN[p] = nt; OFFC[p] = mch;
  OFFAT[p] = scount + o + max(1, floor(hl / b_qps));
);

// ---- kit per pattern (v0.50) ----
function kithas(n) ( KITB[n * 140 + 136] == 1 );
function kitsend(n) local(b, j) (   // stored kit -> panel (gmem 2601-2736, counter 2600)
  b = KITB + n * 140; j = 0; loop(136, gmem[2601 + j] = b[j]; gmem[1001 + j] = b[j]; j += 1;);   // v0.50.1: restores in this block already use the new kit
  gmem[2737] = n; gmem[2600] = (gmem[2600] + 1) % 1000000;
  j = 0; loop(7 * NPL, LKVAL[j] = -1; j += 1;);   // the kit overwrote what the Volca held: every lock goes out again
);
// v0.57.2: the pre-sent kit was for a pattern that did not come and the playing pattern has no kit: sound from before the pre-send
function kitback() local(j) (
  j = 0; loop(136, gmem[2601 + j] = KPSV[j]; gmem[1001 + j] = KPSV[j]; j += 1;);
  gmem[2737] = -1; gmem[2600] = (gmem[2600] + 1) % 1000000;
  j = 0; loop(7 * NPL, LKVAL[j] = -1; j += 1;);
);
function kitdiff(n) local(b, j, r) (   // how many panel values differ from the stored kit
  b = KITB + n * 140; r = 0; j = 0; loop(136, floor(gmem[1001 + j] + 0.5) != b[j] ? (r += 1;); j += 1;); r;
);
// ---- patterns ----
function psave(n) local(b) (   // current arrays -> bank slot n
  b = PB + n * PSZ;
  memcpy(b, ON, 384); memcpy(b + 400, VEL, 384); memcpy(b + 800, SLC, 384); memcpy(b + 1200, CND, 384);
  memcpy(b + 1600, OFS, 384); memcpy(b + 2000, CHN, 384); memcpy(b + 2400, LEN, 6); memcpy(b + 2410, RATE, 6);
  memcpy(b + 2420, HT, 6); memcpy(b + 2430, HV, 6); memcpy(b + 2440, PL, 9984); memcpy(b + 12430, SW, 6); memcpy(b + 12440, DIR, 6);
  memcpy(RMPB + n * 384, RMP, 384);
  memcpy(PITB + n * 384, PIT, 384); memcpy(b + 12450, PBNOTE, 6); memcpy(b + 12456, PON, 6);
  memcpy(b + 12462, GRV, 6); memcpy(b + 12468, GAM, 6);
  memcpy(CTGB + n * 384, CTG, 384);
  memcpy(ACB + n * 80, AC, 80); memcpy(ACPB + n * 32, ACP, 26);
);
function pload(n) local(b, i) (   // bank slot n -> current arrays
  b = PB + n * PSZ;
  memcpy(ON, b, 384); memcpy(VEL, b + 400, 384); memcpy(SLC, b + 800, 384); memcpy(CND, b + 1200, 384);
  memcpy(OFS, b + 1600, 384); memcpy(CHN, b + 2000, 384); memcpy(LEN, b + 2400, 6); memcpy(RATE, b + 2410, 6);
  memcpy(HT, b + 2420, 6); memcpy(HV, b + 2430, 6); memcpy(PL, b + 2440, 9984); memcpy(SW, b + 12430, 6); memcpy(DIR, b + 12440, 6);
  memcpy(RMP, RMPB + n * 384, 384);
  memcpy(PIT, PITB + n * 384, 384); memcpy(PBNOTE, b + 12450, 6); memcpy(PON, b + 12456, 6);
  memcpy(GRV, b + 12462, 6); memcpy(GAM, b + 12468, 6);
  memcpy(CTG, CTGB + n * 384, 384);
  ACB[n * 80 + 68] != 1 ? acdef(ACB + n * 80); memcpy(AC, ACB + n * 80, 80); memcpy(ACP, ACPB + n * 32, 26);
  i = 0; loop(6, PBNOTE[i] < 1 ? (PBNOTE[i] = 60;); GRV[i] == 0 && GAM[i] == 0 ? (GAM[i] = 100;); i += 1;);   // slots from before v0.31 / v0.33
);
function pinit(b) local(i) (   // empty pattern at memory b (bank slot or clipboard)
  memset(b, 0, 384); i = 0; loop(384, b[400 + i] = DEFVEL; b[2000 + i] = 100; i += 1;);
  memset(b + 800, 0, 1200);
  i = 0; loop(6, b[2400 + i] = 16; b[2410 + i] = 2; b[2420 + i] = 0; b[2430 + i] = 0; i += 1;);
  i = 0; loop(9984, b[2440 + i] = -1; i += 1;);
  memset(b + 12430, 0, 6); memset(b + 12440, 0, 6);
  memset(b == PCLIP ? PRCLIP : RMPB + floor((b - PB) / PSZ + 0.5) * 384, 0, 384);   // ramps of that slot
  memset(b == PCLIP ? PPCLIP : PITB + floor((b - PB) / PSZ + 0.5) * 384, 0, 384);   // pitch of that slot
  memset(b == PCLIP ? PCTCLIP : CTGB + floor((b - PB) / PSZ + 0.5) * 384, 0, 384);   // condition target of that slot
  acdef(b == PCLIP ? ACCLIP : ACB + floor((b - PB) / PSZ + 0.5) * 80);   // accent row of that slot
  memset(b == PCLIP ? ACPCLIP : ACPB + floor((b - PB) / PSZ + 0.5) * 32, 0, 32);   // accent param amounts
  memset(b == PCLIP ? KITCLIP : KITB + floor((b - PB) / PSZ + 0.5) * 140, 0, 140);   // kit of that slot
  i = 0; loop(6, b[12450 + i] = 60; b[12456 + i] = 0; b[12462 + i] = 0; b[12468 + i] = 100; i += 1;);
  b[PSZ - 1] = 777;   // marker: slot is set up
);
// a stored pattern counts as used if it has a step, or a lane with another length / rate
function pused(n) local(b, i, r) (
  b = PB + n * PSZ; r = 0;
  i = 0; loop(384, b[i] ? (r = 1;); i += 1;);
  i = 0; loop(6, b[2400 + i] != 16 || b[2410 + i] != 2 || b[12430 + i] != 0 || b[12440 + i] != 0 || b[12456 + i] != 0 || b[12462 + i] != 0
                 || b[2420 + i] != 0 || b[2430 + i] != 0 || b[12450 + i] != 60 ? (r = 1;); i += 1;);   // v0.60.1: + HT, HV, base note
  b = ACB + n * 80; i = 0; loop(64, b[i] ? (r = 1;); i += 1;);
  b[68] == 1 && (b[64] != 16 || b[65] != 2 || b[69] != 0 || b[66] != 40 || b[67] != 63) ? (r = 1;);   // v0.60.1: + accent amount, lane mask
  b = ACPB + n * 32; i = 0; loop(26, b[i] != 0 ? (r = 1;); i += 1;);
  kithas(n) ? (r = 1;);
  r;
);
function doswitch(n) (
  PB[n * PSZ + PSZ - 1] != 777 ? pinit(PB + n * PSZ);   // never set up (e.g. loaded from an older version)
  psave(curpat); pload(n); curpat = n; resetrun(); lkswp = 1;
  !kithas(n) && kppat >= 0 && kppat != n && pnl ? kitback();   // v0.57.2
  kithas(n) && pnl && n != kppat ? kitsend(n);   // v0.50: the pattern's kit goes to the panel (v0.50.2: unless pre-sent)
  kppat = -1;
  i_ = 0; loop(NP, LEN[i_] < 1 ? (LEN[i_] = 16;); i_ += 1;);
);

function wipecur() local(i) (   // current pattern's working arrays to empty (fresh instance, NEW SESSION)
  memset(ON, 0, NP * NSTEP);
  i = 0; loop(NP * NSTEP, VEL[i] = DEFVEL; i += 1;);
  i = 0; loop(NP, LEN[i] = 16; RATE[i] = 2; i += 1;);
  memset(SLC, 0, NP * NSTEP); memset(CND, 0, NP * NSTEP); memset(OFS, 0, NP * NSTEP);
  memset(HT, 0, NP); memset(HV, 0, NP); memset(SW, 0, NP); memset(DIR, 0, NP); memset(RMP, 0, NP * NSTEP);
  i = 0; loop(NP * NSTEP, CHN[i] = 100; i += 1;);
  memset(PIT, 0, NP * NSTEP); memset(PON, 0, NP); i = 0; loop(NP, PBNOTE[i] = 60; i += 1;);
  memset(GRV, 0, NP); i = 0; loop(NP, GAM[i] = 100; i += 1;);
  memset(CTG, 0, NP * NSTEP); acdef(AC); memset(ACP, 0, 26);
  i = 0; loop(NP * NSTEP * NPL, PL[i] = -1; i += 1;);
);
// v0.57: the play loop as a function (accent row setup + all six lanes for the QN window b_lo .. b_hi), so the block
// with a pattern switch can run it twice: old pattern up to the switch point, new pattern from there
function playlanes() (
  // ACCENT row: own length + rate, restarts with the MASTER cycle (like the lanes)
  b_asl = RQ[max(0, min(NR - 1, AC[65] | 0))]; b_aL = max(1, min(NSTEP, AC[64] | 0)); b_amk = AC[67] | 0;
  b_acs = (b_m > 0 ? floor(b_pos / b_m) * b_m : 0);
  ACUR = (b_pos >= 0 ? floor((b_pos - b_acs) / b_asl + 0.000001) % b_aL : -1);

  b_p = 0;
  loop(NP,
    b_mu = lmute(b_p); b_dk = lduck(b_p);
    b_lact = 0; b_q = 0; loop(max(1, LEN[b_p]), ON[b_p * NSTEP + b_q] ? (b_lact = 1;); b_q += 1;);   // lane has notes (chaos ghosts only there)
    b_mu && OFFAT[b_p] >= 0 ? (addev(0, $x80 | OFFC[b_p], OFFN[b_p], 0); OFFAT[b_p] = -1;);   // muted: cut the ringing note
    b_sl = RQ[RATE[b_p]]; b_L = max(1, LEN[b_p]);
    // swing: odd steps late by (swing / 50 - 1) steps (50 % = 0, 75 % = half a step); lane value or global (slider 9)
    b_swa = ((SW[b_p] >= 50 ? SW[b_p] : max(50, min(75, slider9))) / 50 - 1) * b_sl;
    // steps can sound up to 2.1 steps after (offset + humanize + swing + slice) and 0.5 before their grid time
    b_wlo = b_lo - 2.4 * b_sl; b_whi = b_hi + 0.8 * b_sl;   // v0.33: + groove (+/- 25 %)
    b_m > 0 ? (b_c = floor(b_wlo / b_m); b_c1 = floor(b_whi / b_m);) : (b_c = 0; b_c1 = 0;);
    while (b_c <= b_c1) (
      b_cs = (b_m > 0 ? b_c * b_m : 0);
      b_ce = (b_m > 0 ? b_cs + b_m : 1000000000);
      b_dir = DIR[b_p];
      b_Lc = (b_dir == 2 && b_L > 1 ? 2 * b_L - 2 : b_L);   // steps per lane loop (ping-pong: there and back)
      b_lpc = (b_m > 0 ? ceil(b_m / (b_Lc * b_sl) - 0.000001) : 0);   // lane loops per master cycle
      b_j = max(0, ceil((max(b_wlo, b_cs) - b_cs) / b_sl - 0.000001));
      b_base = b_cs + b_j * b_sl;
      while (b_base < b_whi && b_base < b_ce) (
        b_k = b_j % b_Lc;
        b_st = (b_dir == 0 ? b_k : b_dir == 1 ? b_L - 1 - b_k : b_dir == 2 ? (b_k < b_L ? b_k : b_Lc - b_k)
              : min(b_L - 1, floor(hash(b_c * 100000 + b_j, b_p, 11) * b_L)));
        b_ch > 0.7 && hash(b_c * 100000 + b_j, b_p, 27) < (b_ch - 0.7) ? (b_st = min(b_L - 1, floor(hash(b_c * 100000 + b_j, b_p, 28) * b_L)););   // chaos: jump
        b_ix = b_p * NSTEP + b_st;
        b_key = b_c * 100000 + b_j;
        b_li = b_c * b_lpc + floor(b_j / b_Lc);   // lane loop counter (A:B, 1ST)
        b_base >= b_lo && b_base < b_hi ? (CUR[b_p] = b_st;);
        // decide once per step, half a step before its grid time (or late, right after a start/jump)
        // v0.57: not this pattern's step (before the last switch point, or from a planned switch point on)
        b_skip = b_base < b_cut - 0.000001 || (b_psw && b_base >= b_nb - 0.000001) || abs(b_base - SWK[b_p]) < 0.000001;   // v0.58.2: + the old pattern already played this step's early hit
        DECK[b_ix] != b_key && !b_skip && b_base - 0.8 * b_sl < b_hi && b_base + b_sl > b_lo ? (
          DECK[b_ix] = b_key;
          // first decision of this grid time in this run; too late for an early hit (start, jump, switch) = catch-up point
          b_base > DHW[b_p] + 0.000001 ? (
            DHW[b_p] = b_base;
            b_base >= b_lo - 0.000001 && b_base - 0.75 * b_sl < b_lo ? (LCB[b_p] = b_base; LCL[b_p] = b_lo;);
          );
          STARTL[b_p] < 0 ? (STARTL[b_p] = b_li;);
          b_fill = b_fillm || afbar(b_base);   // FILL / NO FILL: manual or an AUTO FILL bar (by the step's own bar)
          DEC[b_ix] = ON[b_ix] ? decide(b_p, b_ix, b_key, b_li) : 0;
        );
        b_drop = b_ch > 0.3 && hash(b_key, b_p, 23) < (b_ch - 0.3) * 0.5;   // chaos: dropout (max 35 %)
        // EVOLVE: what this step does on an evolve bar (0 nothing, 1 drop, 2 ghost hit, 3 louder, 4 moved-in hit)
        b_ev = 0; b_evd = 0;
        b_evn > 0 && b_base >= 0 ? (
          b_eb = floor(b_base / b_qbar + 0.000001);
          (b_eb + 1) % b_evn == 0 ? (
            b_er = (b_eb % 2) * 40;
            EVC[b_er] != b_eb ? evsetup(b_eb);
            b_gs = floor((b_base - b_eb * b_qbar) / b_sl + 0.5); b_q = 0;
            loop(3,
              EVC[b_er + 1 + b_q * 6] == b_p ? (
                b_et = EVC[b_er + 2 + b_q * 6]; b_eg = EVC[b_er + 3 + b_q * 6];
                b_et == 0 && b_gs == b_eg ? (b_ev = 2; b_evv = 30 + hash(b_eb, b_p, 44) * 18; b_evp = 0;)
                : b_et == 1 && b_gs == b_eg ? (b_ev = 1;)
                : b_et == 1 && b_gs == b_eg + 1 ? (b_ev = 4; b_evv = EVC[b_er + 4 + b_q * 6]; b_evp = EVC[b_er + 5 + b_q * 6];)
                : b_et == 2 && b_gs == b_eg ? (b_ev = 1;)
                : b_et == 3 && b_gs == b_eg ? (b_ev = 3;)
                : b_et == 4 && b_gs == b_eg ? (b_ev = 5; b_evd = EVC[b_er + 4 + b_q * 6];);
              );
              b_q += 1;
            );
          );
        );
        // DENSITY thin out: importance = velocity + beat position + part role; drops when below the knob (kick on beats stays)
        b_dth = 0;
        b_dn < 0 && ON[b_ix] == 1 ? (
          b_imp = 0.35 * min(1, VEL[b_ix] / 110) + 0.3 * (dgrid(b_base) == 1 ? 1 : dgrid(b_base) == 0.5 ? 0.6 : 0.25) + 0.35 * (1 - drole(b_p)) + (dh(b_st, b_p, 61) - 0.5) * 0.06;
          b_dth = b_imp < -b_dn * 0.9;
        );
        b_tg = CTG[b_ix]; b_pass = DEC[b_ix];   // condition target: SLICE / P-LOCK steps always play, only their part is conditional
        ON[b_ix] && !b_skip && DECK[b_ix] == b_key && (b_pass || (b_tg > 0 && ON[b_ix] == 1)) && (!b_mu || b_dk) && !b_drop && !b_dth && b_ev != 1 ? (   // muted lane: decided (PRE/NEI stay right), not played (DUCK lanes: trigger only)
          b_pat = SLP[SLC[b_ix] == 0 && b_ch > 0.3 && hash(b_key, b_p, 25) < (b_ch - 0.3) * 0.3 ? 1 + (hash(b_key, b_p, 26) < 0.4) : SLC[b_ix]];   // chaos: extra x2 / x3
          b_tg == 1 && !b_pass ? (b_pat = SLP[0];);   // SLICE target failed: only the first hit
          b_n = strlen(b_pat);
          b_sh = OFS[b_ix] / 100 * b_sl + (hash(b_key, b_p, 1) - 0.5) * 2 * HT[b_p] / 100 * 0.1 * b_sl + (b_j % 2) * b_swa;
          b_v = VEL[b_ix] + (hash(b_key, b_p, 3) - 0.5) * 2 * HV[b_p] / 100 * 25;
          b_acc = (b_amk & (2 ^ b_p)) && AC[floor((b_base - b_cs) / b_asl + 0.000001) % b_aL];   // ACCENT row
          b_acc ? (b_v += AC[66];);
          b_ev == 3 ? (b_v += 30;);   // EVOLVE: louder
          // groove: grid position b_j % 16 picks the template value, scaled by the lane's amount
          GRV[b_p] > 0 ? (
            b_gi = GRV[b_p] * 16 + (b_j % 16); b_ga = GAM[b_p] / 100;
            b_sh += GT[b_gi] / 100 * b_ga * b_sl; b_v *= 1 + GV[b_gi] / 100 * b_ga;
          );
          b_ch > 0 ? (
            b_sh += (hash(b_key, b_p, 21) - 0.5) * 2 * b_ch * 0.3 * b_sl;
            b_v *= 1 + (hash(b_key, b_p, 22) - 0.5) * b_ch;
          );
          b_sh = max(-0.75 * b_sl, min(1.3 * b_sl, b_sh));   // stay inside the play window
          b_pd = (b_ch > 0.7 && hash(b_key, b_p, 30) < (b_ch - 0.7) / 0.3 * 0.5 ? floor((hash(b_key, b_p, 29) - 0.5) * 2 * (b_ch - 0.7) / 0.3 * 5 + 0.5) : 0);
          // p-locks: sent a little before the first hit (max 6 ms, max half a step), once per played step.
          // TRIGLESS step (ON = 2): locks go out exactly on the step time (+ offset/swing), no note, no slices
          b_tl = ON[b_ix] == 2;
          // restores first, half a step before the hit: the Volca glides CC changes, a late restore colours the next hit
          !b_tl && !b_mu && pnl && LKRST[b_ix] != b_key ? (
            b_lr = b_base + b_sh - 0.5 * b_sl;
            b_lr < b_hi ? (LKRST[b_ix] = b_key; reconcile(b_p, b_ix, max(0, min(samplesblock - 1, floor((max(b_lr, b_lo) - b_pos) / b_qps))), 0, b_tg == 2 && !b_pass, 1, b_acc););
          );
          !b_mu && pnl && LKSENT[b_ix] != b_key ? (
            b_f0 = 0; while (b_f0 < b_n - 1 && str_getchar(b_pat, b_f0) != 'o') (b_f0 += 1;);
            b_lt = (b_tl ? b_base + b_sh : b_base + b_sh + b_f0 * b_sl / b_n - min(0.5 * b_sl, 0.006 * srate * b_qps));
            b_lt < b_hi ? (
              LKSENT[b_ix] = b_key;
              reconcile(b_p, b_ix, max(0, min(samplesblock - 1, floor((max(b_lt, b_lo) - b_pos) / b_qps))), b_tl, b_tg == 2 && !b_pass, 0, b_acc);
            );
          );
          // RAMP: hit q of b_nh goes from 10 % (first, +100) up to the full velocity, or the other way round
          b_nh = 0; b_h = 0; loop(b_n, str_getchar(b_pat, b_h) == 'o' ? (b_nh += 1;); b_h += 1;);
          b_rp = RMP[b_ix] / 100; b_q = 0; b_cuf = 0;
          b_h = 0;
          !b_tl ? loop(b_n,
            str_getchar(b_pat, b_h) == 'o' ? (
              b_t = b_base + b_sh + b_h * b_sl / b_n;
              abs(b_base - LCB[b_p]) < 0.000001 && b_t < LCL[b_p] ? (b_t = (b_cuf ? -1000000 : LCL[b_p]); b_cuf = 1;);   // v0.58.2: only the first early hit catches up, further early ones are dropped (no stacked hits)   // v0.57 catch-up: early hit of a late-decided step
              b_rt = (b_nh > 1 ? b_q / (b_nh - 1) : 1);
              b_rf = (b_rp > 0 ? 1 - 0.9 * b_rp * (1 - b_rt) : 1 + 0.9 * b_rp * b_rt);
              b_t >= b_lo && b_t < b_hi && b_t >= 0 ? (
                b_t < b_base - 0.000001 ? (LFB[b_p] = b_base;);   // v0.58.2: this step's hit played before its grid time
                !b_mu ? (
                  PON[b_p] ? fire(b_p, b_t, b_v * b_rf, 0.5 * b_sl / b_n, max(0, min(127, PBNOTE[b_p] + (b_tg == 2 && !b_pass ? 0 : PIT[b_ix]) + b_pd + (b_acc ? AC[69] : 0))), 10 + b_p)
                           : fire(b_p, b_t, b_v * b_rf, 0.5 * b_sl / b_n, NOTE[b_p], 0);
                );
                b_dk ? (   // duck trigger: C1 on channel 10
                  b_do = max(0, min(samplesblock - 1, floor((b_t - b_pos) / b_qps)));
                  addev(b_do, $x99, 36, max(1, min(127, floor(b_v * b_rf + 0.5)))); addev(min(samplesblock - 1, b_do + 1), $x89, 36, 0);
                );
              );
              b_q += 1;
            );
            b_h += 1;
          );
          // a trigless step with a chance/condition counts like a hit for PRE / NEI (handled in decide)
        );
        // chaos: ghost hit on an empty step (from 30 %, max ~17 %)
        !ON[b_ix] && !b_skip && b_lact && !b_mu && b_ch > 0.3 && b_base >= b_lo && b_base < b_hi && b_base >= 0 && hash(b_key, b_p, 31) < (b_ch - 0.3) * 0.25 ? (
          ghostrst(b_p, b_base);
          PON[b_p] ? fire(b_p, b_base, 28 + hash(b_key, b_p, 32) * 20, 0.5 * b_sl, max(0, min(127, PBNOTE[b_p])), 10 + b_p)
                   : fire(b_p, b_base, 28 + hash(b_key, b_p, 32) * 20, 0.5 * b_sl, NOTE[b_p], 0);
        );
        // DENSITY fill in: ghost hits on empty steps of lanes with notes (hats first, weak positions first, kick last)
        b_dn > 0 && !ON[b_ix] && !b_skip && b_lact && !b_mu && b_base >= b_lo && b_base < b_hi && b_base >= 0 ? (
          b_dsc = 0.45 * (1 - drole(b_p)) + 0.3 * dgrid(b_base) + 0.25 * dh(b_st, b_p, 62);
          b_dsc < b_dn * 0.8 ? (
            ghostrst(b_p, b_base);
            b_dv = 30 + dh(b_st, b_p, 63) * 20 + 20 * b_dn;
            PON[b_p] ? fire(b_p, b_base, b_dv, 0.5 * b_sl, max(0, min(127, PBNOTE[b_p])), 10 + b_p)
                     : fire(b_p, b_base, b_dv, 0.5 * b_sl, NOTE[b_p], 0);
          );
        );
        // EVOLVE: ghost hit / moved-in hit on an empty step (DUCK lanes trigger too)
        (b_ev == 2 || b_ev == 4) && !ON[b_ix] && !b_skip && b_base >= b_lo && b_base < b_hi ? (
          !b_mu ? (ghostrst(b_p, b_base); PON[b_p] ? fire(b_p, b_base, b_evv, 0.5 * b_sl, max(0, min(127, PBNOTE[b_p] + b_evp)), 10 + b_p)
                            : fire(b_p, b_base, b_evv, 0.5 * b_sl, NOTE[b_p], 0););
          b_dk ? (
            b_do = max(0, min(samplesblock - 1, floor((b_base - b_pos) / b_qps)));
            addev(b_do, $x99, 36, max(1, min(127, floor(b_evv + 0.5)))); addev(min(samplesblock - 1, b_do + 1), $x89, 36, 0);
          );
        );
        b_j += 1;
        b_base = b_cs + b_j * b_sl;
      );
      b_c += 1;
    );
    b_p += 1;
  );
);
!inited ? (
  wipecur();
  i = 0; loop(NPAT, pinit(PB + i * PSZ); i += 1;);
  curpat = 0; chlen = 0; fillp = -1;
  inited = 1;
);
i = 0; loop(NP, CUR[i] = -1; OFFAT[i] = -1; i += 1;);
audp = -1;   // v0.59.1 TEST HIT: lane set by a click on PART x / 0x, played once in the next @block
// new arrays start at 0 when the code is reloaded over an open instance: give them their defaults
function fixdef() local(i, b) (
  i = 0; loop(NP, GRV[i] == 0 && GAM[i] == 0 ? (GAM[i] = 100;); PBNOTE[i] < 1 ? (PBNOTE[i] = 60;); i += 1;);
  i = 0; loop(NPAT, b = PB + i * PSZ; loop(6, b[12462] == 0 && b[12468] == 0 ? (b[12468] = 100;); b[12450] < 1 ? (b[12450] = 60;); b += 1;); i += 1;);
  AC[68] != 1 ? acdef(AC);
  i = 0; loop(NPAT, ACB[i * 80 + 68] != 1 ? acdef(ACB + i * 80); i += 1;);
);
fixdef();
resetrun();
ukp = -1; lastafon = 0; afon = 0; lastbarc = -1;
gte = 1; r1t = -10; r1c = -10;   // v0.54.2 readout fade
b_cut = -1000000000000; b_psw = 0;   // v0.57 pattern switch: cut point of the last switch, switch planned at the next bar line
pngt = 0; pngc = -1; pngq = 1000000000; pord = 0; perr = 0; pnla = 0;   // v0.57.3 order ping
pnl = 0; pnlq = 1000000000; pnlhb = -1; pnlw = 0;   // v0.57.2 panel heartbeat (not alive until the counter moves)
kppat = -1; kpbar = -1;   // v0.50.2 kit pre-send: pattern whose kit already went out, bar it was sent for
lastbend = -1000; scount = 0; ACUR = -1; focus = 0; page = 0; selp = 0; sels = 0; plk = 4; ramt = 50; acsel = 0;
ginten = 50; gfeel = 1; gstyle = 0; rall = 0; rlast = 6;   // BEAT generator (GUI state), GEN scope (0 = part, n = parts 1-n)
// v0.60 KIT ON PRESET LOAD: a state load more than 2 s after plugin start (= REAPER preset, not project open: there the
// panel AUTO SEND is boss) sends the current pattern's kit to the panel, only if that pattern has one (kldp = pending)
// v0.60.1: only when the load changed the current pattern or its kit (an undo that reloads the same state sends nothing);
// KLS = the current pattern's kit from just before the load; the send waits up to 1 s for the panel (kldq)
kldt = time_precise(); kldp = 0; kldq = 0; KLS = 383200; klc_ = -1;
// v0.60 COMPACT SAVE (format 16): only values that differ from a default are written, as index + value pairs
// (sreading = reading). A used pattern costs a few hundred numbers instead of ~14,000.
function spz(a, n, d) local(i, c, ix, v) (
  sreading ? (
    i = 0; loop(n, a[i] = d; i += 1;);
    c = 0; file_var(0, c);
    loop(c, ix = -1; v = d; file_var(0, ix); file_var(0, v); ix >= 0 && ix < n ? (a[ix | 0] = v;););
  ) : (
    c = 0; i = 0; loop(n, a[i] != d ? (c += 1;); i += 1;);
    file_var(0, c);
    i = 0; loop(n, a[i] != d ? (ix = i; v = a[i]; file_var(0, ix); file_var(0, v);); i += 1;);
  );
);
// one bank slot (pattern n): the same blocks psave / pload use
function sslot(n) local(b, vd, kf) (
  b = PB + n * PSZ;
  sreading ? pinit(b);
  vd = DEFVEL; file_var(0, vd);   // the default velocity at save time (changing DEFVEL later keeps old velocities)
  spz(b, 384, 0); spz(b + 400, 384, vd); spz(b + 800, 1200, 0); spz(b + 2000, 384, 100);   // ON, VEL, SLC CND OFS, CHN
  file_mem(0, b + 2400, 40);   // LEN RATE HT HV (6 each, gaps included)
  spz(b + 2440, 9984, -1);   // p-locks
  file_mem(0, b + 12430, 44);   // SW DIR PBNOTE PON GRV GAM
  spz(RMPB + n * 384, 384, 0); spz(PITB + n * 384, 384, 0); spz(CTGB + n * 384, 384, 0);
  file_mem(0, ACB + n * 80, 80); file_mem(0, ACPB + n * 32, 26);
  kf = kithas(n); file_var(0, kf);
  kf ? file_mem(0, KITB + n * 140, 137) : sreading ? memset(KITB + n * 140, 0, 140);
  sreading ? (b[PSZ - 1] = 777;);
);

@block
// pass everything through (pads, piano roll, CCs) to the panel; program change 0-15 = pattern 1-16 (not passed on)
ntq = 0;
while (midirecv(b_o, b_1, b_2, b_3)) (
  (b_1 & $xF0) == $xC0 ? (slider8 = (b_2 % NPAT) + 1; sliderchange(slider8);) : (
    midisend(b_o, b_1, b_2, b_3);
    (slider17 >= 0.5 || calon) && (b_1 & $xF0) == $x90 && (b_1 & $x0F) < 6 && b_3 > 0 && ntq < 32 ? (   // tap record: part notes on ch 1-6 (part n on ch n)
      b_q = 0; loop(NP, NOTE[b_q] == b_2 ? (TQ[ntq * 3] = b_o; TQ[ntq * 3 + 1] = b_q; TQ[ntq * 3 + 2] = b_3; ntq += 1;); b_q += 1;);
    );
  );
);
pend = max(0, min(NPAT - 1, (slider8 | 0) - 1));
// stopped: switch right away
!((slider1 < 0.5 && (play_state & 1)) || (slider1 >= 0.5 && slider4 >= 0.5)) && pend != curpat ? doswitch(pend);

nev = 0; b_ncc = 0;
// lock sweep (v0.41): after edits (bump), pattern switches and mute/solo changes
(slider13 | 0) != lswm || (slider14 | 0) != lsws ? (lswm = slider13 | 0; lsws = slider14 | 0; lkswp = 1;);
// v0.57.2 panel alive? its heartbeat counter moved within the last 0.5 s. Back after a pause = sweep the locks again
pnlhb < 0 ? (pnlhb = gmem[998];) : gmem[998] != pnlhb ? (pnlhb = gmem[998]; pnlq = 0;) : (pnlq += samplesblock;);   // first block: only note the counter
pnl = gmem[999] == 1 && pnlq < srate * 0.5;
pnl && !pnlw ? (lkswp = 1;); pnlw = pnl;
kldp ? (pnl ? (kithas(curpat) ? (kitsend(curpat); kppat = -1;); kldp = 0;) : (kldq += samplesblock; kldq > srate ? (kldp = 0;);););   // v0.60 kit on preset load
// v0.57.3 order ping: does this track's MIDI reach the panel? (panel before the sequencer / on another track = no)
// v0.58.2: ping only while a panel is alive (nothing goes to the hardware without one), first ping at once; pnla = samples the panel has been alive
pnl ? (pnla += samplesblock; pngt += samplesblock; pngt >= srate * 0.4 ? (pngt = 0; midisend(0, $xBF, 119, 1););) : (pnla = 0; pngt = srate;);
pngc < 0 ? (pngc = gmem[997];) : gmem[997] != pngc ? (pngc = gmem[997]; pngq = 0;) : (pngq += samplesblock;);
pord = pngq < srate * 1.5;
lkswp && pnl ? (lkswp = 0; lksweep(0););
b_p = 0; loop(NP, gmem[1700 + b_p] = PON[b_p]; b_p += 1;); gmem[1710] = 1;   // QPI link for the panel
b_tempo = tempo; b_pst = play_state; b_tsn = ts_num;
b_fillm = slider7 >= 0.5;   // manual FILL (button / slider 7)
b_fill = b_fillm;           // per step: manual FILL or an AUTO FILL bar (set again before each decision)
b_afn = afn();              // AUTO FILL every n bars (0 = off)
b_dn = max(-1, min(1, slider24 / 100));   // DENSITY: -1 thin out .. +1 fill in
b_ch = max(0, min(1, slider15 / 100));   // chaos 0-1
b_evn = evn();   // EVOLVE: every n bars (0 = off)
b_run = 0;
slider1 < 0.5 ? (
  (play_state & 1) ? (b_run = 1; b_pos = beat_position;);
  b_qps = tempo / 60 / srate;
) : (
  slider4 >= 0.5 ? (
    !b_frun ? (fpos = 0; resetrun(); lastbend = 0; pnl ? presync(););   // v0.58.2: FREE start is a real start too
    b_run = 1; b_pos = fpos;
  );
  b_ft = (slider3 >= 0.5 ? slider2 : tempo);
  b_qps = b_ft / 60 / srate;
);
b_frun = slider1 >= 0.5 && slider4 >= 0.5;

b_run ? (
  b_end = b_pos + samplesblock * b_qps;
  // continuous playback: this block starts exactly where the last one ended (no double or missed hits)
  abs(b_pos - lastbend) < 0.001 ? (b_lo = lastbend; b_jmp = 0;) : (
    b_lo = b_pos; resetrun(); b_jmp = 1; b_cut = -1000000000000;
    // v0.57: full presync only at a real start. A jump / loop wrap while playing sent a CC burst in front of the downbeat;
    // LKACT / LKVAL still say what the Volca holds, so the normal restore before each lane's next hit is enough
    pnl && !b_wasrun ? presync();
  );
  b_hi = b_end;
  dispq = b_pos;
  // MASTER LENGTH: every b_m quarter notes all lanes restart at step 1 (0 = off)
  b_qbar = (slider1 < 0.5 ? ts_num * 4 / max(1, ts_denom) : 4);
  b_m = MBARS[slider6 | 0] * b_qbar;
  b_m > 0 ? (dispbar = floor((b_pos - floor(b_pos / b_m) * b_m) / b_qbar) + 1; dispmb = MBARS[slider6 | 0];) : (dispmb = 0;);
  // pattern change waits for the next bar (or the next MASTER cycle) and happens in the block that reaches it.
  // What plays: fill pattern (FILL on) > chain (entry = bar or cycle number of the project) > selected pattern.
  // After a start or jump it switches at once.
  // b_cu = the bar (or cycle) the END of this block is in. A new b_cu = a bar line was crossed (b_bnd).
  b_un = (b_m > 0 ? b_m : b_qbar);
  b_cu = floor(b_hi / b_un - 0.0000001);
  b_bnd = (b_cu != lastcu); lastcu = b_cu;
  b_cha = slider10 >= 0.5 && chlen > 0;
  // AUTO FILL (v0.51): the bar the end of this block is in; a change of the fill state is a switch point of its own
  b_barc = floor(b_hi / b_qbar - 0.0000001); b_barx = (b_barc != lastbarc); lastbarc = b_barc;
  afon = afbar(b_barc * b_qbar); b_afch = (afon != lastafon); lastafon = afon;
  b_fl = (b_fillm || afon) && fillp >= 0;
  b_ci = (b_cha ? ((b_cu % chlen) + chlen) % chlen : 0);
  b_wnf = (b_cha ? CHL[b_ci] : pend);   // what plays without a fill
  b_want = (b_fl ? fillp : b_wnf);
  // REGIONS = PATTERNS: region "P<n> ..." at the end of this block plays pattern n (fill pattern still wins)
  b_rg = -1;
  slider22 >= 0.5 && slider1 < 0.5 ? (
    b_q = 0;
    loop(max(0, min(64, gmem[2001])),
      b_hi - 0.000001 >= gmem[2002 + b_q * 3] && b_hi - 0.000001 < gmem[2003 + b_q * 3] ? (b_rg = max(0, min(NPAT - 1, gmem[2004 + b_q * 3] | 0)););
      b_q += 1;
    );
  );
  rgdisp = b_rg;
  b_rg >= 0 ? (b_wnf = b_rg; !b_fl ? (b_want = b_rg;););
  // switch on a bar line or after a jump; a running chain also catches up at once (unless a fill pattern is playing)
  b_want != curpat && (b_bnd || b_jmp || (b_afch && fillp >= 0) || (b_cha && !b_fl && !fillact) || (b_rg >= 0 && !b_fl)) ? (
    b_sq = (b_bnd ? b_cu * b_un : b_barx ? b_barc * b_qbar : b_lo);   // v0.57: the switch point (bar line, or now)
    // the old pattern first plays the rest of this block up to the switch point (roll ends, late hits), nothing of the next bar
    !b_jmp && b_sq > b_lo + 0.000001 ? (b_psw = 1; b_nb = b_sq; b_hi = b_sq; playlanes(); b_lo = b_sq; b_hi = b_end;);
    // v0.58.2: lanes whose step AT the switch point already played early from the old pattern (switch decided late): the new pattern skips it there (no double hit)
    b_swm = 0; b_q = 0; loop(NP, abs(LFB[b_q] - b_sq) < 0.000001 ? (b_swm += 2 ^ b_q;); b_q += 1;);
    doswitch(b_want); fillact = b_fl;
    // steps with a grid time before the switch point belonged to the old pattern: cut, never replayed from the new data
    !b_jmp ? (b_cut = b_sq; b_q = 0; loop(NP, (b_swm & (2 ^ b_q)) ? (SWK[b_q] = b_sq;); b_q += 1;););
  );
  // v0.50.2: a pre-sent kit whose pattern did not come (jump, loop wrap, changed mind): back to the playing pattern's kit
  (b_bnd || b_jmp || b_barx) && kppat >= 0 && kppat != curpat ? (pnl ? (kithas(curpat) ? kitsend(curpat) : kitback();); kppat = -1;);
  chdisp = (b_cha ? b_ci : -1);
  dnext = (b_cha ? CHL[(((b_cu + 1) % chlen) + chlen) % chlen] : pend);   // without a fill (fill decided below)
  // REGIONS: the next bar's region decides what comes next (readout NEXT PAT)
  slider22 >= 0.5 && slider1 < 0.5 ? (
    b_tn = (b_cu + 1) * b_un + 0.000001; b_q = 0;
    loop(max(0, min(64, gmem[2001])),
      b_tn >= gmem[2002 + b_q * 3] && b_tn < gmem[2003 + b_q * 3] ? (dnext = max(0, min(NPAT - 1, gmem[2004 + b_q * 3] | 0)););
      b_q += 1;
    );
  );
  // KIT PRE-SEND (v0.50.2): the next bar's pattern sends its kit ~100 ms before the bar line (a full kit needs about that
  // long on the MIDI cable), so the first hit already has the new sound; doswitch() then doesn't send it again
  b_nb = (b_cu + 1) * b_un;
  // AUTO FILL inside a MASTER cycle: the next bar line comes first and the fill state changes there
  b_nbar = (b_barc + 1) * b_qbar;
  b_nbar < b_nb - 0.000001 && (b_fillm || afbar(b_nbar)) != (b_fillm || afon) ? (b_nb = b_nbar; dnext = b_wnf;);
  // the fill pattern wins at the next switch point when FILL is held or that bar is an AUTO FILL bar
  (b_fillm || afbar(b_nb)) && fillp >= 0 ? (dnext = fillp;);
  b_psw = dnext != curpat;   // v0.57: another pattern is planned at b_nb: steps from there on are not played from this one
  b_hi + 0.1 * srate * b_qps >= b_nb && kpbar != b_nb ? (
    kpbar = b_nb;
    dnext != curpat && kithas(dnext) && pnl ? (
      b_q = 0; loop(136, KPSV[b_q] = floor(gmem[1001 + b_q] + 0.5); b_q += 1;);   // v0.57.2: the sound from before, in case the pattern does not come
      kitsend(dnext); kppat = dnext;
    );
  );
  // tap record: write the queued hits (after a pattern switch, so they land in the playing pattern)
  b_tc = slider18 / 1000 * srate * b_qps;   // compensation in QN
  b_q = 0;
  loop(ntq,
    b_t = b_pos + TQ[b_q * 3] * b_qps;
    calon ? (
      // CAL: lateness against the nearest beat; taps more than 1/4 beat away are ignored
      b_dv = b_t - floor(b_t + 0.5);
      abs(b_dv) < 0.25 ? (calsum += b_dv / b_qps / srate * 1000; caln += 1;);
      caln >= 8 ? (slider18 = max(-100, min(200, floor(calsum / caln + 0.5))); sliderchange(slider18); calon = 0; caldone = 1;);
    ) : b_t - b_tc >= 0 ? tput(TQ[b_q * 3 + 1], b_t - b_tc, TQ[b_q * 3 + 2]);
    b_q += 1;
  );
  playlanes();
  lastbend = b_end;
  slider1 >= 0.5 ? (fpos = b_end;);
) : (
  dnext = pend; chdisp = -1; lastcu = -1000000; ACUR = -1; rgdisp = -1;
  b_wasrun ? (
    b_p = 0; loop(NP, OFFAT[b_p] >= 0 ? (addev(0, $x80 | OFFC[b_p], OFFN[b_p], 0); OFFAT[b_p] = -1;); CUR[b_p] = -1; b_p += 1;);
    pnl ? unlockall(0);
    kppat >= 0 && kppat != curpat ? (pnl ? (kithas(curpat) ? kitsend(curpat) : kitback();); kppat = -1;);   // v0.57.2: stopped right after a pre-send
    lastbend = -1000;
  );
);
b_wasrun = b_run;
b_ncc > 8 ? (busycnt += 1;);

// v0.59.1 TEST HIT: click on the lane name (Classic PART x / Sleeve 0x) = that part once, vel 63 (= panel LEVEL), 0.2 s;
// plays muted lanes too (you want to know what the lane is), writes nothing into the pattern
audp >= 0 ? (
  b_p = audp; audp = -1;
  OFFAT[b_p] >= 0 ? (addev(0, $x80 | OFFC[b_p], OFFN[b_p], 0););
  addev(0, $x90, NOTE[b_p], 63);
  OFFN[b_p] = NOTE[b_p]; OFFC[b_p] = 0; OFFAT[b_p] = scount + max(1, floor(0.2 * srate));
);   // more than ~8 ms of lock CCs in one block: the GUI shows MIDI TIGHT

// note-offs that fall into this block
b_p = 0;
loop(NP,
  OFFAT[b_p] >= 0 && OFFAT[b_p] < scount + samplesblock ? (
    addev(max(0, OFFAT[b_p] - scount), $x80 | OFFC[b_p], OFFN[b_p], 0); OFFAT[b_p] = -1;
  );
  b_p += 1;
);

// insertion sort by offset (stable), then send
b_i = 1;
while (b_i < nev) (
  b_k2 = b_i;
  while (b_k2 > 0 && EV[(b_k2 - 1) * 4] > EV[b_k2 * 4]) (
    b_q = 0; loop(4, b_x = EV[(b_k2 - 1) * 4 + b_q]; EV[(b_k2 - 1) * 4 + b_q] = EV[b_k2 * 4 + b_q]; EV[b_k2 * 4 + b_q] = b_x; b_q += 1;);
    b_k2 -= 1;
  );
  b_i += 1;
);
b_i = 0; loop(nev, midisend(EV[b_i * 4], EV[b_i * 4 + 1], EV[b_i * 4 + 2], EV[b_i * 4 + 3]); b_i += 1;);
scount += samplesblock;

@serialize
// v1 = steps on/vel, len, rate; v2 = + slice, condition, offset, humanize; v3 = + chance (conditions without %); v4 = + p-locks; v5 = + 16 patterns
// v16 (v0.60) = compact: no current-pattern arrays (= its bank slot, loaded with pload), sparse bank slots (spz / sslot).
// Older formats are still read by the old code below (no guarantee, the user does not need them).
sreading = file_avail(0) >= 0;
sreading && KLS > 0 ? (klc_ = curpat; memcpy(KLS, KITB + max(0, min(NPAT - 1, curpat | 0)) * 140, 137););
sver = 16;
// v0.60.2: a save before @init ran (no memory map yet) writes only format 0 = nothing; reading format 0 changes nothing
!sreading && !inited ? (sver = 0;);
file_var(0, sver);
sver >= 16 ? (
  !sreading ? psave(curpat);
  file_var(0, curpat); file_var(0, chlen); file_mem(0, CHL, 16); file_var(0, fillp);
  si_ = 0;
  loop(NPAT,
    su_ = (sreading ? 0 : (si_ == curpat || pused(si_)));   // v0.60.1: the current pattern is always written;
    file_var(0, su_);
    su_ ? sslot(si_) : sreading ? pinit(PB + si_ * PSZ);
    si_ += 1;
  );
  sreading ? (
    curpat = max(0, min(NPAT - 1, curpat | 0)); chlen = max(0, min(16, chlen | 0));
    pload(curpat); fixdef(); slider8 = curpat + 1;
    si_ = 0; loop(NP, LEN[si_] < 1 ? (LEN[si_] = 16;); si_ += 1;);
  );
) : sver > 0 ? (
file_mem(0, ON, NP * NSTEP);
file_mem(0, VEL, NP * NSTEP);
file_mem(0, LEN, NP);
file_mem(0, RATE, NP);
sver >= 2 ? (
  file_mem(0, SLC, NP * NSTEP);
  file_mem(0, CND, NP * NSTEP);
  file_mem(0, OFS, NP * NSTEP);
  file_mem(0, HT, NP);
  file_mem(0, HV, NP);
);
sver >= 4 ? (file_mem(0, PL, NP * NSTEP * NPL););
// v6 = + swing per lane (current pattern; the bank slots carry it at +12430)
sver >= 6 ? (file_mem(0, SW, NP);) : sreading ? (memset(SW, 0, NP););
// v7 = + ramp per step (current pattern; bank slots after each used slot)
sver >= 7 ? (file_mem(0, RMP, NP * NSTEP);) : sreading ? (memset(RMP, 0, NP * NSTEP););
// v8 = + direction per lane (current pattern; bank slots carry it at +12440)
sver >= 8 ? (file_mem(0, DIR, NP);) : sreading ? (memset(DIR, 0, NP););
// v9 = + chain list and fill pattern
sver >= 9 ? (file_var(0, chlen); file_mem(0, CHL, 16); file_var(0, fillp);) : sreading ? (chlen = 0; fillp = -1;);
// v10 = + pitch per step, lane base note + pitch on/off (current pattern; bank: PITB per used slot, base/on at +12450/+12456)
sver >= 10 ? (file_mem(0, PIT, NP * NSTEP); file_mem(0, PBNOTE, NP); file_mem(0, PON, NP);)
: sreading ? (memset(PIT, 0, NP * NSTEP); memset(PON, 0, NP); si_ = 0; loop(NP, PBNOTE[si_] = 60; si_ += 1;););
// v11 = + groove template + amount per lane (current pattern; bank +12462 / +12468)
sver >= 11 ? (file_mem(0, GRV, NP); file_mem(0, GAM, NP); sreading ? fixdef();) : sreading ? (memset(GRV, 0, NP); si_ = 0; loop(NP, GAM[si_] = 100; si_ += 1;););
// v12 = + condition target per step (current pattern; bank CTGB per used slot)
sver >= 12 ? (file_mem(0, CTG, NP * NSTEP);) : sreading ? (memset(CTG, 0, NP * NSTEP););
// v13 = + accent row (current pattern; bank ACB per used slot)
sver >= 13 ? (file_mem(0, AC, 80);) : sreading ? (acdef(AC););
// v14 = + accent param amounts (current pattern; bank ACPB per used slot)
sver >= 14 ? (file_mem(0, ACP, 26);) : sreading ? (memset(ACP, 0, 26););
sver >= 3 ? (
  file_mem(0, CHN, NP * NSTEP);
) : sreading ? (
  // older project: chance was part of the condition list (old 1-7 = 10..90 %, old 8.. = new 1..)
  si_ = 0;
  loop(NP * NSTEP,
    oc = CND[si_]; CHN[si_] = 100;
    oc >= 1 && oc <= 7 ? (CHN[si_] = (oc == 1 ? 10 : oc == 2 ? 25 : oc == 3 ? 33 : oc == 4 ? 50 : oc == 5 ? 66 : oc == 6 ? 75 : 90); CND[si_] = 0;)
    : oc >= 8 ? (CND[si_] = oc - 7;);
    si_ += 1;
  );
);
// v5: the arrays above = current pattern; then its number and the bank (only used slots are written)
sver >= 5 ? (
  !sreading ? psave(curpat);
  file_var(0, curpat);
  si_ = 0;
  loop(NPAT,
    su_ = (sreading ? 0 : pused(si_));
    file_var(0, su_);
    su_ ? file_mem(0, PB + si_ * PSZ, PSZ) : sreading ? pinit(PB + si_ * PSZ);
    su_ ? (sver >= 7 ? file_mem(0, RMPB + si_ * 384, 384) : memset(RMPB + si_ * 384, 0, 384););
    su_ ? (sver >= 10 ? file_mem(0, PITB + si_ * 384, 384) : memset(PITB + si_ * 384, 0, 384););
    su_ ? (sver >= 12 ? file_mem(0, CTGB + si_ * 384, 384) : memset(CTGB + si_ * 384, 0, 384););
    su_ ? (sver >= 13 ? file_mem(0, ACB + si_ * 80, 80) : acdef(ACB + si_ * 80););
    su_ ? (sver >= 14 ? file_mem(0, ACPB + si_ * 32, 26) : memset(ACPB + si_ * 32, 0, 32););
    su_ ? (sver >= 15 ? file_mem(0, KITB + si_ * 140, 137) : memset(KITB + si_ * 140, 0, 140););   // v15 = + kit per pattern
    si_ += 1;
  );
  sreading ? (slider8 = curpat + 1;);
) : sreading ? (
  // older project: what was loaded becomes pattern 1
  curpat = 0; si_ = 0; loop(NPAT, pinit(PB + si_ * PSZ); si_ += 1;); psave(0); slider8 = 1;
);
);   // end of the old formats (< 16)
// v0.58: loaded state: the undo copy belongs to the old data; sweep locks nothing uses any more
sreading ? (hasundo = 0; ukp = -1; lkswp = 1;);
sreading && KLS > 0 && time_precise() - kldt > 2 ? (
  kld_ = (curpat != klc_); si_ = 0; loop(137, KLS[si_] != KITB[curpat * 140 + si_] ? (kld_ = 1;); si_ += 1;);
  kld_ ? (kldp = 1; kldq = 0;);
);   // v0.60 kit on preset load (not at project open)

@gfx 1440 960
// scales with the window (design size 1200 x 800, layout v2), colors from the theme table, Bahnschrift + Consolas
sc = max(0.5, min(gfx_w / 1200, gfx_h / 800));
function S(v) ( floor(v * sc + 0.5) );
function CF(v) ( floor(v * 1.2 + 0.5) );   // Classic look: text +20 % (2026-11-05)
function col(r, g, b, a) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; );
// v0.58.6 Sleeve letter spacing: the condensed Sleeve font reads better with air between the letters.
// sfont() sets slsp_ by size (big numbers: none), fit() lowers slcur_ when a label would not fit, the draw helpers use slcur_.
// Classic (skin 0) is unchanged. UTF-8 aware (·, ±, → stay whole).
function u8len(s, i) local(c) ( c = str_getchar(s, i, 'cu'); c >= 0xF0 ? 4 : c >= 0xE0 ? 3 : c >= 0xC0 ? 2 : 1; );
function nchr(s) local(i, n, l) ( i = 0; n = 0; l = strlen(s); while (i < l) (i += u8len(s, i); n += 1;); n; );
function plainw(s) local(pw_w, pw_h) ( pw_w = 0; strlen(s) > 0 ? gfx_measurestr(s, pw_w, pw_h); pw_w; );
// width as drawn letter by letter (sum of the single letters, can be wider than the whole word measured at once)
function csum(s) local(i, l, k, cs_w) ( i = 0; l = strlen(s); cs_w = 0; while (i < l) (k = u8len(s, i); strcpy_substr(#sdc, s, i, k); cs_w += plainw(#sdc); i += k;); cs_w; );
function swid(s) ( skin && slcur_ > 0 ? csum(s) + slcur_ * max(0, nchr(s) - 1) : plainw(s); );
function sdraw(s) local(i, l, k) (
  skin && slcur_ > 0 ? (
    i = 0; l = strlen(s);
    while (i < l) (k = u8len(s, i); strcpy_substr(#sdc, s, i, k); gfx_drawstr(#sdc); i += k; i < l ? (gfx_x += slcur_;););
  ) : gfx_drawstr(s);
);
function txt(s, x, y) ( gfx_x = x; gfx_y = y; sdraw(s); );
function ctxt(s, x, y, wi) ( gfx_x = x + (wi - swid(s)) / 2; gfx_y = y; sdraw(s); );
function rtxt(s, xr, y) ( gfx_x = xr - swid(s); gfx_y = y; sdraw(s); );
function frame(x, y, w, h) ( gfx_rect(x, y, w, 1); gfx_rect(x, y + h - 1, w, 1); gfx_rect(x, y, 1, h); gfx_rect(x + w - 1, y, 1, h); );

// ---- themes (2026-11-05): every color is a ROLE; one row of NRO colors per theme in memory at TH, slider 11 picks the row ----
TH = 36000; NRO = 33; NTH = 14; TINTA = 37400;
K_BG = 0; K_BG2 = 1; K_PNL = 2; K_PNLF = 3; K_PNLB = 4; K_FLD = 5; K_FLDB = 6; K_BTN = 7; K_TXT = 8; K_LBL = 9;
K_DIM = 10; K_DIM2 = 11; K_ACC = 12; K_FOC = 13; K_FOCT = 14; K_ALT = 15; K_HOT = 16; K_RDB = 17; K_RDT = 18; K_CEL = 19;
K_CELB = 20; K_OUT = 21; K_OUTB = 22; K_OVON = 23; K_OVIN = 24; K_PLY = 25; K_SEL = 26; K_CTX = 27; K_PU = 28; K_SCR = 29;
K_LINE = 30; K_LINE2 = 31; K_BAR = 32;   // Sleeve look: the brief's line, line2, bar
// roles: BG/BG2 background gradient · PNL/PNLF/PNLB strips (focused, border) · FLD/FLDB value fields · BTN buttons ·
// TXT numbers + text · LBL labels · DIM/DIM2 hints · ACC steps, bars, playhead text (= L1 in the brief) · FOC focus
// (selected part/pattern/tab, active buttons) · FOCT text on FOC · ALT locks, chance, chain · HOT fill-pattern mark ·
// RDB/RDT readout · CEL/CELB empty cell · OUT/OUTB cells past the lane end · OVON/OVIN overview strip · PLY current
// step · SEL selection frame · CTX text on lit cells · PU used pattern slot
function hrgb(h) ( t_r = floor(h / 65536) / 255; t_g = (floor(h / 256) % 256) / 255; t_b = (h % 256) / 255; );
function thput(t, r, h) local(q) ( hrgb(h); q = TH + (t * NRO + r) * 3; q[0] = t_r; q[1] = t_g; q[2] = t_b; );
function thmix(t, r, h1, h2, f) local(q, r1, g1, b1) (
  hrgb(h1); r1 = t_r; g1 = t_g; b1 = t_b; hrgb(h2); q = TH + (t * NRO + r) * 3;
  q[0] = r1 + (t_r - r1) * f; q[1] = g1 + (t_g - g1) * f; q[2] = b1 + (t_b - b1) * f;
);
// one theme from the 12 colors of the redesign brief (dk = dark theme, 0 = light)
function thdef(t, dk, bg, fg, num, l1, l1hi, lab, dim, ln, ln2, foc, alt) local(lum) (
  thmix(t, K_BG, bg, fg, 0.06); thput(t, K_BG2, bg);
  thmix(t, K_PNL, bg, fg, 0.05); thmix(t, K_PNLF, bg, fg, 0.10); thmix(t, K_PNLB, ln, fg, 0.06);
  dk ? thmix(t, K_FLD, bg, 0, 0.45) : thmix(t, K_FLD, bg, $xffffff, 0.6);
  thmix(t, K_FLDB, ln, fg, 0.18);
  dk ? thmix(t, K_BTN, bg, fg, 0.035) : thmix(t, K_BTN, bg, $xffffff, 0.3);
  thput(t, K_TXT, num); thput(t, K_LBL, lab); thput(t, K_DIM, dim); thmix(t, K_DIM2, dim, bg, 0.3);
  thput(t, K_ACC, l1); thput(t, K_FOC, foc); thput(t, K_ALT, alt);
  // text on the focus color: light themes with a bright focus color (Plant orange) need dark text (v0.40.3)
  hrgb(foc); lum = 0.3 * t_r + 0.59 * t_g + 0.11 * t_b;
  thput(t, K_FOCT, !dk && lum > 0.5 ? num : bg);
  thput(t, K_HOT, dk ? $xffbf4d : $xa85d00);
  dk ? (thmix(t, K_RDB, bg, 0, 0.55); thput(t, K_RDT, l1hi);) : (thmix(t, K_RDB, fg, bg, 0.08); thmix(t, K_RDT, l1hi, $xffffff, 0.3););
  dk ? thmix(t, K_CEL, bg, fg, 0.03) : thmix(t, K_CEL, bg, $xffffff, 0.35);
  thmix(t, K_CELB, ln, fg, 0.04);
  dk ? thmix(t, K_OUT, bg, 0, 0.35) : thmix(t, K_OUT, bg, fg, 0.07);
  thmix(t, K_OUTB, ln2, bg, 0.3);
  thmix(t, K_OVON, l1, bg, 0.3); thmix(t, K_OVIN, ln, fg, 0.12);
  thput(t, K_PLY, fg); thput(t, K_SEL, foc);
  hrgb(l1); lum = 0.3 * t_r + 0.59 * t_g + 0.11 * t_b;
  thput(t, K_CTX, dk && lum > 0.65 ? bg : num);   // bright step color (yellow, white): dark text on lit cells
  thmix(t, K_PU, bg, fg, 0.09); thmix(t, K_SCR, bg, fg, 0.14);
  thput(t, K_LINE, ln); thput(t, K_LINE2, ln2); thmix(t, K_BAR, ln, fg, 0.35); TINTA[t] = 0.1;
);
thinit != 5 ? (   // 3 = table format version (NRO 33); bump when roles change
  //    theme dark  bg         fg         num        l1         l1hi       label      dim        line       line2      focus      alt
  thdef(0,  1, $x1b1d20, $xf2f2f5, $xf2f2f5, $xe8362b, $xe8362b, $x9aa0a6, $x8a9096, $x2f3337, $x2b2e32, $xe8362b, $x9eb3c4);   // Classic
  // Classic = the layout v2 mockup colors exactly
  thput(0, K_BG, $x24272b); thput(0, K_PNL, $x1e2023); thput(0, K_PNLF, $x26292d); thput(0, K_PNLB, $x2f3337);
  thput(0, K_FLD, $x121315); thput(0, K_FLDB, $x44494f); thput(0, K_BTN, $x1a1b1e); thput(0, K_DIM2, $x686d73);
  thput(0, K_FOCT, $xffffff); thput(0, K_RDB, $x0b0c0d); thput(0, K_CEL, $x17181b); thput(0, K_CELB, $x2b2e32);
  thput(0, K_OUT, $x101113); thput(0, K_OUTB, $x1c1e21); thput(0, K_OVON, $xa8322a); thput(0, K_OVIN, $x3a3e43);
  thput(0, K_PLY, $xffffff); thput(0, K_SEL, $xf2f2f5); thput(0, K_CTX, $xffffff); thput(0, K_PU, $x2a2c30); thput(0, K_SCR, $x3a3d42);
  thdef(1,  1, $x0b0b0b, $xe7e0d0, $xf0eadb, $xd8291d, $xff5a48, $xb5ae9f, $x8d877a, $x262626, $x1d1d1d, $xe6a23c, $x8fb0c4);   // Sleeve
  thdef(2,  1, $x0c0c0b, $xe9e4d6, $xf4efe2, $xe8b31b, $xffcc33, $xb5ae9f, $x8d877a, $x262624, $x1d1d1b, $xf05a28, $x8fb0c4);   // Hazard
  thdef(3,  1, $x0b0f12, $xdfe6ea, $xeef3f6, $x3aa9c9, $x6fd0ea, $xa3b1ba, $x71808a, $x1f272d, $x161d22, $xe3a04a, $xb8a4e3);   // Cold steel
  thdef(4,  1, $x0d0a06, $xe8dcc4, $xf2e8d4, $xff9f1a, $xffb84d, $xb8a98c, $x8a7b62, $x2a2219, $x1d1812, $x4fc3b0, $x9fc8e0);   // Amber CRT
  thdef(5,  1, $x11130e, $xdcd6bb, $xebe5ca, $xe0601c, $xff8040, $xaeaa8e, $x7f7d66, $x262a20, $x1b1e17, $xe8c547, $x9db8c9);   // Field olive
  thdef(6,  1, $x141414, $xc9c6bf, $xf2f0ea, $xf2f0ea, $xffffff, $xa6a39c, $x7c7a75, $x2a2a2a, $x202020, $xd4281c, $x8fb0c4);   // Concrete
  thdef(7,  0, $xe9e5db, $x161514, $x0d0c0b, $xc41e14, $xc41e14, $x4a463f, $x6f6a60, $xc9c3b6, $xd9d4c8, $x1d4fb8, $x2f7d74);   // Xerox (light)
  thdef(8,  0, $xd3d5d7, $x1e2226, $x121518, $x2f6aa8, $x2f6aa8, $x464c52, $x6a7076, $xb5b9bd, $xc4c7ca, $xd98a12, $x6b4fa3);   // Plant light (light)
  thdef(9,  1, $x0f2b4c, $xdbe7f3, $xf3f8fc, $xf2c53d, $xffd866, $xa9c0d6, $x7f9bb8, $x234469, $x1a385b, $xff7b5c, $x8fd3e8);   // Blueprint
  thdef(10, 1, $x050a06, $xb9e3b1, $xd6f5cf, $x3fcf5e, $x7cf08f, $x8fb489, $x5f7f5b, $x142116, $x0e1810, $xf2e36b, $x8fc7e8);   // Night vision
  thdef(11, 1, $x140708, $xe6d5c6, $xf3e6d9, $xa3202a, $xe04450, $xb89c8f, $x8a6f66, $x2b1416, $x200d0f, $xd4ae64, $x9fb3c4);   // Oxblood
  thdef(12, 1, $x18191a, $xd6d2ca, $xece8df, $xc0602e, $xe88350, $xaaa59c, $x7d7a74, $x2b2c2d, $x212223, $x6fb3b8, $xa9b8d8);   // Rust
  thdef(13, 0, $xa9adb1, $x15181b, $x0d0f11, $x2a5f98, $x2a5f98, $x34393e, $x4f555b, $x8f949a, $x9da2a7, $xd98a12, $x5b3f93);   // Plant grey (darker Plant light)
  // Sleeve look extras (Volca Sequencer Looks page): bar color + tint strength per color
  thput(1, K_BAR, $x6d685e); thput(2, K_BAR, $x6d685e); thput(3, K_BAR, $x4f5d66); thput(4, K_BAR, $x6e5f48);
  thput(5, K_BAR, $x62624e); thput(6, K_BAR, $x5e5c58); thput(7, K_BAR, $x9a9488); thput(8, K_BAR, $x8a9096);
  thput(9, K_BAR, $x5c7da0); thput(10, K_BAR, $x3f5c40); thput(11, K_BAR, $x6a4c46); thput(12, K_BAR, $x5f5c57);
  TINTA[1] = 0.12; TINTA[2] = 0.10; TINTA[3] = 0.10; TINTA[4] = 0.09; TINTA[5] = 0.10; TINTA[6] = 0.06;
  TINTA[7] = 0.08; TINTA[8] = 0.09; TINTA[9] = 0.10; TINTA[10] = 0.10; TINTA[11] = 0.14; TINTA[12] = 0.11; TINTA[13] = 0.12; thput(13, K_BAR, $x6a7076);
  thinit = 5;
);
// condensed font of the Sleeve look: Big Shoulders Display if installed, else Bahnschrift Condensed (checked every 10 s,
// so a freshly installed font shows up without reloading). A missing font measures like any other missing font.
function fontok(nm) local(w1, w2, hh) (
  gfx_setfont(9, nm, 40); gfx_measurestr("MWmw0123ABC", w1, hh);
  gfx_setfont(9, "zqxNoSuchFont77", 40); gfx_measurestr("MWmw0123ABC", w2, hh);
  abs(w1 - w2) > 0.5;
);
time_precise() - fontt > 10 || !fontt ? (
  fontt = time_precise();
  // ExtraBold cut = thicker strokes (reads bigger); static weights show up as their own family names
  sfb = 'b';
  0 && fontok("Big Shoulders Display ExtraBold") ? (strcpy(#sf, "Big Shoulders Display ExtraBold"); sfb = 0;)   // ExtraBold OFF: stepped edges (2026-11-05)
  : fontok("Big Shoulders Display") ? strcpy(#sf, "Big Shoulders Display") : fontok("Bahnschrift Condensed") ? strcpy(#sf, "Bahnschrift Condensed") : strcpy(#sf, "Bahnschrift");
);
theme = max(0, min(NTH - 1, slider11 | 0));
skin = slider12 >= 0.5;   // LOOK: 0 Classic, 1 Sleeve · COLOR (theme): any of the 13 works with both looks
function rc(r, a) local(q) ( q = TH + (theme * NRO + r) * 3; gfx_r = q[0]; gfx_g = q[1]; gfx_b = q[2]; gfx_a = a; );
function thname(i) (
  i == 0 ? "CLASSIC RED" : i == 1 ? "SLEEVE RED" : i == 2 ? "HAZARD" : i == 3 ? "COLD STEEL" : i == 4 ? "AMBER CRT" : i == 5 ? "FIELD OLIVE" :
  i == 6 ? "CONCRETE" : i == 7 ? "XEROX" : i == 8 ? "PLANT LIGHT" : i == 9 ? "BLUEPRINT" : i == 10 ? "NIGHT VISION" : i == 11 ? "OXBLOOD" : i == 12 ? "RUST" : "PLANT GREY";
);
function setlook(v) ( slider12 = v; slider_automate(slider12); skin = v; strcpy(#rd, v ? "LOOK · SLEEVE" : "LOOK · CLASSIC"); msgt = time_precise(); );
function settheme(i) ( slider11 = (i + NTH) % NTH; slider_automate(slider11); theme = slider11; sprintf(#rd, "COLOR · %s", thname(theme)); msgt = time_precise(); );
function thmenu() local(r, i) (
  strcpy(#m, "[  COLOR  ]|"); i = 0;
  loop(NTH, i == theme ? strcat(#m, "!"); strcat(#m, thname(i)); i < NTH - 1 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m);
  r >= 2 ? settheme(r - 2);
);
// dashed frame (empty "+" slot of the chain)
function dframe(x, y, w, h) local(i) (
  i = 0; while (i < w) (gfx_rect(x + i, y, min(S(4), w - i), 1); gfx_rect(x + i, y + h - 1, min(S(4), w - i), 1); i += S(7););
  i = 0; while (i < h) (gfx_rect(x, y + i, 1, min(S(4), h - i)); gfx_rect(x + w - 1, y + i, 1, min(S(4), h - i)); i += S(7););
);
// cut a string with "..." until it fits into w pixels (current font); result in #fit
// (fw_ is reset first: locals keep their old value, and an empty text is never measured)
function fit(s, w) local(fw_, n, g_) (
  strcpy(#fit, s);
  skin ? (slcur_ = slsp_; g_ = nchr(#fit) - 1;   // v0.58.6: too wide with spacing -> less spacing first, cut only if still too wide
          g_ > 0 && swid(#fit) > w ? (slcur_ = max(0, floor((w - csum(#fit)) / g_));););
  fw_ = swid(#fit);
  fw_ > w ? (
    n = strlen(#fit); strcpy(#fit2, #fit);
    while (n > 1 && fw_ > w) (n -= 1; str_setlen(#fit, n); strcpy(#fit2, #fit); strcat(#fit2, "..."); fw_ = swid(#fit2););
    strcpy(#fit, #fit2);
  );
  #fit;
);
function glowtxt(s, x, y, a) (   // gte = fade-in factor of the readout (v0.54.2), 1 = full
  rc(K_RDT, 0.07 * a * gte); txt(s, x - 2, y); txt(s, x + 2, y); txt(s, x, y - 2); txt(s, x, y + 2);
  rc(K_RDT, 0.16 * a * gte); txt(s, x - 1, y); txt(s, x + 1, y); txt(s, x, y - 1); txt(s, x, y + 1);
  rc(K_RDT, (0.45 + 0.55 * a) * gte); txt(s, x, y);
);
function inr(x, y, w, h) ( mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h );
// ---- Sleeve look helpers ----
SFK = 1.25;   // condensed font reads small: Sleeve text +25 %
function sfont(id, sz) ( gfx_setfont(id, #sf, floor(sz * SFK + 0.5), sfb); slsp_ = (sz < S(24) ? max(1, floor(max(1, floor(sz * SFK * 0.13 + 0.5)) * (spk_ > 0 ? spk_ : 1))) : 0); slcur_ = slsp_; );
function frame2(x, y, w, h, t) ( gfx_rect(x, y, w, t); gfx_rect(x, y + h - t, w, t); gfx_rect(x, y, t, h); gfx_rect(x + w - t, y, t, h); );
// hand-drawn marker cross (Sleeve: muted lane number): two wobbly strokes, each traced twice with a small offset
function hstroke(ax, ay, bx, by, sd) local(i, t, px, py, qx, qy, nx, ny, ln, o, w) (
  ln = max(1, sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)); nx = -(by - ay) / ln; ny = (bx - ax) / ln;
  o = 0;
  loop(2,
    px = ax + nx * o; py = ay + ny * o; i = 1;
    loop(6,
      t = i / 6; w = sin(sd * 2.3 + i * 1.9 + o) * S(2) * (1 - abs(t - 0.5));   // bow + wobble, calmer at the ends
      qx = ax + (bx - ax) * t + nx * (w + o); qy = ay + (by - ay) * t + ny * (w + o);
      gfx_line(px, py, qx, qy, 1); gfx_line(px + 1, py, qx + 1, qy, 1); gfx_line(px, py + 1, qx, qy + 1, 1);
      px = qx; py = qy; i += 1;
    );
    o += S(2);
  );
);
function hcross(x, y, w, h, sd) (
  gfx_set(0.86, 0.12, 0.10, 0.92);   // marker red, the same in every color (user wish)
  hstroke(x + S(2), y + S(1), x + w - S(1), y + h - S(3), sd);
  hstroke(x + w - S(3), y + S(3), x + S(1), y + h - S(1), sd + 7);
);
function slant(x, y, w, h, d) ( gfx_triangle(x + d, y, x + d + w, y, x + w, y + h, x, y + h); );   // stripe, top shifted right by d
// outlined text: fg copies around, background color on top (fake stroke)
function otxt(s, x, y, ow) (
  rc(K_PLY, 1); txt(s, x - ow, y); txt(s, x + ow, y); txt(s, x, y - ow); txt(s, x, y + ow);
  txt(s, x - ow, y - ow); txt(s, x + ow, y + ow); txt(s, x - ow, y + ow); txt(s, x + ow, y - ow);
  rc(K_BG2, 1); txt(s, x, y);
);
// header cell: thick fg line left, thin line below; on = filled with the step color
function shbtn(x, y, w, h, s, hi, en) local(fs) (
  hi ? (rc(K_ACC, 1); gfx_rect(x, y, w, h););
  rc(K_PLY, 1); gfx_rect(x, y, S(4), h);
  rc(K_LINE, 1); gfx_rect(x + S(4), y + h - S(2), w - S(4), S(2));
  fs = (hi ? S(27) : S(25)); sfont(4, fs);
  hi ? rc(K_BG2, 1) : en ? rc(K_PLY, 1) : rc(K_DIM, 1);
  ctxt(fit(s, w - S(12)), x + S(4), y + (h - fs * SFK) / 2, w - S(4));
);
// plain value (no box), right-aligned; hot = focus color + underline
function sval(x, y, w, h, s, hot, tr) (
  sfont(4, S(20)); hot ? rc(K_FOC, 1) : rc(tr, 1);
  rtxt(s, x + w, y + (h - S(20) * SFK) / 2);
  hot ? gfx_rect(x, y + h - S(2), w, S(2));
);
function btn(x, y, w, h, s, hi, en) (
  skin ? (
    hi ? (rc(K_FOC, 1); gfx_rect(x, y, w, h);) : (en ? rc(K_PLY, 1) : rc(K_LINE, 1); frame2(x, y, w, h, S(2)););
    sfont(4, BTNFS > 0 ? BTNFS : S(19)); hi ? rc(K_FOCT, 1) : en ? rc(K_PLY, 1) : rc(K_DIM, 1);
    // v0.58.7: BTNBOLD = label drawn twice 1 px apart (only view tabs, P-LOCK group, song row, bottom tabs) · BTNDY = vertical nudge
    ctxt(fit(s, w - S(8) - BTNBOLD), x, y + (h - (BTNFS > 0 ? BTNFS : S(19)) * SFK) / 2 + BTNDY, w);
    BTNBOLD ? ctxt(#fit, x + 1, y + (h - (BTNFS > 0 ? BTNFS : S(19)) * SFK) / 2 + BTNDY, w);
  ) : (
    hi ? (rc(K_FOC, 1); gfx_rect(x, y, w, h);) : (
      rc(K_BTN, 1); gfx_rect(x, y, w, h);
      rc(K_FLDB, 1); frame(x, y, w, h);
    );
    gfx_setfont(4, "Bahnschrift", BTNFS > 0 ? BTNFS : CF(S(13)), 'b');
    hi ? rc(K_FOCT, 1) : en ? rc(K_TXT, 1) : rc(K_DIM, 1);
    ctxt(fit(s, w - S(6)), x, y + (h - (BTNFS > 0 ? BTNFS : S(13))) / 2 - 1, w);
  );
);
// value box (LEN, RATE, edit strip, GEN): dark field, focus frame when hot, text in role tr
function vboxc(x, y, w, h, s, hot, fs, tr) (
  skin ? (
    rc(K_LINE2, 1); gfx_rect(x, y, w, h);
    hot ? rc(K_FOC, 1) : rc(K_LINE, 1); frame2(x, y, w, h, S(2));
    sfont(5, fs + S(2)); rc(tr, 1); ctxt(s, x, y + (h - (fs + S(2)) * SFK) / 2, w);
  ) : (
    rc(K_FLD, 1); gfx_rect(x, y, w, h);
    hot ? rc(K_FOC, 1) : rc(K_FLDB, 1); frame(x, y, w, h);
    gfx_setfont(5, "Consolas", CF(fs)); rc(tr, 1);
    ctxt(s, x, y + (h - fs) / 2, w);
  );
);
function vbox(x, y, w, h, s, hot, fs) ( vboxc(x, y, w, h, s, hot, fs, K_TXT); );
function cellx(k) ( GX + k * (CW + CG) + floor(k / 4) * (GG - CG) );
function laney(p) ( LY + p * (LH + LGAP) );
function lrow1(p) ( laney(p) + L1OFF );   // lane strip row 1: name, position, LEN, RATE
// v0.59.1 mouse on the lane name (Classic "PART x" text, Sleeve big "0x" block) = TEST HIT area
function onname(p) ( skin ? inr(LSX, laney(p), NUMW, LH) : inr(LSX - S(4), lrow1(p) - S(2), S(72), R1H + S(4)); );
function lrow2(p) ( laney(p) + L2OFF );   // lane strip row 2: direction, swing, humanize
function pbx(i) ( MG + S(62) + i * (PBW + S(6)) );
function fldx(f) ( FX0 + f * FSTEP );   // f = position 0-6 in the edit strip
// display order: SELECTED, VELOCITY, CHANCE, SLICE, CONDITION, OFFSET
function fldpos(f) ( f == 1 ? 1 : f == 5 ? 2 : f == 2 ? 3 : f == 6 ? 4 : f == 3 ? 5 : f == 8 ? 6 : f == 4 ? 7 : 8; );   // ... CONDITION, TARGET, OFFSET, PITCH
function tgname(t) ( t == 1 ? "SLICE" : t == 2 ? "P-LOCK" : "STEP"; );
function msgstep(p, s) (
  ON[p * NSTEP + s] ? sprintf(#rd, "PART %d · STEP %02d · VEL %d", p + 1, s + 1, VEL[p * NSTEP + s])
                    : sprintf(#rd, "PART %d · STEP %02d · OFF", p + 1, s + 1);
  msgt = now;
);
// mark the project as changed (pattern data lives in @serialize, not in sliders)
function bump() ( slider5 = (slider5 + 1) % 1000000; slider_automate(slider5); lkswp = 1; );
// Shift held at the start of a gesture (dall) = all six lanes
function setlen(p, l) local(i) ( dall ? (i = 0; loop(NP, LEN[i] = l; i += 1;);) : (LEN[p] = l;); );
function setrate(p, r) local(i) ( dall ? (i = 0; loop(NP, RATE[i] = r; i += 1;);) : (RATE[p] = r;); );
function msglen(p) (
  dall ? sprintf(#rd, "ALL PARTS · LENGTH %d STEPS", LEN[p]) : sprintf(#rd, "PART %d · LENGTH %d STEPS", p + 1, LEN[p]);
  msgt = now;
);
function msgrate(p) (
  dall ? sprintf(#rd, "ALL PARTS · RATE %s", rname(RATE[p])) : sprintf(#rd, "PART %d · RATE %s", p + 1, rname(RATE[p]));
  msgt = now;
);
function mname(i) (
  i == 0 ? "OFF" : i == 1 ? "1/2 BAR" : i == 2 ? "1 BAR" : i == 3 ? "2 BARS" : i == 4 ? "3 BARS" :
  i == 5 ? "4 BARS" : i == 6 ? "8 BARS" : "16 BARS";
);
function setmaster(i) (
  slider6 = max(0, min(7, i)); slider_automate(slider6);
  sprintf(#rd, "MASTER LENGTH · %s", mname(slider6)); msgt = now;
);
function mastermenu() local(r, i) (
  strcpy(#m, "[  ALL LANES RESTART AFTER  ]|"); i = 0;
  loop(8, i == slider6 ? strcat(#m, "!"); strcat(#m, mname(i)); i < 7 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m) - 1;
  r > 0 ? setmaster(r - 1);
);

UB = 20000;   // undo copy: ON +0, VEL +400, SLC +800, CND +1200, OFS +1600, LEN +2000, RATE +2010, HT +2020, HV +2030, CHN +2100
function swapmem(a, b, n) local(i, t) ( i = 0; loop(n, t = a[i]; a[i] = b[i]; b[i] = t; i += 1;); );
function snap() (
  memcpy(UB, ON, 384); memcpy(UB + 400, VEL, 384); memcpy(UB + 800, SLC, 384); memcpy(UB + 1200, CND, 384);
  memcpy(UB + 1600, OFS, 384); memcpy(UB + 2000, LEN, 6); memcpy(UB + 2010, RATE, 6); memcpy(UB + 2020, HT, 6); memcpy(UB + 2030, HV, 6);
  memcpy(UB + 2100, CHN, 384); memcpy(UB + 5000, PL, NP * NSTEP * NPL); memcpy(UB + 2040, SW, 6); memcpy(UB + 15000, RMP, 384); memcpy(UB + 2050, DIR, 6);
  memcpy(UB + 15400, PIT, 384); memcpy(UB + 15800, PBNOTE, 6); memcpy(UB + 15810, PON, 6); memcpy(UB + 15820, GRV, 6); memcpy(UB + 15830, GAM, 6); memcpy(UCT, CTG, 384); memcpy(UAC, AC, 80); memcpy(UACP, ACP, 26);
  ukp = -1;   // v0.51: kit undo only right after RESET PATTERN
  hasundo = 1;
);
function doundo() (
  swapmem(UB, ON, 384); swapmem(UB + 400, VEL, 384); swapmem(UB + 800, SLC, 384); swapmem(UB + 1200, CND, 384);
  swapmem(UB + 1600, OFS, 384); swapmem(UB + 2000, LEN, 6); swapmem(UB + 2010, RATE, 6); swapmem(UB + 2020, HT, 6); swapmem(UB + 2030, HV, 6);
  swapmem(UB + 2100, CHN, 384); swapmem(UB + 5000, PL, NP * NSTEP * NPL); swapmem(UB + 2040, SW, 6); swapmem(UB + 15000, RMP, 384); swapmem(UB + 2050, DIR, 6);
  swapmem(UB + 15400, PIT, 384); swapmem(UB + 15800, PBNOTE, 6); swapmem(UB + 15810, PON, 6); swapmem(UB + 15820, GRV, 6); swapmem(UB + 15830, GAM, 6); swapmem(UCT, CTG, 384); swapmem(UAC, AC, 80); swapmem(UACP, ACP, 26);
  ukp == curpat ? swapmem(UKIT, KITB + curpat * 140, 140);   // v0.51: RESET PATTERN also gives the kit back
);
function lenmenu(p) local(r) (
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = (dall ? gfx_showmenu("[  ALL 6 PARTS  ]|4|6|7|8|10|12|14|16|24|32|48|64") - 1 : gfx_showmenu("4|6|7|8|10|12|14|16|24|32|48|64"));
  r > 0 ? (
    snap();   // v0.58.1: lenmenu now sits below snap()
    setlen(p, r == 1 ? 4 : r == 2 ? 6 : r == 3 ? 7 : r == 4 ? 8 : r == 5 ? 10 : r == 6 ? 12 : r == 7 ? 14 :
              r == 8 ? 16 : r == 9 ? 24 : r == 10 ? 32 : r == 11 ? 48 : 64);
    focus = p; msglen(p); bump();
  );
);
function mbat(i) ( i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 5 : i == 5 ? 6 : i == 6 ? 2 : i; );   // v0.52: + KIT before TOOLS   // bottom tabs, visual order: TOOLS last (2026-11-06)
function mbname(m) ( m == 0 ? "STEP" : m == 1 ? "GEN" : m == 2 ? "TOOLS" : m == 3 ? "BEAT" : m == 4 ? "FEEL" : m == 5 ? "ROUTE" : "KIT"; );
function tabat(i) ( i == 5 ? 6 : i == 6 ? 5 : i; );   // view tabs, visual order: PITCH before P-LOCK
// ---- pitch (v0.31): note names C4 = 60; lane PIT box = PON on/off + PBNOTE base note ----
function nname(n) local(o) (
  o = floor(n / 12) - 1; n = n % 12;
  sprintf(#nn, "%s%d", n == 0 ? "C" : n == 1 ? "C#" : n == 2 ? "D" : n == 3 ? "D#" : n == 4 ? "E" : n == 5 ? "F" : n == 6 ? "F#" :
                       n == 7 ? "G" : n == 8 ? "G#" : n == 9 ? "A" : n == 10 ? "A#" : "B", o);
  #nn;
);
function setpon(p, v) local(i) ( dall ? (i = 0; loop(NP, PON[i] = v; i += 1;);) : (PON[p] = v;); );
function setpbase(p, v) local(i) ( v = max(0, min(127, v)); dall ? (i = 0; loop(NP, PBNOTE[i] = v; PON[i] = 1; i += 1;);) : (PBNOTE[p] = v; PON[p] = 1;); );
function msgpit(p) (
  PON[p] ? sprintf(#t2, "PITCH ON · BASE %s · ch %d · needs QPI ON", nname(PBNOTE[p]), 11 + p) : strcpy(#t2, "PITCH OFF · fixed trigger note");
  dall ? sprintf(#rd, "ALL PARTS · %s", #t2) : sprintf(#rd, "PART %d · %s", p + 1, #t2);
  msgt = now;
);
function pitmenu(p) local(r, i) (
  dall ? strcpy(#m, "[  PITCH, ALL 6 PARTS  ]|") : sprintf(#m, "[  PITCH, PART %d  ]|", p + 1);
  !PON[p] ? strcat(#m, "!"); strcat(#m, "OFF  (fixed trigger note)||");
  i = 0; loop(7, PON[p] && PBNOTE[p] == 24 + i * 12 ? strcat(#m, "!"); sprintf(#n, "Base %s", nname(24 + i * 12)); strcat(#m, #n); i < 6 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m) - 1;
  r == 1 ? (snap(); setpon(p, 0); msgpit(p); bump();)
  : r > 1 ? (snap(); setpbase(p, 24 + (r - 2) * 12); msgpit(p); bump(););
);
function pitval(i) ( i == 0 ? 12 : i == 1 ? 7 : i == 2 ? 5 : i == 3 ? 3 : i == 4 ? 2 : i == 5 ? 1 : i == 6 ? 0 :
                     i == 7 ? -1 : i == 8 ? -2 : i == 9 ? -3 : i == 10 ? -5 : i == 11 ? -7 : -12; );
// ---- swing: global = slider 9, lane = SW[p] (0 = follows global) ----
function swv(i) ( i == 0 ? 50 : i == 1 ? 54 : i == 2 ? 58 : i == 3 ? 62 : i == 4 ? 66 : i == 5 ? 70 : 75; );
function swn(i) ( i == 0 ? "50 %  straight" : i == 4 ? "66 %  triplet feel" : i == 6 ? "75 %  dotted" : (sprintf(#swn, "%d %%", swv(i)); #swn); );
function gsw() ( max(50, min(75, floor(slider9 + 0.5))) );
function lsw(p) ( SW[p] >= 50 ? SW[p] : gsw() );   // what the lane plays
function setgsw(v) (
  slider9 = max(50, min(75, v)); slider_automate(slider9);
  slider9 == 50 ? strcpy(#rd, "SWING ALL LANES · STRAIGHT") : sprintf(#rd, "SWING ALL LANES · %d%%", slider9);
  msgt = now;
);
// v = 0: back to global. Shift held at the start (dall) = all six lanes
function setlsw(p, v) local(i) ( dall ? (i = 0; loop(NP, SW[i] = v; i += 1;);) : (SW[p] = v;); );
// ---- direction ----
function dname(d) ( d == 0 ? "FORWARD" : d == 1 ? "BACKWARD" : d == 2 ? "PING-PONG" : "RANDOM"; );
function setdir(p, d) local(i) ( dall ? (i = 0; loop(NP, DIR[i] = d; i += 1;);) : (DIR[p] = d;); );
function msgdir(p) (
  dall ? sprintf(#rd, "ALL PARTS · %s", dname(DIR[p])) : sprintf(#rd, "PART %d · %s", p + 1, dname(DIR[p]));
  msgt = now;
);
function dirmenu(p) local(r, i) (
  dall ? strcpy(#m, "[  DIRECTION, ALL 6 PARTS  ]|") : sprintf(#m, "[  DIRECTION, PART %d  ]|", p + 1); i = 0;
  loop(4, DIR[p] == i ? strcat(#m, "!"); strcat(#m, dname(i)); i < 3 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m) - 1;
  r > 0 ? (snap(); setdir(p, r - 1); msgdir(p); bump(););
);
function msglsw(p) (
  dall ? (SW[p] >= 50 ? sprintf(#rd, "ALL PARTS · SWING %d%%", SW[p]) : sprintf(#rd, "ALL PARTS · SWING = GLOBAL %d%%", gsw());)
       : (SW[p] >= 50 ? sprintf(#rd, "PART %d · SWING %d%%", p + 1, SW[p]) : sprintf(#rd, "PART %d · SWING = GLOBAL %d%%", p + 1, gsw()););
  msgt = now;
);
function gswmenu() local(r, i) (
  strcpy(#m, "[  SWING, ALL LANES  ]|"); i = 0;
  loop(7, swv(i) == gsw() ? strcat(#m, "!"); strcat(#m, swn(i)); i < 6 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m) - 1;
  r > 0 ? setgsw(swv(r - 1));
);
function lswmenu(p) local(r, i) (
  dall ? strcpy(#m, "[  SWING, ALL 6 PARTS  ]|") : sprintf(#m, "[  SWING, PART %d  ]|", p + 1);
  SW[p] < 50 ? strcat(#m, "!"); strcat(#m, "Follow global||"); i = 0;
  loop(7, SW[p] == swv(i) ? strcat(#m, "!"); strcat(#m, swn(i)); i < 6 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m) - 1;
  r == 1 ? (snap(); setlsw(p, 0); msglsw(p); bump();)
  : r > 1 ? (snap(); setlsw(p, swv(r - 2)); msglsw(p); bump(););
);
// ---- selection: SELM[384] = selected steps, selp/sels = main (last clicked) step ----
SELM = 5000; CLIP = 60000; CLW = 11 + NPL; LKL = 51000;   // clipboard: 8 values + 26 p-locks + ramp + pitch per step
// p-lock helpers for the GUI
function haslk(ix) local(k, r) ( r = 0; k = 0; loop(NPL, PL[ix * NPL + k] >= 0 ? (r += 1;); k += 1;); r; );
function pbase(j) ( j == 0 ? "SELECT" : j == 1 ? "LEVEL" : j == 2 ? "ATTACK" : j == 3 ? "RELEASE" : j == 4 ? "PITCH" : j == 5 ? "MOD AMT" : "MOD RATE"; );
function pname(k) (
  k < 7 ? sprintf(#pn, "L1 %s", pbase(k)) : k < 14 ? sprintf(#pn, "L2 %s", pbase(k - 7)) :
  strcpy(#pn, k == 14 ? "PAN" : k == 15 ? "BIT" : k == 16 ? "FOLD" : k == 17 ? "DRIVE" : k == 18 ? "GAIN" : k == 19 ? "WG SEND" :
              k == 20 ? "FILTER" : k == 21 ? "CLIP" : k == 22 ? "WG MODEL" : k == 23 ? "WG DECAY" : k == 24 ? "WG BODY" : "WG TUNE");
  #pn;
);
// v0.58.6 P-LOCK group (after the tabs are drawn): PARAM = value field with a ▼, VALUE | RANGE = 2-way switch, one frame around tab + both
function plgroup(warn) local(ax, ay) (
  vbox(PARX, TBY, PLPW, TBH, pname(plk), hreg == 219, skin ? S(14) : S(12));
  ax = PARX + PLPW - S(12); ay = TBY + TBH / 2; rc(K_LBL, 1); gfx_triangle(ax - S(4), ay - S(2), ax + S(4), ay - S(2), ax, ay + S(3));
  BTNFS = (skin ? S(16) : 0);
  BTNBOLD = skin; btn(RNGX, TBY, RNGW / 2, TBH, "VALUE", !plrng, 1); btn(RNGX + RNGW / 2, TBY, RNGW - RNGW / 2, TBH, "RANGE", plrng, 1); BTNBOLD = 0;
  BTNFS = 0;
  rc(K_FOC, 1); skin ? frame2(PLGX - S(4), TBY - S(4), RNGX + RNGW - PLGX + S(8), TBH + S(8), S(2))
                     : frame(PLGX - S(3), TBY - S(3), RNGX + RNGW - PLGX + S(6), TBH + S(6));
  warn ? (rc(K_HOT, 1); skin ? frame2(PARX, TBY, PLPW, TBH, S(2)) : (frame(PARX, TBY, PLPW, TBH); frame(PARX + 1, TBY + 1, PLPW - 2, TBH - 2);););
);
// which parameter the P-LOCK tab shows / paints (menu grouped like the panel)
function plkmenu() local(r, k) (
  strcpy(#m, ""); k = 0;
  loop(NPL,
    k == 0 ? strcat(#m, ">LAYER 1|") : k == 7 ? strcat(#m, ">LAYER 2|") : k == 14 ? strcat(#m, ">MIX|") : k == 22 ? strcat(#m, ">WAVEGUIDE|");
    (k == 6 || k == 13 || k == 21 || k == 25) ? strcat(#m, "<") : (k == plk ? strcat(#m, "!"););
    strcat(#m, pname(k));
    (k == 4 || k == 11) && PON[focus] ? strcat(#m, "   (PIT on: use the PITCH tab)");   // v0.41.1
    k < NPL - 1 ? strcat(#m, "|");
    k += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r > 0 ? (plk = r - 1; sprintf(#rd, "P-LOCK · %s", pname(plk)); msgt = now;);
);
function selidx() ( selp * NSTEP + sels; );
function selclear() ( memset(SELM, 0, NP * NSTEP); nsel = 0; );
function selone(p, s) ( selclear(); SELM[p * NSTEP + s] = 1; nsel = 1; selp = p; sels = s; );
function seltoggle(p, s) local(ix) (
  ix = p * NSTEP + s; SELM[ix] = !SELM[ix]; nsel += (SELM[ix] ? 1 : -1);
  SELM[ix] ? (selp = p; sels = s;);
);
function seladd(p, s) local(ix) ( ix = p * NSTEP + s; !SELM[ix] ? (SELM[ix] = 1; nsel += 1;); );
// rectangle between two steps (lanes p0..p1, steps s0..s1), only steps inside each lane's length
function selrect(p0, s0, p1, s1) local(pa, pz, sa, sb, p, s) (
  pa = min(p0, p1); pz = max(p0, p1); sa = min(s0, s1); sb = max(s0, s1);
  p = pa; loop(pz - pa + 1, s = sa; loop(sb - sa + 1, s < LEN[p] ? seladd(p, s); s += 1;); p += 1;);
);
// fields: 1 velocity, 2 slice, 3 condition, 4 offset, 5 chance, 6 ramp, 7 pitch
function fval(ix, f) ( f == 1 ? VEL[ix] : f == 2 ? SLC[ix] : f == 3 ? CND[ix] : f == 4 ? OFS[ix] : f == 6 ? RMP[ix] : f == 7 ? PIT[ix] : f == 8 ? CTG[ix] : CHN[ix]; );
function applyf(ix, f, v) (
  f == 1 ? (VEL[ix] = max(1, min(127, v));) :
  f == 7 ? (PIT[ix] = max(-24, min(24, v));) :
  f == 8 ? (CTG[ix] = max(0, min(2, v));) :
  f == 2 ? (SLC[ix] = max(0, min(NSL - 1, v));) :
  f == 3 ? (CND[ix] = max(0, min(NC - 1, v));) :
  f == 4 ? (OFS[ix] = max(-40, min(40, v));) :
  f == 6 ? (RMP[ix] = max(-100, min(100, v));) :
           (CHN[ix] = max(0, min(100, v)););
);
function fdesc(ix, f) (
  f == 1 ? sprintf(#fd, "VEL %d", VEL[ix]) : f == 2 ? sprintf(#fd, "SLICE %s", slname(SLC[ix])) :
  f == 3 ? sprintf(#fd, "IF %s", CNM[CND[ix]]) : f == 4 ? sprintf(#fd, "OFFSET %+d%%", OFS[ix]) :
  f == 8 ? sprintf(#fd, "CONDITION + CHANCE DECIDE · %s", CTG[ix] == 1 ? "ONLY THE SLICE (step always plays)" : CTG[ix] == 2 ? "ONLY THE P-LOCKS (note always plays)" : "THE WHOLE STEP") :
  f == 7 ? (PON[floor(ix / NSTEP)] ? sprintf(#fd, "PITCH %+d · %s", PIT[ix], nname(max(0, min(127, PBNOTE[floor(ix / NSTEP)] + PIT[ix]))))
                                   : sprintf(#fd, "PITCH %+d · lane PIT is OFF", PIT[ix])) :
  f == 6 ? (RMP[ix] == 0 ? strcpy(#fd, "RAMP OFF") : (RMP[ix] > 0 ? sprintf(#fd, "RAMP %+d%% · LOUDER", RMP[ix]) : sprintf(#fd, "RAMP %+d%% · SOFTER", RMP[ix]))) : sprintf(#fd, "CHANCE %d%%", CHN[ix]);
  #fd;
);
function msgsel(what) local(ix) (
  ix = selidx();
  nsel > 1 ? sprintf(#rd, "%d STEPS · %s", nsel, fdesc(ix, what)) : sprintf(#rd, "P%d STEP %02d · %s", selp + 1, sels + 1, fdesc(ix, what));
  msgt = now;
);
// set field f to v. One step: switches it on. Several: only the lit ones change.
function setfld(f, v) local(i) (
  nsel > 1 ? (
    i = 0; loop(NP * NSTEP, SELM[i] && ON[i] ? applyf(i, f, v); i += 1;);
    applyf(selidx(), f, v);
  ) : (applyf(selidx(), f, v); ON[selidx()] = max(1, ON[selidx()]););
  msgsel(f);
);
// move field f by d (VEL, OFFSET, CHANCE: relative, differences between the steps stay)
function addfld(f, d) local(i) (
  nsel > 1 ? (
    i = 0; loop(NP * NSTEP, SELM[i] && ON[i] ? applyf(i, f, fval(i, f) + d); i += 1;);
    !(SELM[selidx()] && ON[selidx()]) ? applyf(selidx(), f, fval(selidx(), f) + d);
  ) : (applyf(selidx(), f, fval(selidx(), f) + d); ON[selidx()] = max(1, ON[selidx()]););
  msgsel(f);
);
function getfld(f) ( fval(selidx(), f); );
function isrel(f) ( f == 1 || f == 4 || f == 5 || f == 7; );
// clear slice/condition/offset/chance (what = 0) or delete the steps (what = 1) of the selection (or the main step)
function clrsel(what) local(i, k) (
  nsel < 1 ? seladd(selp, sels);
  i = 0;
  loop(NP * NSTEP,
    SELM[i] ? (SLC[i] = 0; CND[i] = 0; OFS[i] = 0; CHN[i] = 100; RMP[i] = 0; CTG[i] = 0; what ? (ON[i] = 0; VEL[i] = DEFVEL; PIT[i] = 0;);
               k = 0; loop(NPL, PL[i * NPL + k] = -1; k += 1;););
    i += 1;
  );
);
function deffld(f) ( f == 1 ? DEFVEL : f == 5 ? 100 : 0; );
function ofsval(i) ( i == 0 ? -40 : i == 1 ? -30 : i == 2 ? -20 : i == 3 ? -10 : i == 4 ? -5 : i == 5 ? 0 :
                     i == 6 ? 5 : i == 7 ? 10 : i == 8 ? 20 : i == 9 ? 30 : 40; );
function rmpval(i) ( (i - 4) * 25 );   // -100 .. +100 in 25 % steps
function chval(i) ( i == 0 ? 100 : i == 1 ? 90 : i == 2 ? 75 : i == 3 ? 66 : i == 4 ? 50 : i == 5 ? 33 : i == 6 ? 25 : 10; );
// list for one field: returns the chosen value or -1000
function fldmenu(f) local(r, i, ix) (
  ix = selidx(); strcpy(#m, "");
  f == 1 ? (
    i = 0; loop(8, sprintf(#n, "%d", i == 0 ? 20 : i == 1 ? 40 : i == 2 ? 63 : i == 3 ? 80 : i == 4 ? 96 : i == 5 ? 110 : i == 6 ? 120 : 127);
                   strcat(#m, #n); i < 7 ? strcat(#m, "|"); i += 1;);
  ) : f == 2 ? (
    i = 0; loop(NSL, i == SLC[ix] ? strcat(#m, "!"); strcat(#m, slname(i)); i < NSL - 1 ? strcat(#m, "|"); i += 1;);
  ) : f == 3 ? (
    i = 0; loop(NC, i == CND[ix] ? strcat(#m, "!"); strcat(#m, CNM[i]); i < NC - 1 ? strcat(#m, "|"); i += 1;);
  ) : f == 6 ? (
    i = 0; loop(9, rmpval(i) == RMP[ix] ? strcat(#m, "!"); (i == 4 ? strcpy(#n, "0  off") : i < 4 ? sprintf(#n, "%+d%%  softer", rmpval(i)) : sprintf(#n, "%+d%%  louder", rmpval(i))); strcat(#m, #n); i < 8 ? strcat(#m, "|"); i += 1;);
  ) : f == 8 ? (
    strcpy(#m, CTG[ix] == 0 ? "!" : ""); strcat(#m, "STEP  (whole step)|"); CTG[ix] == 1 ? strcat(#m, "!"); strcat(#m, "SLICE  (only the roll)|"); CTG[ix] == 2 ? strcat(#m, "!"); strcat(#m, "P-LOCK  (only the locks)");
  ) : f == 7 ? (
    i = 0; loop(13, pitval(i) == PIT[ix] ? strcat(#m, "!"); sprintf(#n, "%+d", pitval(i)); strcat(#m, #n); i < 12 ? strcat(#m, "|"); i += 1;);
  ) : f == 4 ? (
    i = 0; loop(11, ofsval(i) == OFS[ix] ? strcat(#m, "!"); sprintf(#n, "%+d%%", ofsval(i)); strcat(#m, #n); i < 10 ? strcat(#m, "|"); i += 1;);
  ) : (
    i = 0; loop(8, chval(i) == CHN[ix] ? strcat(#m, "!"); sprintf(#n, "%d%%", chval(i)); strcat(#m, #n); i < 7 ? strcat(#m, "|"); i += 1;);
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r <= 0 ? -1000 : f == 1 ? (r == 1 ? 20 : r == 2 ? 40 : r == 3 ? 63 : r == 4 ? 80 : r == 5 ? 96 : r == 6 ? 110 : r == 7 ? 120 : 127)
         : f == 4 ? ofsval(r - 1) : f == 5 ? chval(r - 1) : f == 6 ? rmpval(r - 1) : f == 7 ? pitval(r - 1) : f == 8 ? r - 1 : r - 1;
);
// TRIGLESS toggle for the selection (or the main step): main step trigless -> all back to normal notes,
// else all selected steps become trigless (empty ones too: they get switched on as lock-only steps)
function dotrigless() local(i, to) (
  snap(); nsel < 1 ? seladd(selp, sels);
  to = (ON[selidx()] == 2 ? 1 : 2);
  i = 0; loop(NP * NSTEP, SELM[i] ? (ON[i] = to;); i += 1;);
  to == 2 ? strcpy(#rd, "TRIGLESS · NO NOTE, ONLY P-LOCKS") : strcpy(#rd, "NORMAL STEP · PLAYS A NOTE AGAIN");
  msgt = now; bump();
);
// right-click on a step: everything in one menu with submenus. Returns 1 copy, 2 paste, 3 delete, 4 select lane, 5 undo, else 0
function stepmenu() local(r, i, ix, b, nl, k) (
  ix = selidx();
  // v0.58.4 menu order: header (scope) · edit · clipboard · remove/clear/delete always at the bottom
  nsel > 1 ? sprintf(#m, "[  %d STEPS SELECTED  ]|>SLICE|", nsel) : sprintf(#m, "[  PART %d · STEP %d  ]|>SLICE|", selp + 1, sels + 1);
  i = 0; loop(NSL, i == NSL - 1 ? strcat(#m, "<") : (i == SLC[ix] ? strcat(#m, "!");); strcat(#m, slname(i)); strcat(#m, "|"); i += 1;);
  strcat(#m, ">CHANCE|");
  i = 0; loop(8, i == 7 ? strcat(#m, "<") : (chval(i) == CHN[ix] ? strcat(#m, "!");); sprintf(#n, "%d%%", chval(i)); strcat(#m, #n); strcat(#m, "|"); i += 1;);
  strcat(#m, ">CONDITION|");
  i = 0; loop(NC, i == NC - 1 ? strcat(#m, "<") : (i == CND[ix] ? strcat(#m, "!");); strcat(#m, CNM[i]); strcat(#m, "|"); i += 1;);
  strcat(#m, ">OFFSET|");
  i = 0; loop(11, i == 10 ? strcat(#m, "<") : (ofsval(i) == OFS[ix] ? strcat(#m, "!");); sprintf(#n, "%+d%%", ofsval(i)); strcat(#m, #n); strcat(#m, "|"); i += 1;);
  strcat(#m, ON[ix] == 2 ? "!TRIGLESS  (locks only, no note)||" : "TRIGLESS  (locks only, no note)||");
  strcat(#m, "Copy  (Ctrl+C)|Paste  (Ctrl+V)|Select whole lane  (Ctrl+A)|Undo / redo  (Ctrl+Z)||");
  // p-locks of the main step: click one = remove it
  nl = 0; i = 0; loop(NPL, PL[ix * NPL + i] >= 0 ? (LKL[nl] = i; nl += 1;); i += 1;);
  nl == 0 ? strcat(#m, "#P-LOCKS: none") : (
    strcat(#m, ">P-LOCKS|");
    i = 0; loop(nl, PL[ix * NPL + LKL[i]] >= 128 ? sprintf(#n, "Remove %s = %d ±%d|", pname(LKL[i]), PL[ix * NPL + LKL[i]] % 128, floor(PL[ix * NPL + LKL[i]] / 128))
                                    : sprintf(#n, "Remove %s = %d|", pname(LKL[i]), PL[ix * NPL + LKL[i]]); strcat(#m, #n); i += 1;);
    strcat(#m, "<Remove all p-locks of the selected steps");
  );
  strcat(#m, "|Clear extras  (slice, chance, condition, offset, p-locks)|Delete steps  (Del)");
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m) - 1;   // -1: the header line
  // separators don't count, the greyed "P-LOCKS: none" does, the >P-LOCKS submenu title doesn't
  b = NSL + 8 + NC + 11;   // last OFFSET item
  r == b + 1 ? dotrigless();
  r >= 1 && r <= NSL ? (snap(); setfld(2, r - 1); bump();)
  : r > NSL && r <= NSL + 8 ? (snap(); setfld(5, chval(r - NSL - 1)); bump();)
  : r > NSL + 8 && r <= NSL + 8 + NC ? (snap(); setfld(3, r - NSL - 8 - 1); bump();)
  : r > NSL + 8 + NC && r <= b ? (snap(); setfld(4, ofsval(r - NSL - 8 - NC - 1)); bump();)
  : r == b + 7 + nl ? (snap(); clrsel(0); strcpy(#rd, "EXTRAS CLEARED · notes stay"); msgt = now; bump();)
  : nl > 0 && r >= b + 6 && r < b + 6 + nl ? (snap(); PL[ix * NPL + LKL[r - b - 6]] = -1; strcpy(#rd, "P-LOCK REMOVED"); msgt = now; bump();)
  : nl > 0 && r == b + 6 + nl ? (
    snap(); nsel < 1 ? seladd(selp, sels);
    i = 0; loop(NP * NSTEP, SELM[i] ? (k = 0; loop(NPL, PL[i * NPL + k] = -1; k += 1;);); i += 1;);
    strcpy(#rd, "ALL P-LOCKS REMOVED"); msgt = now; bump();
  );
  // returns 1 copy, 2 paste, 3 delete, 4 select lane, 5 undo (caller unchanged)
  r == b + 2 ? 1 : r == b + 3 ? 2 : r == b + 4 ? 4 : r == b + 5 ? 5 : r == b + 8 + nl ? 3 : 0;
);

// ---- clear / reset with one undo level (undo again = redo) ----
// mode 1 = steps off (+ extras), 2 = extras only (slice/chance/condition/offset), 3 = full lane reset (+ length 16, 1/16, no humanize)
function clearlane(p, mode) local(i, ix, k) (
  i = 0;
  loop(NSTEP,
    ix = p * NSTEP + i;
    mode != 2 ? (ON[ix] = 0; VEL[ix] = DEFVEL; PIT[ix] = 0;);
    SLC[ix] = 0; CND[ix] = 0; OFS[ix] = 0; CHN[ix] = 100; RMP[ix] = 0; CTG[ix] = 0;
    k = 0; loop(NPL, PL[ix * NPL + k] = -1; k += 1;);
    i += 1;
  );
  mode == 3 ? (LEN[p] = 16; RATE[p] = 2; HT[p] = 0; HV[p] = 0; SW[p] = 0; DIR[p] = 0; PON[p] = 0; PBNOTE[p] = 60; GRV[p] = 0; GAM[p] = 100;);
);
// v0.51 RESET PATTERN: all 6 lanes reset + accent row + accent amounts + the pattern's kit (one undo, kit included)
function resetpat() local(j) (
  snap(); j = 0; loop(NP, clearlane(j, 3); j += 1;); acdef(AC); memset(ACP, 0, 26);
  memcpy(UKIT, KITB + curpat * 140, 140); ukp = curpat; memset(KITB + curpat * 140, 0, 140);
);
// v0.51 NEW SESSION: every pattern, chain, FILL PAT and the feel / route sliders back to a fresh instance
// (stays: sync + tempo, color + look, tap compensation, the panel sound). No undo.
function newsess() local(i) (
  wipecur(); i = 0; loop(NPAT, pinit(PB + i * PSZ); i += 1;);
  curpat = 0; pend = 0; chlen = 0; fillp = -1; hasundo = 0; ukp = -1; kppat = -1;
  slider8 = 1; slider6 = 0; slider7 = 0; slider9 = 50; slider10 = 0; slider13 = 0; slider14 = 0; slider15 = 0; slider16 = 0;
  slider17 = 0; slider19 = 0; slider20 = 2; slider21 = 63; slider22 = 0; slider23 = 0; slider24 = 0;
  slider_automate(slider8); slider_automate(slider6); slider_automate(slider7); slider_automate(slider9); slider_automate(slider10);
  slider_automate(slider13); slider_automate(slider14); slider_automate(slider15); slider_automate(slider16); slider_automate(slider17);
  slider_automate(slider19); slider_automate(slider20); slider_automate(slider21); slider_automate(slider22); slider_automate(slider23); slider_automate(slider24);
  resetrun(); lkswp = 1; selclear(); focus = 0; page = 0;
  strcpy(#rd, "NEW SESSION · all 16 patterns empty · the panel sound stays"); msgt = now; bump();
);
function newsessask() local(r) (
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu("#NEW SESSION wipes ALL 16 patterns, the chain and FILL PAT|#+ swing, chaos, density, evolve, auto fill, master, mute / solo / duck|#Stays: panel sound, sync, look. NO UNDO.|Yes, wipe everything|Cancel");
  r == 4 ? newsess() : (strcpy(#rd, "NEW SESSION CANCELLED · nothing changed"); msgt = now;);
);
// v0.51 AUTO FILL (slider 23)
function afname(i) ( i == 0 ? "OFF" : i == 1 ? "2 BARS" : i == 2 ? "4 BARS" : i == 3 ? "8 BARS" : "16 BARS"; );
function setaf(i) (
  slider23 = max(0, min(4, i)); slider_automate(slider23);
  slider23 == 0 ? strcpy(#rd, "AUTO FILL OFF") : sprintf(#rd, "AUTO FILL · the last bar of every %d bars plays FILL", afn());
  msgt = now;
);
function afmenu() local(r, i) (
  strcpy(#m, "[  AUTO FILL · last bar of every n bars  ]"); i = 0;
  loop(5, strcat(#m, "|"); (slider23 | 0) == i ? strcat(#m, "!"); strcat(#m, i == 0 ? "OFF" : i == 1 ? "every 2 bars" : i == 2 ? "every 4 bars" : i == 3 ? "every 8 bars" : "every 16 bars"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m) - 1;
  r > 0 ? setaf(r - 1);
);
// v0.51 / v0.54: what a control does, shown in the readout while the mouse is over it (all tabs, both looks)
function tipdesc(h) local(f) (   // v0.55.2: only tips that add something to the name / click message; a few words only where the name is not enough; no match = no tip
  f = h - 10;
  h == 1 && onname(hp) ? sprintf(#rd, "PART %d · TEST HIT · plays the part once", hp + 1)
  : h == 9 && GRV[hp] ? sprintf(#rd, "GROOVE · %s %d%%", gname(GRV[hp]), GAM[hp])
  : h == 8 ? strcpy(#rd, "SWING · all lanes")
  : h == 19 ? strcpy(#rd, "PITCH MODE · the lane plays notes")
  : h == 12 ? strcpy(#rd, "SLICE · roll / flam inside one step")
  : h == 13 ? strcpy(#rd, "CONDITION · when the step plays")
  : h == 14 ? strcpy(#rd, "OFFSET · early / late")
  : h == 16 ? strcpy(#rd, "RAMP · the roll gets louder / softer")
  : h == 18 ? strcpy(#rd, "IF -> ONLY · what the condition switches")
  : h == 23 ? strcpy(#rd, "GROOVE · timing + loudness feel")
  : h == 25 ? strcpy(#rd, "CHAOS · random sloppiness")
  : h == 26 ? sprintf(#rd, "DUCK PART %d · sidechain trigger C1 ch 10", dkc + 1)
  : h == 27 ? strcpy(#rd, "EVOLVE · the last bar of every n bars varies")
  : h == 29 ? sprintf(#rd, "EVOLVE · PART %d may change", evpc + 1)
  : h == 30 ? strcpy(#rd, "AUTO FILL · the last bar of every n bars plays FILL")
  : h == 31 ? strcpy(#rd, "DENSITY · thinner <  > busier")
  : h == 67 ? strcpy(#rd, "SCOPE · focused part or parts 1-n · right-click = choose")
  : h == 69 ? strcpy(#rd, "MUTATE · small random changes")
  : h == 86 ? strcpy(#rd, "FEEL · also sets grooves + lengths")
  : h == 94 ? sprintf(#rd, "ACCENT · PART %d follows", akc + 1)
  : h == 201 ? strcpy(#rd, "SYNC · REAPER or own clock")
  : h == 205 ? strcpy(#rd, "MASTER LENGTH · all lanes restart together")
  : h == 206 ? strcpy(#rd, "FILL · FILL steps + FILL PAT")
  : h == 218 ? strcpy(#rd, "P-LOCK DRAG · VALUE paints the lock, RANGE a random range")
  : h == 219 ? sprintf(#rd, "P-LOCK PARAM · %s · the parameter this view paints", pname(plk))
  : h == 240 ? strcpy(#rd, "CHAIN · pattern list, one bar each")
  : h == 241 ? strcpy(#rd, "REGIONS · P1 ... P16 regions pick the pattern")
  : h == 271 ? strcpy(#rd, "CALIBRATE · tap record latency")
  : h == 75 ? strcpy(#rd, "REMOVE LOCKS · notes stay")
  : h == 76 ? strcpy(#rd, "CLEAR EXTRAS · notes stay")
  : h == 77 ? strcpy(#rd, "CLEAR LANE · length, rate, swing stay")
  : h == 78 ? strcpy(#rd, "RESET LANE · back to default")
  : h == 79 ? strcpy(#rd, "CLEAR PATTERN · all 6 lanes, settings, accent, kit stay")
  : h == 80 ? strcpy(#rd, "RESET PATTERN · incl. accent + kit")
  : h == 81 ? strcpy(#rd, "TRIGLESS · locks only, no note")
  : h == 97 ? strcpy(#rd, "GRAB KIT · the pattern keeps this panel sound")
  : h == 98 ? strcpy(#rd, "CLEAR KIT · steps stay")
  : h == 99 ? strcpy(#rd, "NEW SESSION · all 16 patterns + settings")
  : h == 100 ? (kithas(kslot) ? sprintf(#rd, "PATTERN %02d · KIT", kslot + 1) : sprintf(#rd, "PATTERN %02d · NO KIT", kslot + 1))
  : h == 103 ? strcpy(#rd, "REVERT · back to the stored kit");
);
// ---- KIT tab (v0.52): one pattern's kit ----
function ksend(k) (
  !kithas(k) ? sprintf(#rd, "PATTERN %02d HAS NO KIT", k + 1)
  : !pnl ? strcpy(#rd, "KIT · NO PANEL FOUND (Volca Drum Panel after the sequencer)")
  : (kitsend(k); k == curpat ? sprintf(#rd, "REVERTED · panel back to the kit of PATTERN %02d", k + 1)
                             : sprintf(#rd, "KIT OF PATTERN %02d ON THE PANEL · until the next pattern switch", k + 1););
  msgt = now;
);
function kcopy(k) (
  kithas(k) ? (memcpy(KCLIP, KITB + k * 140, 140); kcfull = 1; sprintf(#rd, "KIT OF PATTERN %02d COPIED", k + 1);)
  : sprintf(#rd, "PATTERN %02d HAS NO KIT TO COPY", k + 1);
  msgt = now;
);
function kpaste(k) (
  kcfull ? (
    memcpy(KITB + k * 140, KCLIP, 140); KITB[k * 140 + 136] = 1;
    k == curpat && pnl ? kitsend(k);
    sprintf(#rd, "KIT PASTED INTO PATTERN %02d", k + 1); bump();
  ) : strcpy(#rd, "THE KIT CLIPBOARD IS EMPTY · COPY KIT first");
  msgt = now;
);
function kclear(k) (
  kithas(k) ? (
    k == curpat ? (snap(); memcpy(UKIT, KITB + k * 140, 140); ukp = curpat;);   // v0.58.4: undo gives the kit back (current pattern)
    memset(KITB + k * 140, 0, 140); sprintf(#rd, "KIT CLEARED · PATTERN %02d keeps whatever sound is there", k + 1); bump();
  ) : sprintf(#rd, "PATTERN %02d HAS NO KIT · GRAB stores the panel sound", k + 1);
  msgt = now;
);
function kslotmenu(k) local(r, h) (
  h = kithas(k);
  sprintf(#m, "[  PATTERN %02d · KIT  ]|%sSend to the panel|%sCopy kit|%sPaste kit here||%sClear kit%s", k + 1, h ? "" : "#", h ? "" : "#", kcfull ? "" : "#", h ? "" : "#", k == curpat ? "" : "  (no undo)");
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m) - 1;
  r == 1 ? ksend(k) : r == 2 ? kcopy(k) : r == 3 ? kpaste(k) : r == 4 ? kclear(k);
);
// ---- generate: Euclid, shift, randomize (one lane, with undo) ----
TMPS = 51100;   // one step's data while shifting
function st2tmp(ix) local(k) (
  TMPS[6 + NPL] = RMP[ix]; TMPS[7 + NPL] = PIT[ix]; TMPS[8 + NPL] = CTG[ix]; TMPS[0] = ON[ix]; TMPS[1] = VEL[ix]; TMPS[2] = SLC[ix]; TMPS[3] = CND[ix]; TMPS[4] = OFS[ix]; TMPS[5] = CHN[ix];
  k = 0; loop(NPL, TMPS[6 + k] = PL[ix * NPL + k]; k += 1;);
);
function tmp2st(ix) local(k) (
  RMP[ix] = TMPS[6 + NPL]; PIT[ix] = TMPS[7 + NPL]; CTG[ix] = TMPS[8 + NPL]; ON[ix] = TMPS[0]; VEL[ix] = TMPS[1]; SLC[ix] = TMPS[2]; CND[ix] = TMPS[3]; OFS[ix] = TMPS[4]; CHN[ix] = TMPS[5];
  k = 0; loop(NPL, PL[ix * NPL + k] = TMPS[6 + k]; k += 1;);
);
function stcopy(dst, src) local(k) (
  RMP[dst] = RMP[src]; PIT[dst] = PIT[src]; CTG[dst] = CTG[src]; ON[dst] = ON[src]; VEL[dst] = VEL[src]; SLC[dst] = SLC[src]; CND[dst] = CND[src]; OFS[dst] = OFS[src]; CHN[dst] = CHN[src];
  k = 0; loop(NPL, PL[dst * NPL + k] = PL[src * NPL + k]; k += 1;);
);
// rotate the lane's steps (with all their values) by one inside its length: d = 1 right/later, -1 left/earlier
function lshift(p, d) local(n, b, i) (
  n = LEN[p]; b = p * NSTEP;
  d > 0 ? (
    st2tmp(b + n - 1); i = n - 1; loop(n - 1, stcopy(b + i, b + i - 1); i -= 1;); tmp2st(b);
  ) : (
    st2tmp(b); i = 0; loop(n - 1, stcopy(b + i, b + i + 1); i += 1;); tmp2st(b + n - 1);
  );
);
// Euclid: k hits spread as evenly as possible over the lane length (first hit on step 1); values of the steps stay
function euclid(p, k) local(n, i, ix) (
  n = LEN[p]; i = 0;
  loop(n, ix = p * NSTEP + i; ON[ix] = ((i * k) % n) < k; i += 1;);
);
// randomize kinds: 1-3 steps 25/50/75 %, 4 velocity, 5 chance, 6 slices, 7 offsets, 8 current p-lock param, 9 mutate
function lrand(p, kind) local(n, i, ix, v, a, b) (
  n = LEN[p]; i = 0;
  kind == 9 ? (
    // mutate: flip two steps, nudge velocities of the lit ones
    loop(2, ix = p * NSTEP + floor(rand(n)); ON[ix] = !ON[ix];);
    loop(n, ix = p * NSTEP + i; ON[ix] ? (VEL[ix] = max(1, min(127, VEL[ix] + floor(rand(21)) - 10));); i += 1;);
  ) : loop(n,
    ix = p * NSTEP + i;
    kind <= 3 ? (ON[ix] = rand(1) < kind * 0.25;)
    : ON[ix] ? (
      kind == 4 ? (VEL[ix] = 40 + floor(rand(88));)
      : kind == 5 ? (v = floor(rand(6)); CHN[ix] = (v < 3 ? 100 : v == 3 ? 75 : v == 4 ? 50 : 25);)
      : kind == 6 ? (rand(1) < 0.25 ? (v = floor(rand(6)); SLC[ix] = (v == 0 ? 1 : v == 1 ? 2 : v == 2 ? 8 : v == 3 ? 15 : v == 4 ? 6 : 7);) : (SLC[ix] = 0;);)
      : kind == 7 ? (OFS[ix] = (floor(rand(5)) - 2) * 5;)
      : kind == 8 ? (
        a = (pnl ? gmem[1000 + pidx(p, plk)] : 64);
        PL[ix * NPL + plk] = max(0, min(127, a + floor(rand(81)) - 40)) + 128 * floor(max(0, PL[ix * NPL + plk]) / 128);
      );
    );
    i += 1;
  );
);

// v0.58.4: the lane menu only touches THIS lane (pattern-wide clears moved to the pattern slot menu)
function lanemenu(p) local(r) (
  sprintf(#m, "[  PART %d  ]|%sUndo / redo  (Ctrl+Z)||Clear extras  (slice, chance, condition, offset, p-locks)|Clear lane  (steps · length, rate, swing stay)|Reset lane  (steps + all lane settings)", p + 1, hasundo ? "" : "#");
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r == 2 && hasundo ? (doundo(); strcpy(#rd, "UNDO / REDO"); msgt = now; bump();)
  : r >= 3 && r <= 5 ? (
    snap(); clearlane(p, r == 3 ? 2 : r == 4 ? 1 : 3);
    sprintf(#rd, "PART %d · %s", p + 1, r == 3 ? "EXTRAS CLEARED · notes stay" : r == 4 ? "LANE CLEARED · length, rate, swing stay" : "LANE RESET");
    msgt = now; bump();
  );
);

// ---- pattern slot menu: copy / paste / clear (the current pattern is first written to its bank slot) ----
function patused(k) local(i, r) (
  k == curpat ? (r = kithas(k); i = 0; loop(NP * NSTEP, ON[i] ? (r = 1;); i += 1;); i = 0; loop(NP, LEN[i] != 16 || RATE[i] != 2 ? (r = 1;); i += 1;); r;)
              : pused(k);
);
// ---- chain ----
function chstr() local(i) (   // the chain as text, the playing entry in brackets
  strcpy(#ch, ""); i = 0;
  loop(chlen, i == chdisp ? sprintf(#cn, "[%d]", CHL[i] + 1) : sprintf(#cn, "%d", CHL[i] + 1); strcat(#ch, #cn); i < chlen - 1 ? strcat(#ch, " "); i += 1;);
  #ch;
);
function chadd(k) (
  chlen < 16 ? (CHL[chlen] = k; chlen += 1; sprintf(#rd, "CHAIN %s", chstr()); bump();) : strcpy(#rd, "CHAIN FULL (16)");
  msgt = now;
);
function chainmenu() local(r) (
  sprintf(#m, "[  CHAIN  ]|%sRemove last entry|%sClear chain  (no undo)", chlen ? "" : "#", chlen ? "" : "#");
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r == 2 ? (chlen -= 1; chlen ? sprintf(#rd, "CHAIN %s", chstr()) : strcpy(#rd, "CHAIN EMPTY"); msgt = now; bump();)
  : r == 3 ? (chlen = 0; strcpy(#rd, "CHAIN CLEARED"); msgt = now; bump(););
);
// v0.58.4: everything that clears the WHOLE pattern lives here (bottom part). Clear extras / clear all steps
// work on the playing pattern only (its lanes are live); RESET works on any slot, undo only for the playing one.
function patmenu(k) local(r, pm_here, i) (
  pm_here = (k == curpat);
  sprintf(#m, "[  PATTERN %02d  ]|Copy pattern|%sPaste pattern here%s|Add to chain  (Shift+click)|%sUse as FILL pattern||%sClear extras, all lanes  (slice, chance, condition, offset, p-locks)|%sClear all steps  (lane settings, accent, kit stay)|Reset pattern  (steps, lane settings, accent, kit)%s",
          k + 1, haspclip ? "" : "#", pm_here ? "" : "  (no undo)", fillp == k ? "!" : "", pm_here ? "" : "#", pm_here ? "" : "#", pm_here ? "" : "  (no undo)");
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r == 4 ? (r = 5;) : r == 5 ? (r = 6;) : r == 8 ? (r = 4;) : (r == 6 || r == 7) ? (
    pm_here ? (
      snap(); i = 0; loop(NP, clearlane(i, r == 6 ? 2 : 1); i += 1;);
      sprintf(#rd, "PATTERN %02d · ALL LANES · %s", curpat + 1, r == 6 ? "EXTRAS CLEARED · notes stay" : "STEPS CLEARED · settings, accent, kit stay");
      msgt = now; bump();
    );
    r = 0;
  );
  // below: 2 copy, 3 paste, 4 reset, 5 add to chain, 6 FILL (old numbering)
  r == 2 ? (
    k == curpat ? psave(curpat);
    memcpy(PCLIP, PB + k * PSZ, PSZ); memcpy(PRCLIP, RMPB + k * 384, 384); memcpy(PPCLIP, PITB + k * 384, 384); memcpy(PCTCLIP, CTGB + k * 384, 384); memcpy(ACCLIP, ACB + k * 80, 80); memcpy(ACPCLIP, ACPB + k * 32, 26); memcpy(KITCLIP, KITB + k * 140, 140); haspclip = 1;
    sprintf(#rd, "PATTERN %02d COPIED", k + 1); msgt = now;
  ) : r == 3 && haspclip ? (
    k == curpat ? (snap(); memcpy(UKIT, KITB + k * 140, 140); ukp = curpat;);
    memcpy(RMPB + k * 384, PRCLIP, 384); memcpy(PITB + k * 384, PPCLIP, 384); memcpy(CTGB + k * 384, PCTCLIP, 384); memcpy(ACB + k * 80, ACCLIP, 80); memcpy(ACPB + k * 32, ACPCLIP, 26); memcpy(KITB + k * 140, KITCLIP, 140);
    k == curpat ? (memcpy(PB + k * PSZ, PCLIP, PSZ); pload(k); hasundo = 1;) : memcpy(PB + k * PSZ, PCLIP, PSZ);
    sprintf(#rd, "PASTED INTO PATTERN %02d", k + 1); msgt = now; bump();
  ) : r == 4 ? (
    k == curpat ? (snap(); memcpy(UKIT, KITB + k * 140, 140); ukp = curpat; pinit(PB + k * PSZ); pload(k); hasundo = 1;) : pinit(PB + k * PSZ);
    sprintf(#rd, "PATTERN %02d RESET · steps, lane settings, accent, kit%s", k + 1, k == curpat ? " · undo = back" : ""); msgt = now; bump();
  ) : r == 5 ? (
    chadd(k);
  ) : r == 6 ? (
    fillp = (fillp == k ? -1 : k);
    fillp >= 0 ? sprintf(#rd, "FILL PATTERN %02d · plays while FILL is on", k + 1) : strcpy(#rd, "NO FILL PATTERN");
    msgt = now; bump();
  );
);
// ---- song row (layout v2): FILL PAT box + 16 chain slots ----
function fpset(k) (
  fillp = k; fillp >= 0 ? sprintf(#rd, "FILL PATTERN %02d · plays while FILL is on", k + 1) : strcpy(#rd, "NO FILL PATTERN");
  msgt = now; bump();
);
function fpmenu() local(r, i) (
  strcpy(#m, "[  FILL PATTERN  ]|"); fillp < 0 ? strcat(#m, "!"); strcat(#m, "None||"); i = 0;
  loop(NPAT, i == fillp ? strcat(#m, "!"); sprintf(#n, "Pattern %02d", i + 1); strcat(#m, #n); i < NPAT - 1 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m) - 1;
  r == 1 ? fpset(-1) : r > 1 ? fpset(r - 2);
);
function chdel(k) local(i) (
  i = k; loop(chlen - k - 1, CHL[i] = CHL[i + 1]; i += 1;); chlen -= 1;
  chlen ? sprintf(#rd, "CHAIN %s", chstr()) : strcpy(#rd, "CHAIN EMPTY"); msgt = now; bump();
);
// slot k < chlen: pick another pattern or remove the entry · slot k == chlen ("+"): append a pattern
function chslotmenu(k) local(r, i) (
  // v0.58.4: left- and right-click open this menu; "Remove this entry" sits at the bottom
  k < chlen ? sprintf(#m, "[  CHAIN ENTRY %d  ]|", k + 1) : strcpy(#m, "[  ADD TO CHAIN  ]|");
  i = 0; loop(NPAT, k < chlen && CHL[k] == i ? strcat(#m, "!"); sprintf(#n, "Pattern %02d", i + 1); strcat(#m, #n); i < NPAT - 1 ? strcat(#m, "|"); i += 1;);
  k < chlen ? strcat(#m, "||Remove this entry");
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m) - 1;
  k < chlen ? (
    r == NPAT + 1 ? chdel(k) : r > 0 && r <= NPAT ? (CHL[k] = r - 1; sprintf(#rd, "CHAIN %s", chstr()); msgt = now; bump(););
  ) : r > 0 ? chadd(r - 1);
);

now = time_precise();
curpat != lastcp ? (hasundo = 0; lastcp = curpat;);   // undo belongs to one pattern

// ---- layout v2 (2026-11-05). Classic: design 1200 x 800. Sleeve: same grid, design 1200 x 900 (bigger header,
// numbers and value columns). Hit tests only use these variables, so both looks click the same way.
sc = max(0.5, min(gfx_w / 1200, gfx_h / 800));
!skin ? (
  MG = S(12); GAP = S(8); HDY = MG; HDH = S(72); TW = S(330);   // v0.31: 270 -> 330 for the PIT box
  SWW = S(72); SWX = gfx_w - MG - SWW; SWH = HDH;   // global SWING box
  CHW = S(72); CHX = SWX - S(8) - CHW;   // CHAOS box, left of SWING
  DNW = S(72); DNX = CHX - S(8) - DNW;   // v0.53 DENSITY box, left of CHAOS
  HGL = S(14);   // v0.45 layout B: small group labels TRANSPORT · PATTERN · FEEL above the header controls
  HBW = S(96); HBGW = 3 * HBW + S(8) + S(14); HBX = DNX - S(14) - HBGW; HBH = floor((HDH - HGL - S(6)) / 2);
  HB2X = HBX + HBW + S(8); HB3X = HB2X + HBW + S(14); HBY1 = HDY + HGL; HBY2 = HBY1 + HBH + S(6);
  SWY = HDY + HGL; SWH = HDH - HGL;
  RDX = MG + TW + S(10); RDW = HBX - S(10) - RDX;
  PTY = MG + HDH + GAP; PTH = S(26);    // pattern row
  SOY = PTY + PTH + GAP; SOH = S(26);   // song row: CHAIN, CLEAR, FILL PAT + chain slots
  PGY = SOY + SOH + GAP; PGH = S(24); PBW = S(40);
  RCX = MG + S(252); RCW = TW - S(252); RRW = S(42);   // v0.42: tap record button (REC + CAL)
  TBY = PGY + PGH + GAP; TBH = S(26); TABW = S(88); NTAB = 7;
  LY = TBY + TBH + GAP; LGAP = S(6);
  EDH = S(128); EY = gfx_h - MG - EDH;
  ACH = S(46); LH = floor((EY - GAP - LY - 6 * LGAP - ACH) / 6); ACY = LY + 6 * (LH + LGAP);   // v0.39: ACCENT row under the lanes
  OVH = S(5); CY0 = OVH + S(3);
  LSX = MG + S(8); R1H = S(20); R2H = S(18); L1OFF = S(5); L2OFF = LH - S(5) - R2H;
  AY1 = ACY + S(3); AY2 = ACY + ACH - S(3) - R2H; AKX0 = LSX + S(50); AKW = S(22); APX = LSX + S(208); APW = S(66); AMX = LSX + S(278); AMW = S(40);
  LENX = LSX + S(100); LENW = S(38); RATX = LSX + S(178); RATW = S(76);   // column grid: LEN over SWG, RATE over HUM
  DIRX = LSX; DIRW = S(24); SWGX = LSX + S(100); SWGW = S(38); HTX = LSX + S(178); HTW = S(36); HVX = LSX + S(218); HVW = S(36);
  PITX = LSX + S(284); PITW = S(30);   // lane pitch box (row 2, after HUM)
  BTH = S(30); BCX = MG; BCY = EY + BTH; BCW = gfx_w - 2 * MG;   // v0.45 layout B: tab bar + full-width content
  MBX = MG; MBY = EY; MBH = BTH; MBW = S(140); MBG = 0; NMB = 7;   // STEP GEN TOOLS BEAT FEEL ROUTE
  MUTX = LSX + S(256); SOLX = LSX + S(284); MSBW = S(24); SOLW = S(30);   // M over the PIT label, S over the PIT box
  THH = S(16); THY = MG + S(8); THW = THH; THX = MG + TW - THW; LKW = THH; LKX = THX - S(6) - LKW;   // LOOK + COLOR = two small icons in the title block (v0.34)
) : (
  MG = S(12); GAP = S(6); HDY = 0; HDH = S(100); TW = S(330); TTW = S(200);   // v0.46: TW 270 -> 330 (PIT, M / S like Classic)
  HGL = S(18);   // group labels TRANSPORT · PATTERN · FEEL above the header controls
  SWW = S(84); SWX = gfx_w - SWW; CHW = S(84); CHX = SWX - CHW;   // CHAOS left of SWING
  DNW = S(84); DNX = CHX - DNW;   // v0.53 DENSITY left of CHAOS
  SWY = HDY + HGL; SWH = HDH - HGL;
  HBW = S(130); HBGW = 3 * HBW + S(10); HBX = DNX - S(10) - HBGW; HBH = floor((HDH - HGL) / 2);
  HB2X = HBX + HBW; HB3X = HB2X + HBW + S(10); HBY1 = HDY + HGL; HBY2 = HBY1 + HBH;
  RDX = TTW; RDW = HBX - S(10) - RDX;
  PTY = HDH + S(6) + S(8); PTH = S(28);
  SOY = PTY + PTH + GAP; SOH = S(28);
  PGY = SOY + SOH + GAP; PGH = S(34); PBW = S(32);
  RCX = MG + S(252); RCW = TW - S(252); RRW = S(42);   // tap record (REC + CAL)
  TBY = PGY + PGH + GAP; TBH = S(28); TABW = S(86); NTAB = 7;
  LY = TBY + TBH + S(14); LGAP = S(12);   // a 2 px line sits 8 px above every lane
  BTH = S(34); EDH = S(118); EY = gfx_h - EDH; BCX = MG; BCY = EY + BTH; BCW = gfx_w - 2 * MG;   // layout B bottom strip
  ACH = S(44); LH = floor((EY - S(6) - S(12) - LY - 6 * LGAP - ACH) / 6); ACY = LY + 6 * (LH + LGAP);   // ACCENT row under the lanes
  OVH = S(4); CY0 = OVH + S(4);
  NUMW = S(66); LSX = MG; KX = LSX + NUMW + S(8); R1H = S(20); R2H = S(20);
  L1OFF = floor(LH / 2) - R1H; L2OFF = floor(LH / 2) + S(2);
  LENX = KX + S(62); LENW = S(24); RATX = KX + S(126); RATW = S(52);
  DIRX = KX; DIRW = S(18); SWGX = KX + S(52); SWGW = S(34); HTX = KX + S(124); HTW = S(32); HVX = KX + S(160); HVW = S(32);
  MUTX = KX + S(196); MSBW = S(24); SOLX = KX + S(226); SOLW = S(28);   // row 1: M over the PIT label, S over the PIT box
  PITX = KX + S(226); PITW = S(28);   // row 2
  AY1 = ACY + S(2); AY2 = ACY + ACH - S(2) - R2H; AKX0 = LSX + S(56); AKW = S(22); APX = LSX + S(214); APW = S(66); AMX = LSX + S(286); AMW = S(40);
  MBX = MG; MBY = EY + S(3); MBH = S(27); MBW = S(140); MBG = S(6); NMB = 7;   // STEP GEN TOOLS BEAT FEEL ROUTE
  THH = S(20); THW = S(20); LKW = S(20); THY = HDY + S(10); THX = TTW - S(12) - THW; LKX = THX - S(6) - LKW;   // LOOK + COLOR icons in the title block
);
GX = MG + TW + S(10); GW = gfx_w - GX - MG;
GG = S(10); CG = S(4);
CW = (GW - 3 * GG - 12 * CG) / 16;
CH = LH - CY0;
// v0.58.6 P-LOCK group: P-LOCK tab (the LAST visual tab) + PARAM field + VALUE/RANGE switch, joined and framed as one unit,
// hint text after it. PARX/PARW = also the hint area of the other tabs.
PARX = GX + NTAB * (TABW + S(6)) - S(6); PARW = GW - NTAB * (TABW + S(6)) + S(6);
PLGX = GX + (NTAB - 1) * (TABW + S(6)); PLPW = TABW + S(24); RNGW = S(128); RNGX = PARX + PLPW;
PHX = RNGX + RNGW + S(18); PHW = PARX + PARW - PHX;
// bottom strip: STEP fields (Classic = boxes, Sleeve = 9 columns with big numbers)
!skin ? (
  FW = floor((BCW - S(20) - 8 * S(8)) / 9); FX0 = BCX + S(10); FSTEP = FW + S(8);   // SELECTED + 8 fields
  FBY = BCY + S(26); FBH = S(30);
) : (
  COLW = floor(BCW / 9); FX0 = BCX + S(12); FSTEP = COLW; FW = COLW - S(24);
  FBY = BCY + S(22); FBH = S(38);
);
// FEEL tab = GROOVE (focused lane), ROUTE tab = DUCK; off-tab = out of reach for the hit tests
GRH = FBH; GRX = BCX + S(10); GRW = S(170); GAX = GRX + GRW + S(8); GAW = S(110); GRY = (smode == 4 ? FBY : -1000);
DKH = FBH; DKX0 = BCX + S(10); DKW = S(48); DKY = (smode == 5 ? FBY : -1000);
BLY = BCY + (skin ? S(2) : S(4));
TGH = (skin ? S(22) : S(20)); TGY = (smode == 0 ? BCY + (skin ? S(57) : S(62)) : -1000);   // v0.58.5: STEP tab TRIGLESS button under SELECTED (was a TOOLS button)
// FEEL tab: EVOLVE section right of GROOVE
EVX = GAX + GAW + S(30); EVW1 = S(96); EVX2 = EVX + EVW1 + S(8); EVW2 = S(56); EVPX = EVX2 + EVW2 + S(16); EVPW = S(30);
EVY = (smode == 4 ? FBY : -1000); EVH = FBH; AFX = EVPX + 6 * (EVPW + S(4)) + S(30); AFW = S(96);   // + AUTO FILL (v0.51)   // section labels in the bottom strip (Sleeve font is taller: higher up)
G_HX = BCX + S(10); G_RX = -10000; G_SLX = BCX + S(90); G_SRX = BCX + S(130); G_WX = BCX + S(190);   // v0.60: ROT gone (shift moves the Euclid start)
G_AX = BCX + S(310); G_SCX = BCX + S(390); G_ROX = BCX + S(470); G_MUX = BCX + S(560);
ffree = slider1 >= 0.5;

// ---- mouse ----
lb = mouse_cap & 1; rb = mouse_cap & 2; shift = mouse_cap & 8; alt = mouse_cap & 16;
press = lb && !plb; rpress = rb && !prb;
// hreg: 1 part strip, 2 length strip, 3 step cell, 4 rate box, 5 len box, 6/7 humanize time/vel, 8 global swing,
// 9 lane swing, 10 direction, 11-17 edit fields (17 = pitch), 19 lane pitch box, 61-69 GEN, 70-81 TOOLS
hp = -1; hreg = 0; hk = -1;
p = 0;
loop(NP,
  y0 = laney(p);
  mouse_y >= y0 && mouse_y < y0 + LH ? (
    hp = p;
    mouse_x >= MG && mouse_x < MG + TW ? (
      hreg = (inr(RATX, lrow1(p), RATW, R1H) ? 4 : inr(LENX, lrow1(p), LENW, R1H) ? 5 : inr(DIRX, lrow2(p), DIRW, R2H) ? 10
            : inr(SWGX, lrow2(p), SWGW, R2H) ? 9 : inr(HTX, lrow2(p), HTW, R2H) ? 6 : inr(HVX, lrow2(p), HVW, R2H) ? 7 : inr(PITX, lrow2(p), PITW, R2H) ? 19 : inr(MUTX, lrow1(p), MSBW, R1H) ? 21 : inr(SOLX, lrow1(p), SOLW, R1H) ? 22 : 1);
    ) : mouse_x >= GX && mouse_x < GX + GW ? (
      mouse_y < y0 + OVH + S(3) ? (hreg = 2;) : mouse_y >= y0 + CY0 ? (
        k = 0; loop(16, mouse_x >= cellx(k) && mouse_x < cellx(k) + CW ? (hreg = 3; hk = k;); k += 1;);
      );
    );
  );
  p += 1;
);
inr(SWX, SWY, SWW, SWH) ? (hreg = 8;);
inr(CHX, SWY, CHW, SWH) ? (hreg = 25;);
inr(DNX, SWY, DNW, SWH) ? (hreg = 31;);   // DENSITY
// humanize + swing boxes sit in every lane now: they work on the lane under the mouse
(hreg == 6 || hreg == 7 || hreg == 9) && (press || rpress || mouse_wheel != 0) ? (focus = hp;);
// TOOLS button rectangle -> T_X T_Y T_W T_H. Groups: selected steps (0 1 2 6 5), lane (3 7 8), all lanes (9 10), undo (4)
function kitr() (   // v0.52: NEW SESSION (TOOLS) where the kit was; KIT tab: GRAB/CLEAR, COPY/PASTE, SEND, overview
  KTX = BCX + S(846); KTH = S(26); KTY0 = BCY + S(22); KTY1 = BCY + S(54); NSX = KTX; NSW = S(116);
  KGX = BCX + S(10); KBW = S(110); KCX = KGX + S(120); KSX = KCX + S(120); KOX = KSX + S(150); KOW = S(34); KOG = S(4);
);   // PATTERN KIT buttons (TOOLS)
function toolr(i) local(c, r) (
  kitr();
  T_W = S(106); T_H = S(26);
  // v0.58.5 grid: top row keeps, bottom row removes, CLEAR above RESET. STEPS c0-2: COPY PASTE SELECT / LOCKS EXTRAS DELETE
  // LANE c3: CLEAR / RESET · PATTERN c4: CLEAR / RESET · UNDO centered between PATTERN and SESSION (TRIGLESS moved to the STEP tab)
  i == 4 ? (T_X = BCX + S(674); T_Y = BCY + S(22); T_W = S(98); T_H = S(58);) : (
    c = (i == 0 || i == 5 ? 0 : i == 1 || i == 6 ? 1 : i == 2 || i == 3 ? 2 : i == 7 || i == 8 ? 3 : 4);
    r = (i == 5 || i == 6 || i == 2 || i == 8 || i == 10 ? 1 : 0);
    T_X = BCX + S(10) + c * S(112) + (c >= 3 ? S(18) : 0) + (c >= 4 ? S(18) : 0);
    T_Y = BCY + S(22) + r * S(32);
  );
);
smt = -1; i = 0; loop(NMB, inr(MBX + i * (MBW + MBG), MBY, MBW, MBH) ? (smt = mbat(i);); i += 1;);
smode == 3 ? (
  inr(BCX + S(10), FBY, S(170), FBH) ? (hreg = 84;) : inr(BCX + S(190), FBY, S(80), FBH) ? (hreg = 85;)
  : inr(BCX + S(280), FBY, S(80), FBH) ? (hreg = 86;) : inr(BCX + S(380), FBY, S(170), FBH) ? (hreg = 87;);
);
inr(GRX, GRY, GRW, GRH) ? (hreg = 23;) : inr(GAX, GRY, GAW, GRH) ? (hreg = 24;);   // GROOVE template / amount
dkc = -1; i = 0; loop(6, inr(DKX0 + i * (DKW + S(4)), DKY, DKW, DKH) ? (dkc = i; hreg = 26;); i += 1;);   // DUCK buttons
evpc = -1; inr(EVX, EVY, EVW1, EVH) ? (hreg = 27;) : inr(EVX2, EVY, EVW2, EVH) ? (hreg = 28;)
  : (i = 0; loop(6, inr(EVPX + i * (EVPW + S(4)), EVY, EVPW, EVH) ? (evpc = i; hreg = 29;); i += 1;););   // EVOLVE
inr(AFX, EVY, AFW, EVH) ? (hreg = 30;);   // AUTO FILL
// ACCENT row: 90 cell (hk), 91 LEN, 92 RATE, 93 AMT, 94 part button (akc)
akc = -1;
ACH > 0 && mouse_y >= ACY && mouse_y < ACY + ACH ? (
  mouse_x >= GX && mouse_x < GX + GW ? (
    mouse_y < ACY + OVH + S(3) ? (hreg = 96;) : mouse_y >= ACY + CY0 ? (
      k = 0; loop(16, mouse_x >= cellx(k) && mouse_x < cellx(k) + CW ? (hreg = 90; hk = k;); k += 1;);
    );
  ) : inr(LENX, AY1, LENW, R1H) ? (hreg = 91;) : inr(RATX, AY1, RATW, R1H) ? (hreg = 92;) : inr(AMX, AY2, AMW, R2H) ? (hreg = 93;) : inr(APX, AY2, APW, R2H) ? (hreg = 95;)
  : (i = 0; loop(6, inr(AKX0 + i * (AKW + S(4)), AY2, AKW, R2H) ? (akc = i; hreg = 94;); i += 1;););
);
smode == 0 ? (f = 1; loop(8, inr(fldx(fldpos(f)), FBY, FW, FBH) ? (hreg = 10 + f;); f += 1;); inr(fldx(0), TGY, FW, TGH) ? (hreg = 81;););   // 81 = TRIGLESS (toolpress 11)
smode == 1 ? (
  inr(G_HX, FBY, S(70), FBH) ? (hreg = 61;) : inr(G_RX, FBY, S(70), FBH) ? (hreg = 62;) : inr(G_SLX, FBY, S(36), FBH) ? (hreg = 63;)
  : inr(G_SRX, FBY, S(36), FBH) ? (hreg = 64;) : inr(G_WX, FBY, S(110), FBH) ? (hreg = 65;) : inr(G_AX, FBY, S(70), FBH) ? (hreg = 66;)
  : inr(G_SCX, FBY, S(70), FBH) ? (hreg = 67;) : inr(G_ROX, FBY, S(80), FBH) ? (hreg = 68;) : inr(G_MUX, FBY, S(90), FBH) ? (hreg = 69;);
);
smode == 2 ? (i = 0; loop(11, toolr(i); inr(T_X, T_Y, T_W, T_H) ? (hreg = 70 + i;); i += 1;);
  inr(NSX, KTY0, NSW, KTH) ? (hreg = 99;););
kslot = -1;
smode == 6 ? (kitr();
  inr(KGX, KTY0, KBW, KTH) ? (hreg = 97;) : inr(KGX, KTY1, KBW, KTH) ? (hreg = 98;) : inr(KCX, KTY0, KBW, KTH) ? (hreg = 101;)
  : inr(KCX, KTY1, KBW, KTH) ? (hreg = 102;) : inr(KSX, KTY0, KBW, KTH) ? (hreg = 103;)
  : (i = 0; loop(NPAT, inr(KOX + i * (KOW + KOG), KTY0, KOW, KTH) ? (kslot = i; hreg = 100;); i += 1;););
);
anypit = 0; i = 0; loop(NP, PON[i] ? (anypit = 1;); i += 1;);   // PITCH tab only active when a lane has PIT on
!anypit && tab == 6 ? (tab = 0;);
tabhit = -1; i = 0; loop(NTAB, inr(GX + i * (TABW + S(6)), TBY, TABW, TBH) ? (tabhit = tabat(i);); i += 1;);
pathit = -1; k = 0; loop(NPAT, inr(cellx(k), PTY, CW, PTH) ? (pathit = k;); k += 1;);
// song row
SGCW = S(70); SGRX = MG + S(76); SGRW = S(84); SGLX = MG + S(166); SGLW = S(58); SGFX = MG + S(230);   // song row (v0.49)
chit = inr(MG, SOY, SGCW, SOH); rghit = inr(SGRX, SOY, SGRW, SOH); clrhit = inr(SGLX, SOY, SGLW, SOH); fphit = inr(SGFX, SOY, MG + TW - SGFX, SOH);
chslot = -1; k = 0; loop(16, inr(cellx(k), SOY, CW, SOH) ? (chslot = k;); k += 1;);
thhit = inr(THX, THY, THW, THH); lkhit = inr(LKX, THY, LKW, THH);

// ---- copy / paste / delete / select lane (keys + right-click step menu) ----
function docopy() local(i, c, cp0, cs0, k) (
  // positions relative to the top-left selected step
  nsel < 1 ? seladd(selp, sels);
  cp0 = NP; cs0 = NSTEP; i = 0;
  loop(NP * NSTEP, SELM[i] ? (cp0 = min(cp0, floor(i / NSTEP)); cs0 = min(cs0, i % NSTEP);); i += 1;);
  clipn = 0; i = 0;
  loop(NP * NSTEP,
    SELM[i] ? (
      c = CLIP + clipn * CLW;
      c[0] = floor(i / NSTEP) - cp0; c[1] = i % NSTEP - cs0; c[2] = ON[i]; c[3] = VEL[i]; c[4] = SLC[i]; c[5] = CND[i]; c[6] = OFS[i]; c[7] = CHN[i]; c[8 + NPL] = RMP[i]; c[9 + NPL] = PIT[i]; c[10 + NPL] = CTG[i]; k = 0; loop(NPL, c[8 + k] = PL[i * NPL + k]; k += 1;);
      clipn += 1;
    );
    i += 1;
  );
  sprintf(#rd, "%d STEPS COPIED", clipn); msgt = now;
);
function dopaste() local(i, c, pp, ps, tp, ts, ix, k) (
  // top-left of the copy lands on the main selected step
  clipn > 0 ? (
    snap(); pp = selp; ps = sels; selclear(); i = 0;
    loop(clipn,
      c = CLIP + i * CLW; tp = pp + c[0]; ts = ps + c[1];
      tp < NP && ts < NSTEP ? (
        ix = tp * NSTEP + ts; ON[ix] = c[2]; VEL[ix] = c[3]; SLC[ix] = c[4]; CND[ix] = c[5]; OFS[ix] = c[6]; CHN[ix] = c[7]; RMP[ix] = c[8 + NPL]; PIT[ix] = c[9 + NPL]; CTG[ix] = c[10 + NPL]; k = 0; loop(NPL, PL[ix * NPL + k] = c[8 + k]; k += 1;);
        seladd(tp, ts);
      );
      i += 1;
    );
    selp = pp; sels = ps;
    sprintf(#rd, "%d STEPS PASTED", clipn); msgt = now; bump();
  ) : (strcpy(#rd, "NOTHING COPIED YET"); msgt = now;);
);
function dodelete() (
  nsel < 1 ? (strcpy(#rd, "NOTHING SELECTED · click a step first"); msgt = now;)
           : (snap(); clrsel(1); sprintf(#rd, "%d STEPS DELETED", nsel); msgt = now; bump(););
);
function doselane() local(s) (
  selclear(); s = 0; loop(LEN[focus], seladd(focus, s); s += 1;); selp = focus; sels = 0;
  sprintf(#rd, "PART %d · ALL %d STEPS SELECTED", focus + 1, LEN[focus]); msgt = now;
);
function doundokey() ( hasundo ? (doundo(); strcpy(#rd, "UNDO / REDO"); msgt = now; bump();) : (strcpy(#rd, "NOTHING TO UNDO"); msgt = now;); );

// ---- bottom strip GEN / TOOLS (2026-11-05) ----
EUH = 51200; EUR = 51210;   // Euclid hits / rotation per lane (GUI state)
function euapply(p) local(n, k, r, i, j) (
  n = LEN[p]; k = min(EUH[p], n); r = EUR[p] % n; i = 0;
  loop(n, j = (i - r + n) % n; ON[p * NSTEP + i] = (k > 0 && ((j * k) % n) < k); i += 1;);
);
function msgeu() ( sprintf(#rd, "PART %d · EUCLID %d / %d", focus + 1, EUH[focus], LEN[focus]); msgt = now; );
function wname(i) ( i == 0 ? "STEPS" : i == 1 ? "VELOCITY" : i == 2 ? "CHANCE" : i == 3 ? "SLICE" : i == 4 ? "OFFSET" : i == 6 ? "PITCH" : i == 7 ? "STEPS WILD" : "P-LOCK"; );
// v0.60 (port from Drum Seq v0.4) role-guided STEPS: the part number is the role (BEAT generator roles: 1 kick, 2 snare,
// 3 closed hat, 4 open hat, 5 perc, 6 clap/FX). Hits per 16 steps rlo..rhi (AMOUNT picks inside), rwt = favorite spots.
// STEPS WILD = pure random (density = AMOUNT).
RKEY = 420000;   // 64 keys
function rlo(r) ( r == 0 ? 2 : r == 1 || r == 5 ? 1 : r == 2 ? 4 : r == 3 ? 1 : 2; );
function rhi(r) ( r == 0 ? 6 : r == 1 || r == 5 ? 4 : r == 2 ? 12 : r == 3 ? 4 : 8; );
function rwt(r, i) local(q) (
  q = i % 4;
  r == 0 ? (i == 0 ? 30 : q == 0 ? 10 : q == 3 ? 2.5 : q == 2 ? 1.5 : 0.7)      // KICK: downbeats, a push before them
  : r == 1 || r == 5 ? (i == 4 || i == 12 ? 20 : i % 2 ? 1.2 : 0.6)            // SNARE / CLAP: 2 + 4, ghosts
  : r == 2 ? (q == 2 ? 8 : q == 0 ? 6 : 1.5)                                    // CL HAT: 8ths, 16ths when busy
  : r == 3 ? (q == 2 ? 10 : 0.6)                                                // OP HAT: offbeat 8ths
  : (i % 2 ? 3 : q == 2 ? 2 : 0.8);                                             // PERC: off the grid lines
);
// weighted pick without repeats: key = rand ^ (1 / weight), the k highest keys win
function lguide(p, a) local(n, k, i, b, bi, ix) (
  n = LEN[p];
  k = min(n, floor((rlo(p) + (rhi(p) - rlo(p)) * a) * n / 16 + rand(1)));
  i = 0; loop(n, RKEY[i] = rand(1) ^ (1 / rwt(p, i % 16)); ON[p * NSTEP + i] = 0; i += 1;);
  loop(k,
    b = -1; bi = -1; i = 0; loop(n, RKEY[i] > b ? (b = RKEY[i]; bi = i;); i += 1;);
    bi >= 0 ? (ix = p * NSTEP + bi; ON[ix] = 1; VEL[ix] < 1 ? (VEL[ix] = DEFVEL;); RKEY[bi] = -2;);
  );
);
// randomize one lane: what 0 steps, 1 velocity, 2 chance, 3 slice, 4 offset, 5 p-lock (PARAM of the P-LOCK tab); a = amount 0-1
function lrand2(p, what, a) local(n, i, ix, v, b) (
  n = LEN[p]; i = 0;
  what == 0 ? (lguide(p, a); n = 0;);   // v0.60 role-guided (n = 0 skips the loop)
  loop(n,
    ix = p * NSTEP + i;
    what == 0 || what == 7 ? (ON[ix] = rand(1) < a;)
    : ON[ix] ? (
      what == 1 ? (VEL[ix] = max(1, min(127, floor(VEL[ix] + (40 + rand(88) - VEL[ix]) * a)));)
      : what == 2 ? (rand(1) < a ? (v = floor(rand(3)); CHN[ix] = (v == 0 ? 75 : v == 1 ? 50 : 25);) : (CHN[ix] = 100;);)
      : what == 3 ? (rand(1) < a * 0.5 ? (v = floor(rand(6)); SLC[ix] = (v == 0 ? 1 : v == 1 ? 2 : v == 2 ? 8 : v == 3 ? 15 : v == 4 ? 6 : 7);) : (SLC[ix] = 0;);)
      : what == 4 ? (OFS[ix] = floor((rand(2) - 1) * a * 4 + 0.5) * 5;)
      : what == 6 ? (PIT[ix] = max(-24, min(24, floor((rand(2) - 1) * 12 * a + 0.5)));)   // amount 100 % = +/- one octave
      : (b = (pnl ? gmem[1000 + pidx(p, plk)] : 64); PL[ix * NPL + plk] = max(0, min(127, floor(b + (rand(2) - 1) * 60 * a))) + 128 * floor(max(0, PL[ix * NPL + plk]) / 128);); 
    );
    i += 1;
  );
);
// GEN scope (v0.60, port from Drum Seq v0.4): rall 0 = focused part, n = parts 1-n; click = part <-> last range, right-click = list
function scname() ( rall == 0 ? sprintf(#scn, "PART %d", focus + 1) : rall >= NP ? strcpy(#scn, "ALL PARTS") : sprintf(#scn, "PARTS 1-%d", rall); #scn; );
function msgscope() ( sprintf(#rd, "SCOPE · %s", scname()); msgt = now; );
function scopemenu() local(r, i) (
  strcpy(#m, rall == 0 ? "!FOCUSED PART||" : "FOCUSED PART||"); i = 1;
  loop(NP, i == rall ? strcat(#m, "!"); i == 1 ? strcpy(#n, "PART 1") : i == NP ? strcpy(#n, "ALL 6 PARTS") : sprintf(#n, "PARTS 1-%d", i); strcat(#m, #n); i < NP ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m);
  r == 1 ? (rall = 0; msgscope();) : r > 1 ? (rall = r - 1; rlast = rall; msgscope(););
);
function genpress(h) local(i) (
  h == 61 || h == 62 ? (snap(); drag = h; dsy = mouse_y; dsv = (h == 61 ? EUH[focus] : EUR[focus]);)
  : h == 63 || h == 64 ? (snap(); lshift(focus, h == 63 ? -1 : 1); EUR[focus] = (EUR[focus] + (h == 63 ? -1 : 1) + LEN[focus]) % max(1, LEN[focus]); sprintf(#rd, "PART %d · SHIFTED %s", focus + 1, h == 63 ? "LEFT" : "RIGHT"); msgt = now; bump();)
  : h == 65 ? (rwhat = (rwhat + 1) % 8; sprintf(#rd, "RANDOMIZE · %s", wname(rwhat)); msgt = now;)
  : h == 66 ? (drag = 66; dsy = mouse_y; dsv = ramt;)
  : h == 67 ? (rall = (rall ? 0 : rlast); msgscope();)
  : h == 68 ? (
    snap(); rall ? (i = 0; loop(rall, lrand2(i, rwhat, ramt / 100); i += 1;);) : lrand2(focus, rwhat, ramt / 100);
    sprintf(#rd, "%s · %s %d%% ROLLED", scname(), wname(rwhat), ramt); msgt = now; bump();
  ) : h == 69 ? (
    snap(); rall ? (i = 0; loop(rall, lrand(i, 9); i += 1;);) : lrand(focus, 9);
    sprintf(#rd, "%s · MUTATED", scname()); msgt = now; bump();
  );
);
function gendrag() local(v) (
  drag == 66 ? (
    v = max(0, min(100, floor((dsv + (dsy - mouse_y) / S(3)) / 5 + 0.5) * 5)); ramt = v;
    sprintf(#rd, "%s %d%%", rwhat == 0 || rwhat == 7 ? "DENSITY" : "AMOUNT", v); msgt = now;
  ) : (
    v = (drag == 61 ? max(0, min(LEN[focus], dsv + floor((dsy - mouse_y) / S(8) + 0.5)))
                    : max(0, min(LEN[focus] - 1, dsv + floor((dsy - mouse_y) / S(8) + 0.5))));
    v != (drag == 61 ? EUH[focus] : EUR[focus]) ? (
      drag == 61 ? (EUH[focus] = v;) : (EUR[focus] = v;);
      euapply(focus); edited = 1; msgeu();
    );
  );
);
function genwheel(n) (
  hreg == 61 || hreg == 62 ? (
    snap(); hreg == 61 ? (EUH[focus] = max(0, min(LEN[focus], EUH[focus] + n));) : (EUR[focus] = (EUR[focus] + n + LEN[focus]) % LEN[focus];);
    euapply(focus); msgeu(); bump();
  ) : hreg == 65 ? (rwhat = (rwhat + n + 8) % 8; sprintf(#rd, "RANDOMIZE · %s", wname(rwhat)); msgt = now;)
  : hreg == 66 ? (ramt = max(0, min(100, ramt + n * 5)); sprintf(#rd, "AMOUNT %d%%", ramt); msgt = now;);
);
function whatmenu() local(r, i) (
  strcpy(#m, ""); i = 0; loop(8, i == rwhat ? strcat(#m, "!"); strcat(#m, i == 5 ? "P-LOCK  (param of the P-LOCK tab)" : i == 0 ? "STEPS  (guided by the part: kick, snare, hats ...)" : i == 7 ? "STEPS WILD  (pure random)" : wname(i)); i < 7 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m); r > 0 ? (rwhat = r - 1;);
);
function tname(i) ( i == 0 ? "COPY" : i == 1 ? "PASTE" : i == 2 ? "DELETE" : i == 3 ? (nsel > 0 ? "SELECT NONE" : "SELECT LANE") : i == 4 ? "UNDO / REDO" : i == 5 ? "REMOVE LOCKS" :
                    i == 6 ? "CLEAR EXTRAS" : i == 7 ? "CLEAR LANE" : i == 8 ? "RESET LANE" : i == 9 ? "CLEAR PATTERN" : i == 11 ? "TRIGLESS" : "RESET PATTERN"; );
function toolpress(i) local(j, k) (
  i == 0 ? docopy() : i == 1 ? dopaste() : i == 2 ? dodelete() : i == 3 ? (nsel > 0 ? (selclear(); strcpy(#rd, "SELECTION CLEARED"); msgt = now;) : doselane()) : i == 4 ? doundokey()
  : i == 5 ? (snap(); nsel < 1 ? seladd(selp, sels); j = 0; loop(NP * NSTEP, SELM[j] ? (k = 0; loop(NPL, PL[j * NPL + k] = -1; k += 1;);); j += 1;); strcpy(#rd, "SELECTED STEPS · P-LOCKS REMOVED"); msgt = now; bump();)
  : i == 6 ? (snap(); clrsel(0); strcpy(#rd, "SELECTED STEPS · EXTRAS CLEARED · notes stay"); msgt = now; bump();)
  : i == 7 || i == 8 ? (snap(); clearlane(focus, i == 7 ? 1 : 3); sprintf(#rd, "PART %d · %s", focus + 1, i == 7 ? "LANE CLEARED · length, rate, swing stay" : "LANE RESET"); msgt = now; bump();)
  : i == 9 ? (snap(); j = 0; loop(NP, clearlane(j, 1); j += 1;); sprintf(#rd, "PATTERN %02d · ALL LANES CLEARED · settings, accent, kit stay", curpat + 1); msgt = now; bump();)
  : i == 10 ? (resetpat(); sprintf(#rd, "PATTERN %02d RESET · lanes, accent, kit · undo = back", curpat + 1); msgt = now; bump();)
  : i == 11 ? dotrigless();
);

ctrl = mouse_cap & 4;
// ---- BEAT generator ----
function gsname(st) ( GSN[st]; );   // v0.59: names in the style table (@init)
// v0.59: menu slot of a style (wheel steps through the menu order)
function gslot(st) local(i, r) ( r = 0; i = 0; loop(NSTY, GORD[i] == st ? (r = i;); i += 1;); r; );
// hit probability for style st, role ro (0 kick, 1 snare, 2 closed hat, 3 open hat, 4 perc, 5 clap/fx), 16th position i, intensity it 0-1
function gprob(st, ro, i, it) local(b4, o8, od) (
  b4 = (i % 4) == 0; o8 = (i % 4) == 2; od = i % 2;
  st == 0 ? (   // EBM: four on the floor, backbeat, driving 16th perc
    ro == 0 ? (b4 ? 1 : i == 14 || i == 15 ? 0.1 + 0.3 * it : 0.02 * it)
    : ro == 1 ? (i == 4 || i == 12 ? 1 : od ? 0.08 * it : 0)
    : ro == 2 ? (od ? 0.35 + 0.6 * it : 1)
    : ro == 3 ? (o8 ? 0.55 + 0.3 * it : 0)
    : ro == 4 ? (od ? 0.3 + 0.5 * it : o8 ? 0.2 * it : 0)
    : (i == 4 || i == 12 ? 0.6 : i == 15 ? 0.3 * it : 0)
  ) : st == 1 ? (   // AGGROTECH: half-time snare on 3, syncopated kick, busy hats
    ro == 0 ? (i == 0 ? 1 : i == 6 ? 0.7 : i == 10 ? 0.6 : i == 14 ? 0.3 + 0.3 * it : i == 3 || i == 11 ? 0.3 * it : 0)
    : ro == 1 ? (i == 8 ? 1 : i == 14 || i == 15 ? 0.15 * it : od ? 0.05 * it : 0)
    : ro == 2 ? (o8 ? 1 : b4 ? 0.8 : 0.3 + 0.6 * it)
    : ro == 3 ? (i == 12 ? 0.3 + 0.2 * it : i == 4 ? 0.2 * it : 0)
    : ro == 4 ? ((i % 4) == 3 ? 0.4 + 0.4 * it : 0.05 * it)
    : (i == 8 ? 0.8 : 0)
  ) : st == 2 ? (   // TECHNO: straight kick, offbeat hats, shuffled 16ths
    ro == 0 ? (b4 ? 1 : 0.03 * it)
    : ro == 1 ? (od ? 0.05 * it : 0)
    : ro == 2 ? (o8 ? 1 : od ? 0.25 * it : 0.1 * it)
    : ro == 3 ? (o8 ? 0.6 + 0.3 * it : 0)
    : ro == 4 ? (b4 ? 0.05 : 0.12 + 0.25 * it)
    : (i == 4 || i == 12 ? 0.9 : 0)
  ) : st == 3 ? (   // ELECTRO: 808 syncopation, toms
    ro == 0 ? (i == 0 ? 1 : i == 10 ? 0.9 : i == 6 ? 0.4 + 0.3 * it : i == 3 || i == 13 ? 0.2 * it : 0)
    : ro == 1 ? (i == 4 || i == 12 ? 1 : 0.03 * it)
    : ro == 2 ? (b4 ? 1 : 0.7 + 0.3 * it)
    : ro == 3 ? (i == 14 ? 0.4 : 0)
    : ro == 4 ? (i == 7 ? 0.6 : i == 11 ? 0.5 : i == 14 ? 0.4 : i == 15 ? 0.3 * it : 0)
    : (i == 12 ? 0.8 : i == 4 ? 0.3 : 0)
  ) : (   // INDUSTRIAL: heavy 1 + 3, metal scattered everywhere
    ro == 0 ? (i == 0 || i == 8 ? 1 : i == 4 || i == 12 ? 0.2 + 0.3 * it : od ? 0.08 * it : 0)
    : ro == 1 ? (i == 4 || i == 12 ? 1 : 0.1 * it)
    : ro == 2 ? (od ? 0.2 + 0.4 * it : 0.6 + 0.3 * it)
    : ro == 3 ? (0.15 + 0.2 * it)
    : ro == 4 ? (0.3 + 0.4 * it)
    : (0.12 + 0.25 * it)
  );
);
// velocity (63 = panel LEVEL): accents above, ghosts below
function gvel(st, ro, i) local(b4, o8, od) (
  b4 = (i % 4) == 0; o8 = (i % 4) == 2; od = i % 2;
  ro == 0 ? (b4 ? 100 : 78)
  : ro == 1 ? (i == 4 || i == 8 || i == 12 ? 95 : 38)
  : ro == 2 ? (o8 ? (st == 2 ? 100 : 92) : b4 ? 70 : 45)
  : ro == 3 ? 82
  : ro == 4 ? (st == 0 ? ((i % 4) == 3 ? 100 : od ? 80 : 60) : 75)
  : 88;
);
// one lane: clear, then roll the style's rules (all its extras are reset, p-locks too; pitch on/off stays)
function genlane(p, ro, st, it, fl) local(i, ix, pr) (
  clearlane(p, 1); LEN[p] = 16; RATE[p] = 2;
  fl ? (DIR[p] = 0; SW[p] = 0; GRV[p] = 0; GAM[p] = 100;);
  i = 0;
  loop(16,
    ix = p * NSTEP + i; pr = gprob(st, ro, i, it);
    rand(1) < pr ? (
      ON[ix] = 1; VEL[ix] = max(1, min(127, gvel(st, ro, i) + floor(rand(13)) - 6));
      ro == 2 && (i % 2) && it > 0.4 && rand(1) < 0.3 ? (CHN[ix] = (rand(1) < 0.5 ? 75 : 50););   // loose hats
    );
    i += 1;
  );
  // snare turnaround: x3 roll getting louder on step 16, every 4th loop (not techno)
  ro == 1 && st != 2 && it > 0.5 ? (ix = p * NSTEP + 15; ON[ix] = 1; VEL[ix] = 80; SLC[ix] = 2; RMP[ix] = 100; CND[ix] = 9; CTG[ix] = 1;);   // snare every loop, roll on 4:4
  // techno: perc fill only while FILL is on
  ro == 4 && st == 2 && it > 0.5 ? (ix = p * NSTEP + 15; ON[ix] = 1; VEL[ix] = 85; SLC[ix] = 3; CND[ix] = 14;);
  fl ? (
    st == 0 ? (ro == 4 ? (GRV[p] = 7; GAM[p] = 60;) : ro == 2 ? (GRV[p] = 1; GAM[p] = 40;);)
    : st == 1 ? (ro == 2 ? (GRV[p] = 1; GAM[p] = 50;);)
    : st == 2 ? (ro == 2 ? (GRV[p] = 4; GAM[p] = 70;) : ro == 4 ? (GRV[p] = 8; GAM[p] = 60;);)
    : st == 3 ? (ro == 2 ? (GRV[p] = 4; GAM[p] = 50;) : ro == 4 ? (GRV[p] = 5; GAM[p] = 40;);)
    : (ro == 4 ? (LEN[p] = 15; GRV[p] = 3; GAM[p] = 60;) : ro == 5 ? (LEN[p] = 12;) : ro == 0 ? (GRV[p] = 8; GAM[p] = 30;););
  );
);
// v0.59: table styles (5+): one lane from the defr/defm/defg data in @init
function genlanet(p, ro, st, it, fl) local(i, ix, b, g, n, c, s, hit) (
  clearlane(p, 1); n = GSLEN[st]; LEN[p] = n; RATE[p] = GSRATE[st];
  fl ? (DIR[p] = 0; SW[p] = 0; GRV[p] = 0; GAM[p] = 100;);
  b = (st * 6 + ro) * 16; i = 0;
  loop(n,
    ix = p * NSTEP + i; c = GTC[b + i]; s = GTS[b + i];
    hit = rand(1) < GTP[b + i] + GTI[b + i] * it;
    hit ? (
      ON[ix] = 1; VEL[ix] = max(1, min(127, GTV[b + i] + floor(rand(13)) - 6));
      // slice: with a condition (L / F) it waits for it (CTG SLICE), else it rolls in by intensity
      s > 0 && c > 0 ? (SLC[ix] = s; CND[ix] = c; CTG[ix] = 1;)
      : s > 0 && rand(1) < 0.3 + 0.7 * it ? (SLC[ix] = s;);
    ) : c > 0 && (c == 9 || c == 14 ? it >= 0.5 : 1) ? (
      // conditional extra hit (crash 1:8, 4:4 turnaround, FILL tom run): the whole step waits for the condition
      ON[ix] = 1; VEL[ix] = GTV[b + i]; CND[ix] = c; s > 0 ? (SLC[ix] = s;);
    );
    i += 1;
  );
  fl ? (
    g = (st * 6 + ro) * 4;
    GSG[g] > 0 ? (GRV[p] = GSG[g]; GAM[p] = GSG[g + 1];);
    GSG[g + 2] > 0 ? (LEN[p] = GSG[g + 2];);
    GSG[g + 3] >= 50 ? (SW[p] = GSG[g + 3];);
  );
);
function generate(one) local(p, it) (
  snap(); it = ginten / 100;
  one ? (gstyle < 5 ? genlane(focus, focus, gstyle, it, gfeel) : genlanet(focus, focus, gstyle, it, gfeel);)
      : (p = 0; loop(NP, gstyle < 5 ? genlane(p, p, gstyle, it, gfeel) : genlanet(p, p, gstyle, it, gfeel); p += 1;););
  one ? sprintf(#rd, "PART %d · NEW %s LANE · %d%%", focus + 1, gsname(gstyle), ginten) : sprintf(#rd, "NEW %s BEAT · %d%% · Undo = back", gsname(gstyle), ginten);
  msgt = now; bump();
);
// v0.59: style message; meter styles say what they need
function gsmsg() (
  gstyle == 24 ? strcpy(#rd, "STYLE · SWING · 12 triplet steps = one 4/4 bar · part 3 = pedal hat, 4 = ride")
  : gstyle == 25 ? strcpy(#rd, "STYLE · WALTZ 3/4 · 12 steps = one 3/4 bar · set the project to 3/4")
  : gstyle == 26 ? strcpy(#rd, "STYLE · SHUFFLE 12/8 · 12 triplet steps = one 4/4 bar")
  : sprintf(#rd, "STYLE · %s", gsname(gstyle));
  msgt = now;
);
// v0.59: grouped style menu (SCENE / CLUB / BREAKS + ELECTRO / URBAN / CLASSIC), GORD = menu order
function gstmenu() local(r, i, st) (
  strcpy(#m, "[  STYLE  ]|"); i = 0;
  loop(NSTY,
    i == 0 ? strcat(#m, ">SCENE|") : i == 8 ? strcat(#m, ">CLUB|") : i == 12 ? strcat(#m, ">BREAKS + ELECTRO|")
    : i == 15 ? strcat(#m, ">URBAN|") : i == 18 ? strcat(#m, ">CLASSIC|");
    (i == 7 || i == 11 || i == 14 || i == 17 || i == NSTY - 1) ? strcat(#m, "<");
    st = GORD[i]; st == gstyle ? strcat(#m, "!"); strcat(#m, gsname(st)); i < NSTY - 1 ? strcat(#m, "|");
    i += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m) - 1;
  r > 0 ? (gstyle = GORD[r - 1]; gsmsg(););
);
function msgacc(st) ( sprintf(#rd, "ACCENT STEP %02d %s · +%d", st + 1, AC[st] ? "ON" : "OFF", AC[66]); msgt = now; );
function acname(i) ( i == 0 ? "VELOCITY" : i == NPL + 1 ? "NOTE (PIT lanes)" : pname(i - 1) );
function acget(i) ( i == 0 ? AC[66] : i == NPL + 1 ? AC[69] : ACP[i - 1] );
function acset(i, v) (
  i == NPL + 1 ? (AC[69] = max(-24, min(24, floor(v + 0.5))););
  v = max(-64, min(64, floor(v + 0.5))); i == 0 ? (AC[66] = v;) : i <= NPL ? (ACP[i - 1] = v;);
);
function msgacl() ( sprintf(#rd, "ACCENT · LEN %d · RATE %s · %s %+d", AC[64], rname(AC[65]), acname(acsel), acget(acsel)); msgt = now; );
// PARAM menu: VELOCITY + the 26 panel params grouped like the panel; params with an amount show it and get a tick
function acpmenu() local(r, k) (
  sprintf(#m, "%sVELOCITY  %+d|", AC[66] != 0 ? "!" : "", AC[66]); k = 0;
  loop(NPL,
    k == 0 ? strcat(#m, ">LAYER 1|") : k == 7 ? strcat(#m, ">LAYER 2|") : k == 14 ? strcat(#m, ">MIX|") : k == 22 ? strcat(#m, ">WAVEGUIDE|");
    (k == 6 || k == 13 || k == 21 || k == 25) ? strcat(#m, "<");
    ACP[k] != 0 ? (strcat(#m, "!"); strcat(#m, pname(k)); sprintf(#pa, "  %+d", ACP[k]); strcat(#m, #pa);) : strcat(#m, pname(k));
    k < NPL - 1 ? strcat(#m, "|");
    k += 1;
  );
  sprintf(#pa, "|%sNOTE  %+d st  (PIT lanes)", AC[69] != 0 ? "!" : "", AC[69]); strcat(#m, #pa);
  strcat(#m, "||Clear all param amounts");   // v0.58.4: separator, clears always at the bottom
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r == NPL + 3 ? (snap(); memset(ACP, 0, 26); AC[69] = 0; strcpy(#rd, "ACCENT · PARAM AMOUNTS CLEARED"); msgt = now; bump();)
  : r > 0 ? (acsel = r - 1; msgacl(););
);
function acktog(c) local(m, b) (
  m = AC[67] | 0; b = 2 ^ c; (m & b) ? (m -= b;) : (m += b;); AC[67] = m;
  sprintf(#rd, "ACCENT PART %d %s", c + 1, (m & b) ? "LISTENS" : "IGNORES IT"); msgt = now;
);
function acfill(kind) local(i) (   // right-click presets for the accent row
  i = 0; loop(64,
    AC[i] = (kind == 0 ? 0 : kind == 1 ? i % 4 == 0 : kind == 2 ? i % 4 == 2 : kind == 3 ? i % 3 == 0 : kind == 4 ? i % 8 == 0 || i % 8 == 3 || i % 8 == 6
           : rand(1) < 0.25);
    i += 1;
  );
);
function acmenu() local(r) (
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu("[  ACCENT ROW  ]|On the beats (1 5 9 13)|Offbeats (3 7 11 15)|Every 3rd step|3-3-2 (1 4 7)|Random 25 %||Clear accent row") - 1;
  r > 0 && r <= 6 ? (snap(); acfill(r == 6 ? 0 : r); strcpy(#rd, r == 6 ? "ACCENT ROW CLEARED" : "ACCENT PATTERN SET"); msgt = now; bump(););
);
function ducktog(c) local(m, b) (
  m = slider16 | 0; b = 2 ^ c; (m & b) ? (m -= b;) : (m += b;);
  slider16 = m; slider_automate(slider16);
  sprintf(#rd, "DUCK PART %d %s · trigger C1 on ch 10", c + 1, (m & b) ? "ON" : "OFF"); msgt = now;
);
function evname(i) ( i == 0 ? "OFF" : i == 1 ? "1 BAR" : i == 2 ? "2 BARS" : i == 3 ? "4 BARS" : "8 BARS"; );
function setev(i) (
  slider19 = max(0, min(4, i)); slider_automate(slider19);
  slider19 == 0 ? strcpy(#rd, "EVOLVE OFF") : slider19 == 1 ? strcpy(#rd, "EVOLVE · every bar varies a little")
  : sprintf(#rd, "EVOLVE · every %s bar varies a little", slider19 == 2 ? "2nd" : slider19 == 3 ? "4th" : "8th");
  msgt = now;
);
function setevc(v) ( slider20 = max(1, min(3, v)); slider_automate(slider20); sprintf(#rd, "EVOLVE · %d CHANGE%s per evolve bar", slider20, slider20 > 1 ? "S" : ""); msgt = now; );
function evtog(c) local(m, b) (
  m = slider21 | 0; b = 2 ^ c; (m & b) ? (m -= b;) : (m += b;);
  slider21 = m; slider_automate(slider21);
  sprintf(#rd, "EVOLVE · PART %d %s", c + 1, (m & b) ? "MAY CHANGE" : "STAYS AS IS"); msgt = now;
);
function setdens(v) (
  slider24 = max(-100, min(100, v)); slider_automate(slider24);
  slider24 == 0 ? strcpy(#rd, "DENSITY · as written")
  : slider24 < 0 ? sprintf(#rd, "DENSITY %d%% · thinner (hats + ghosts go first, kick last)", slider24)
  : sprintf(#rd, "DENSITY +%d%% · busier (ghost hits: hats first, kick last)", slider24);
  msgt = now;
);
function setchaos(v) (
  slider15 = max(0, min(100, v)); slider_automate(slider15);
  slider15 == 0 ? strcpy(#rd, "CHAOS OFF · clean") : sprintf(#rd, "CHAOS %d%% · %s", slider15, slider15 < 30 ? "sloppy" : slider15 < 70 ? "loose" : "falling apart");
  msgt = now;
);
// ---- groove (focused lane; Shift = all lanes) ----
function setgrv(t) local(i) ( t = (t + NGR) % NGR; dall ? (i = 0; loop(NP, GRV[i] = t; i += 1;);) : (GRV[focus] = t;); );
function setgam(v) local(i) ( v = max(0, min(100, v)); dall ? (i = 0; loop(NP, GAM[i] = v; i += 1;);) : (GAM[focus] = v;); );
function msggrv() (
  GRV[focus] ? sprintf(#t2, "GROOVE %s %d%%", gname(GRV[focus]), GAM[focus]) : strcpy(#t2, "GROOVE OFF");
  dall ? sprintf(#rd, "ALL PARTS · %s", #t2) : sprintf(#rd, "PART %d · %s", focus + 1, #t2); msgt = now;
);
function grvmenu() local(r, i) (
  dall ? strcpy(#m, "[  GROOVE, ALL 6 PARTS  ]|") : sprintf(#m, "[  GROOVE, PART %d  ]|", focus + 1); i = 0;
  loop(NGR, i == GRV[focus] ? strcat(#m, "!"); strcat(#m, gname(i)); i < NGR - 1 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m) - 1;
  r > 0 ? (snap(); setgrv(r - 1); msggrv(); bump(););
);
function gamenu() local(r, i) (
  dall ? strcpy(#m, "[  GROOVE AMOUNT, ALL 6 PARTS  ]|") : sprintf(#m, "[  GROOVE AMOUNT, PART %d  ]|", focus + 1); i = 0;
  loop(5, (i + 1) * 25 == GAM[focus] ? strcat(#m, "!"); sprintf(#n, "%d%%", (i + 1) * 25); strcat(#m, #n); i < 4 ? strcat(#m, "|"); i += 1;);
  gfx_x = mouse_x; gfx_y = mouse_y; r = gfx_showmenu(#m) - 1;
  r > 0 ? (snap(); setgam(r * 25); msggrv(); bump(););
);
// mute / solo: r 0 = mute row (slider 13), 1 = solo row (slider 14); bit c = part c+1
function mstr() local(i) (
  strcpy(#ms, ""); i = 0;
  loop(NP, (slider14 | 0) & (2 ^ i) ? (sprintf(#n, " %d", i + 1); strcat(#ms, #n);); i += 1;);
  strlen(#ms) ? (strcpy(#t3, "SOLO"); strcat(#t3, #ms);) : (
    i = 0; loop(NP, (slider13 | 0) & (2 ^ i) ? (sprintf(#n, " %d", i + 1); strcat(#ms, #n);); i += 1;);
    strlen(#ms) ? (strcpy(#t3, "MUTE"); strcat(#t3, #ms);) : strcpy(#t3, "ALL LANES PLAY");
  );
  #t3;
);
function mutetog(r, c) local(m, b) (
  m = (r ? slider14 : slider13) | 0; b = 2 ^ c;
  (m & b) ? (m -= b;) : (m += b;);
  r ? (slider14 = m; slider_automate(slider14);) : (slider13 = m; slider_automate(slider13););
  strcpy(#rd, mstr()); msgt = now;
);
function muteclr(r) (
  r ? (slider14 = 0; slider_automate(slider14);) : (slider13 = 0; slider_automate(slider13););
  strcpy(#rd, mstr()); msgt = now;
);
// velocity from the mouse height inside a lane's cells: top = 127, bottom = 1
function hvel(p) local(t) ( t = laney(p) + CY0; max(1, min(127, floor((1 - (mouse_y - t) / CH) * 126 + 1.5))); );
// step under the mouse on the current page in lane p (x only), -1 = none
function colat() local(k, r) ( r = -1; k = 0; loop(16, mouse_x >= cellx(k) - CG && mouse_x < cellx(k) + CW + CG ? (r = k;); k += 1;); r; );
function laneat() local(p, r) ( r = -1; p = 0; loop(NP, mouse_y >= laney(p) && mouse_y < laney(p) + LH + LGAP ? (r = p;); p += 1;);
  r < 0 ? (r = mouse_y < LY ? 0 : NP - 1;); r; );

// ---- value tabs: 0 STEPS, 1 VELOCITY, 2 CHANCE, 3 SLICE, 4 OFFSET, 5 P-LOCK, 6 PITCH ----
function tabname(i) ( i == 0 ? "STEPS" : i == 1 ? "VELOCITY" : i == 2 ? "CHANCE" : i == 3 ? "SLICE" : i == 4 ? "OFFSET" : i == 6 ? "PITCH" : "P-LOCK"; );

function tabfld(i) ( i == 1 ? 1 : i == 2 ? 5 : i == 3 ? 2 : i == 6 ? 7 : 4; );
// value from the mouse height in lane p for the current tab (Alt held = default value)
function tabval(p) local(t) (
  t = max(0, min(1, 1 - (mouse_y - laney(p) - CY0) / CH));
  alt ? (tab == 5 ? (plrng ? 0 : -1) : deffld(tabfld(tab))) :
  tab == 1 ? max(1, floor(t * 126 + 1.5)) :
  tab == 2 ? floor(t * 20 + 0.5) * 5 :
  tab == 3 ? min(5, floor(t * 6)) :
  tab == 5 ? (plrng ? floor(t * 64 + 0.5) : floor(t * 127 + 0.5)) :
  tab == 6 ? floor((t * 2 - 1) * 24 + 0.5) :   // middle = 0, top = +24, bottom = -24
  floor((t * 2 - 1) * 8 + 0.5) * 5;
);
// paint the tab value onto every lit step the mouse passes (gap-filled, stays in the lane it started in)
function tpaint() local(k, kk, kend, s, ix, v, nv, lw) (
  k = colat();
  k >= 0 ? (
    dlastk < 0 ? (dlastk = k;);
    kk = min(dlastk, k); kend = max(dlastk, k); v = tabval(dlane);
    loop(kend - kk + 1,
      s = page * 16 + kk; ix = dlane * NSTEP + s;
      s < LEN[dlane] && ON[ix] ? (
        tab == 5 ? (
          plrng ? (
            // RANGE: the value stays; an unlocked step gets a lock at the panel's current value (range > 0 only)
            PL[ix * NPL + plk] >= 0 ? (
              floor(PL[ix * NPL + plk] / 128) != v ? (PL[ix * NPL + plk] = PL[ix * NPL + plk] % 128 + 128 * v; edited = 1;);
            ) : v > 0 ? (
              PL[ix * NPL + plk] = max(0, min(127, floor((pnl ? gmem[1000 + pidx(dlane, plk)] : 64) + 0.5))) + 128 * v; edited = 1;
            );
          ) : (
            // VALUE: keeps an existing range (Alt = remove the lock)
            nv = (v < 0 ? -1 : v + 128 * floor(max(0, PL[ix * NPL + plk]) / 128));
            PL[ix * NPL + plk] != nv ? (PL[ix * NPL + plk] = nv; edited = 1;);
          );
        )
                 : (fval(ix, tabfld(tab)) != v ? (applyf(ix, tabfld(tab), v); edited = 1;););
      );
      kk += 1;
    );
    dlastk = k;
    ix = dlane * NSTEP + page * 16 + k;
    ON[ix] ? (
      tab == 5 ? (lw = PL[ix * NPL + plk];
                  lw >= 128 ? sprintf(#rd, "P%d STEP %02d · %s %d ±%d (random per hit)", dlane + 1, page * 16 + k + 1, pname(plk), lw % 128, floor(lw / 128))
                  : lw >= 0 ? sprintf(#rd, "P%d STEP %02d · %s %d%s", dlane + 1, page * 16 + k + 1, pname(plk), lw, plrng ? " · RANGE 0" : "")
                  : sprintf(#rd, "P%d STEP %02d · %s UNLOCKED", dlane + 1, page * 16 + k + 1, pname(plk));)
               : sprintf(#rd, "P%d STEP %02d · %s", dlane + 1, page * 16 + k + 1, fdesc(ix, tabfld(tab)));
      msgt = now;
    );
  );
);

// ---- double-click = default value (2026-11-05): LEN 16, RATE 1/16, DIR forward, lane swing = global, HUM 0,
// global swing 50 %, BPM 120, STEP fields (velocity 63, chance 100 %, rest 0), random amount 50 %
dbl = 0;
press ? (
  dbl = hreg > 0 && now - lpt < 0.35 && hreg == lph && hp == lphp && hk == lphk;
  lpt = (dbl ? 0 : now); lph = hreg; lphp = hp; lphk = hk;
  !hreg && inr(HBX, HBY2, HBW, HBH) ? (dbl = now - lbpt < 0.35; lbpt = (dbl ? 0 : now););
);
// only boxes with a default take the double-click (steps, buttons etc. keep fast clicking)
dbl = dbl && ((hreg == 3 && tab > 0) || hreg == 24 || hreg == 25 || hreg == 31 || hreg == 2 || hreg == 4 || hreg == 5 || hreg == 6 || hreg == 7 || hreg == 8 || hreg == 9 || hreg == 10
              || (hreg >= 11 && hreg <= 18) || hreg == 66 || hreg == 91 || hreg == 92 || hreg == 93 || hreg == 96 || (!hreg && ffree && slider3 >= 0.5 && inr(HBX, HBY2, HBW, HBH)));
press && dbl ? (
  hreg == 3 ? (
    // value tab: double-click a lit step = its value back to default (P-LOCK tab: lock removed)
    s = page * 16 + hk; idx = hp * NSTEP + s;
    s < LEN[hp] && ON[idx] ? (
      snap();
      tab == 5 ? (PL[idx * NPL + plk] = -1; sprintf(#rd, "P%d STEP %02d · %s UNLOCKED", hp + 1, s + 1, pname(plk));)
               : (applyf(idx, tabfld(tab), deffld(tabfld(tab))); sprintf(#rd, "P%d STEP %02d · %s", hp + 1, s + 1, fdesc(idx, tabfld(tab))););
      msgt = now; bump();
    );
  )
  : hreg == 25 ? (setchaos(0);)
  : hreg == 31 ? (setdens(0);)
  : hreg == 23 || hreg == 24 ? (dall = shift; snap(); hreg == 23 ? setgrv(0) : setgam(100); msggrv(); bump();)
  : hreg == 5 || hreg == 2 ? (dall = shift; snap(); setlen(hp, 16); focus = hp; msglen(hp); bump();)
  : hreg == 4 ? (dall = shift; snap(); setrate(hp, 2); focus = hp; msgrate(hp); bump();)
  : hreg == 10 ? (dall = shift; snap(); setdir(hp, 0); msgdir(hp); bump();)
  : hreg == 9 ? (dall = shift; snap(); GRV[hp] ? (setgrv(0); msggrv();) : (setlsw(hp, 0); msglsw(hp);); bump();)
  : hreg == 6 ? (snap(); HT[hp] = 0; sprintf(#rd, "PART %d · HUMANIZE TIME 0%%", hp + 1); msgt = now; bump();)
  : hreg == 7 ? (snap(); HV[hp] = 0; sprintf(#rd, "PART %d · HUMANIZE VEL 0%%", hp + 1); msgt = now; bump();)
  : hreg == 8 ? (setgsw(50);)
  : hreg >= 11 && hreg <= 18 ? (snap(); setfld(hreg - 10, deffld(hreg - 10)); bump();)
  : hreg == 66 ? (ramt = 50; strcpy(#rd, "AMOUNT 50%"); msgt = now;)
  : hreg == 91 || hreg == 96 ? (snap(); AC[64] = 16; msgacl(); bump();)
  : hreg == 92 ? (snap(); AC[65] = 2; msgacl(); bump();)
  : hreg == 93 ? (snap(); acset(acsel, acsel == 0 ? 40 : 0); msgacl(); bump();)
  : ffree && slider3 >= 0.5 && inr(HBX, HBY2, HBW, HBH) ? (slider2 = 120; slider_automate(slider2); strcpy(#rd, "BPM 120"); msgt = now;);
  drag = 0; press = 0;
);

press ? (
  inr(RCX + RRW + S(4), PGY, RCW - RRW - S(4), PGH) ? (
    calon = !calon; caln = 0; calsum = 0;
    calon ? strcpy(#rd, "CAL · play, then tap a pad on every BEAT · 8 taps") : strcpy(#rd, "CAL CANCELLED");
    msgt = now;
  ) : inr(RCX, PGY, RRW, PGH) ? (
    slider17 = (slider17 >= 0.5 ? 0 : 1); slider_automate(slider17);
    slider17 ? (snap(); trecn = 0; strcpy(#rd, "TAP RECORD ON · hit the pads while playing");) : (sprintf(#rd, "TAP RECORD OFF · %d hits recorded", trecn););
    msgt = now;
  ) : inr(HBX, HBY1, HBW, HBH) ? (
    slider1 = (ffree ? 0 : 1); slider_automate(slider1);
  ) : inr(HB2X, HBY1, HBW, HBH) ? (
    ffree ? (slider4 = (slider4 >= 0.5 ? 0 : 1); slider_automate(slider4););
  ) : inr(HBX, HBY2, HBW, HBH) ? (
    ffree && slider3 >= 0.5 ? (drag = 4; dsy = mouse_y; dsv = slider2;);
  ) : inr(HB2X, HBY2, HBW, HBH) ? (
    ffree ? (slider3 = (slider3 >= 0.5 ? 0 : 1); slider_automate(slider3););
  ) : inr(HB3X, HBY1, HBW, HBH) ? (
    mastermenu();
  ) : inr(HB3X, HBY2, HBW, HBH) ? (
    slider7 = (slider7 >= 0.5 ? 0 : 1); slider_automate(slider7);
    sprintf(#rd, "FILL %s", slider7 >= 0.5 ? "ON" : "OFF"); msgt = now;
  ) : chit ? (
    slider10 = (slider10 >= 0.5 ? 0 : 1); slider_automate(slider10);
    slider10 < 0.5 ? strcpy(#rd, "CHAIN OFF") : chlen ? sprintf(#rd, "CHAIN ON · %s", chstr()) : strcpy(#rd, "CHAIN ON · EMPTY · Shift+click patterns to add");
    msgt = now;
  ) : rghit ? (
    slider22 = (slider22 >= 0.5 ? 0 : 1); slider_automate(slider22);
    slider22 < 0.5 ? strcpy(#rd, "REGIONS OFF") : !rgalive ? strcpy(#rd, "REGIONS ON · LISTENER OFF: RUN ACTION 'VOLCA LISTENER (START)'")
    : ffree ? strcpy(#rd, "REGIONS ON · works in SYNC REAPER only") : strcpy(#rd, "REGIONS ON · regions named P1 … P16 pick the pattern");
    msgt = now;
  ) : lkhit ? (
    setlook(!skin);
  ) : thhit ? (
    thmenu();
  ) : clrhit ? (
    chlen ? (chlen = 0; strcpy(#rd, "CHAIN CLEARED"); msgt = now; bump(););
  ) : fphit ? (
    fpmenu();
  ) : chslot >= 0 ? (
    chslot <= chlen ? chslotmenu(chslot);
  ) : pathit >= 0 && shift ? (
    chadd(pathit);
  ) : pathit >= 0 ? (
    slider8 = pathit + 1; slider_automate(slider8);
    slider10 >= 0.5 && chlen ? sprintf(#rd, "PATTERN %02d SELECTED · CHAIN IS ON, it plays when CHAIN is off", pathit + 1) :
    sprintf(#rd, running ? "PATTERN %02d · NEXT %s" : "PATTERN %02d", pathit + 1, slider6 >= 1 ? "CYCLE" : "BAR"); msgt = now;
  ) : tab == 5 && inr(RNGX, TBY, RNGW, TBH) ? (
    plrng = (mouse_x >= RNGX + RNGW / 2); strcpy(#rd, plrng ? "P-LOCK RANGE · drag = random range (top = ±64), Alt = 0 · unlocked steps start at the panel value" : "P-LOCK VALUE · drag = value, Alt = remove"); msgt = now;
  ) : tab == 5 && inr(PARX, TBY, PLPW, TBH) ? (
    plkmenu();
  ) : tabhit == 6 && !anypit ? (
