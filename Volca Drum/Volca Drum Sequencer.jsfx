      idx = dlane * NSTEP + dstep;
      v != VEL[idx] || !ON[idx] ? (VEL[idx] = v; ON[idx] = max(1, ON[idx]); edited = 1; msgstep(dlane, dstep););
    ) : dmode == 2 ? (
      k = colat();
