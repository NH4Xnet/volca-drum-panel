  ) : hreg == 2 || hreg == 5 ? (
    wsnap(); setlen(hp, max(1, min(NSTEP, LEN[hp] + n))); focus = hp; msglen(hp); bump();
  ) : hreg == 6 ? (
    wsnap(); HT[focus] = max(0, min(100, HT[focus] + n * 5)); sprintf(#rd, "PART %d · HUMANIZE TIME %d%%", focus + 1, HT[focus]); msgt = now; bump();
  ) : hreg == 7 ? (
    wsnap(); HV[focus] = max(0, min(100, HV[focus] + n * 5)); sprintf(#rd, "PART %d · HUMANIZE VEL %d%%", focus + 1, HV[focus]); msgt = now; bump();
