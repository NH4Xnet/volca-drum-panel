    setgsw(gsw() + n);
  ) : hreg == 9 ? (
    GRV[focus] ? (snap(); setgam(GAM[focus] + n * 5); msggrv(); bump();) : (wsnap(); setlsw(focus, max(50, min(75, lsw(focus) + n))); msglsw(focus); bump(););
  ) : hreg >= 61 && hreg <= 66 ? (
    genwheel(n);
  ) : hreg == 84 ? (
    gstyle = GORD[(gslot(gstyle) + n + NSTY) % NSTY]; gsmsg();
  ) : hreg == 85 ? (
    ginten = max(0, min(100, ginten + n * 5)); sprintf(#rd, "INTENSITY %d%%", ginten); msgt = now;
  ) : hreg == 30 ? (
    setaf((slider23 | 0) + n);
  ) : hreg == 27 ? (
    setev((slider19 | 0) + n);
  ) : hreg == 28 ? (
    setevc((slider20 | 0) + n);
  ) : hreg == 25 ? (
    setchaos(slider15 + n * 5);
  ) : hreg == 31 ? (
    setdens(slider24 + n * 5);
  ) : hreg == 23 ? (
    snap(); setgrv(GRV[focus] + n); msggrv(); bump();
  ) : hreg == 24 ? (
    snap(); setgam(GAM[focus] + n * 5); msggrv(); bump();
  ) : hreg == 19 ? (
    focus = hp; snap(); setpbase(hp, PBNOTE[hp] + n); msgpit(hp); bump();
  ) : hreg >= 11 && hreg <= 18 ? (
    wsnap(); f = hreg - 10;
    isrel(f) ? addfld(f, n * (f == 1 ? 4 : f == 7 ? 1 : 5)) : setfld(f, getfld(f) + n * (f == 6 ? 25 : 1));
    bump();
  ) : inr(HBX, HBY2, HBW, HBH) && ffree && slider3 >= 0.5 ? (
    slider2 = max(20, min(300, slider2 + n)); slider_automate(slider2);
  ) : inr(HB3X, HBY1, HBW, HBH) ? (
    setmaster(slider6 + n);
  );
);
plb = lb; prb = rb;

// ---- keyboard (FX window focused): Del/Backspace, Ctrl+C/V/A/Z, Esc (REAPER may keep some keys for itself) ----
while ((kc = gfx_getchar()) > 0) (
  kc == 6579564 || kc == 8 ? dodelete()
  : kc == 3 ? docopy()
  : kc == 22 ? dopaste()
  : kc == 1 ? doselane()
  : kc == 26 ? doundokey()
  : kc == 27 ? (selclear(); strcpy(#rd, "SELECTION CLEARED"); msgt = now;);
);

// ---- texts shared by both looks ----
fresh = now - msgt < 4;
fresh ? strcpy(#r1, #rd) : sprintf(#r1, "P%d · LEN %d · %s", focus + 1, LEN[focus], rname(RATE[focus]));
// v0.57.3: no panel / wrong order = the hits go to the wrong channel: say it on every tab (click messages still show for 4 s)
perr = (!pnl ? 1 : !pord && pnla > srate ? 2 : 0);   // v0.58.2: order error only after 1 s with a live panel (no flash after load)
perr && !fresh ? strcpy(#r1, perr == 1 ? "NO PANEL · LOAD IT AFTER THE SEQUENCER" : "PANEL MUST COME AFTER THE SEQUENCER");
// v0.54.2: a new readout text fades in (ease-out, 0.35 s) and slides up a few px; fast updates (drags) show at once
strcmp(#r1, #r1l) != 0 ? (strcpy(#r1l, #r1); r1t = (now - r1c > 0.3 ? now : now - 1); r1c = now;);
r1e = min(1, max(0, (now - r1t) / 0.35)); r1e = 1 - (1 - r1e) * (1 - r1e) * (1 - r1e); r1y = floor((1 - r1e) * S(6));
running = (ffree ? slider4 >= 0.5 : (b_pst & 1));
ffree ? (
  sprintf(#rd2, "FREE · %.1f BPM · %s", slider3 >= 0.5 ? slider2 : b_tempo, running ? "RUNNING" : "STOPPED");
) : running ? (
  tsn = max(1, b_tsn); bar = floor(dispq / tsn); beat = floor(dispq - bar * tsn);
  sprintf(#rd2, "SYNC REAPER · %.1f BPM · BAR %d.%d", b_tempo, bar + 1, beat + 1);
) : sprintf(#rd2, "SYNC REAPER · %.1f BPM · STOPPED", b_tempo);
slider6 >= 1 && running && dispmb > 0 ? (
  dispmb >= 1 ? sprintf(#t, " · MASTER %d/%d", dispbar, dispmb) : strcpy(#t, " · MASTER 1/2");
  strcat(#rd2, #t);
);
busycnt != lastbusy ? (lastbusy = busycnt; busyt = now;);
now - busyt < 2 ? strcat(#rd2, " · MIDI TIGHT!");
slider24 != 0 ? (sprintf(#t, slider24 > 0 ? " · DENSITY +%d%%" : " · DENSITY %d%%", slider24); strcat(#rd2, #t););
slider15 > 0 ? (sprintf(#t, " · CHAOS %d%%", slider15); strcat(#rd2, #t););
slider19 >= 1 ? (sprintf(#t, " · EVOLVE /%d", evn()); strcat(#rd2, #t););
slider23 >= 1 ? (running && afon ? strcat(#rd2, " · AUTO FILL NOW") : (sprintf(#t, " · AUTO FILL /%d", afn()); strcat(#rd2, #t);););
gmem[2000] != lastrghb ? (lastrghb = gmem[2000]; rghbt = now;); rgalive = now - rghbt < 2;   // region helper alive?
slider22 >= 0.5 ? (!rgalive ? strcat(#rd2, " · REGIONS: NO HELPER") : rgdisp >= 0 ? (sprintf(#t, " · REGION P%d", rgdisp + 1); strcat(#rd2, #t);) : strcat(#rd2, " · REGIONS"););
perr ? (strcpy(#t, #rd2); strcpy(#rd2, perr == 1 ? "NO PANEL (needs v1.5.2.2+, not bypassed) · " : "PANEL ORDER: sequencer first, then panel, same track · "); strcat(#rd2, #t););
slider10 >= 0.5 && chlen ? (strcat(#rd2, " · CHAIN "); strcat(#rd2, chstr());) : slider10 >= 0.5 ? strcat(#rd2, " · CHAIN EMPTY");
(slider7 >= 0.5 || (running && afon)) && fillp >= 0 ? (sprintf(#t, " · FILL PAT %02d", fillp + 1); strcat(#rd2, #t););
// v0.54: every control says what it does while hovered (step cells and accent cells excluded: too busy)
tlh = 0;
hreg > 0 && hreg != 3 && hreg != 90 ? (
  tlh = hreg + 1000 * (2 + (hreg == 29 ? evpc : hreg == 26 ? dkc : hreg == 94 ? akc : hreg == 100 ? kslot : hreg <= 22 ? hp : 0));
) : hreg == 0 ? (
  tlh = inr(HBX, HBY1, HBW, HBH) ? 201 : inr(HB2X, HBY1, HBW, HBH) ? 202 : inr(HBX, HBY2, HBW, HBH) ? 203 : inr(HB2X, HBY2, HBW, HBH) ? 204
      : inr(HB3X, HBY1, HBW, HBH) ? 205 : inr(HB3X, HBY2, HBW, HBH) ? 206
      : tab == 5 && inr(RNGX, TBY, RNGW, TBH) ? 218 : tab == 5 && inr(PARX, TBY, PLPW, TBH) ? 219 : tabhit >= 0 ? 210 + tabhit
      : pathit >= 0 ? 220 + 1000 * (2 + pathit) : chit ? 240 : rghit ? 241 : clrhit ? 242 : fphit ? 243 : chslot >= 0 ? 244 + 1000 * (2 + chslot)
      : smt >= 0 ? 260 + smt
      : inr(RCX, PGY, RRW, PGH) ? 270 : inr(RCX + RRW + S(4), PGY, RCW - RRW - S(4), PGH) ? 271
      : (pg_ = -1; i = 0; loop(4, inr(pbx(i), PGY, PBW, PGH) ? (pg_ = i;); i += 1;); pg_ >= 0 ? 250 + pg_ : 0);
);
// v0.54.1: tip after 1 s of rest, stays while hovered, gone at once when the mouse leaves (click messages stay)
tlh != lasttlh ? (tipon && msgt == tipt ? (msgt = -100;); tipon = 0; tipdone = 0; tipst = now; lasttlh = tlh;);
// v0.54.4: the mouse has to be still: any move over 3 px restarts the wait (until the tip is up)
abs(mouse_x - tmx) > 3 || abs(mouse_y - tmy) > 3 ? (tmx = mouse_x; tmy = mouse_y; !tipdone ? (tipst = now;););
tlh && !tipdone && now - tipst >= 1 ? (strcpy(#rdsv, #rd); strcpy(#rd, ""); tipdesc(tlh % 1000); strlen(#rd) ? (msgt = now; tipt = msgt; tipon = 1;) : strcpy(#rd, #rdsv); tipdone = 1;);   // no text = no tip
tipon && msgt == tipt ? (msgt = now; tipt = msgt;) : (tipon = 0;);
dnext != curpat ? (sprintf(#t, " · NEXT PAT %02d", dnext + 1); strcat(#rd2, #t););

!skin ? (
// ---- background ----
rc(K_BG, 1); bg_r = gfx_r; bg_g = gfx_g; bg_b = gfx_b; rc(K_BG2, 1);
gfx_gradrect(0, 0, gfx_w, gfx_h, bg_r, bg_g, bg_b, 1, 0, 0, 0, 0, (gfx_r - bg_r) / gfx_h, (gfx_g - bg_g) / gfx_h, (gfx_b - bg_b) / gfx_h, 0);

// ---- title + theme ----
gfx_setfont(1, "Bahnschrift", CF(S(26)), 'b'); rc(K_TXT, 1); txt("VOLCA DRUM", MG, MG + S(6));
gfx_setfont(3, "Bahnschrift", CF(S(13)), 'b'); rc(K_ACC, 1); txt("S E Q U E N C E R", MG + S(1), MG + S(36));
gfx_setfont(5, "Consolas", CF(S(10))); rc(K_DIM, 1); txt("v1.0 · classic", MG + S(1), MG + S(54));   // bump on every change

// ---- readout ----
rc(K_RDB, 1); gfx_rect(RDX, MG, RDW, HDH);
rc(K_FLDB, 0.8); frame(RDX, MG, RDW, HDH);
perr ? (rc(K_HOT, 0.55 + 0.45 * sin(now * 6)); frame(RDX, MG, RDW, HDH); frame(RDX + 1, MG + 1, RDW - 2, HDH - 2); frame(RDX + 2, MG + 2, RDW - 4, HDH - 4););   // v0.57.3 panel error
gfx_setfont(2, "Consolas", CF(S(22))); gfx_measurestr(#r1, rw_, rh_);
rw_ > RDW - S(28) ? gfx_setfont(2, "Consolas", CF(S(17)));   // long message: smaller font before cutting
gte = 0.15 + 0.85 * r1e; glowtxt(fit(#r1, RDW - S(28)), RDX + S(14), MG + S(10) + r1y, fresh ? 1 : 0.55); gte = 1;
gfx_setfont(5, "Consolas", CF(S(12))); rc(K_RDT, 0.8); txt(fit(#rd2, RDW - S(28)), RDX + S(14), MG + HDH - S(22));

// ---- header (layout B): TRANSPORT 2 x 2 · PATTERN master / fill · FEEL chaos + swing, each with a small label ----
gfx_setfont(3, "Bahnschrift", CF(S(9)), 'b'); rc(K_LBL, 1);
txt("TRANSPORT", HBX, HDY); txt("PATTERN", HB3X, HDY); txt("FEEL · ALL LANES", DNX, HDY);
btn(HBX, HBY1, HBW, HBH, ffree ? "SYNC FREE" : "SYNC REAPER", 0, 1);
ffree ? btn(HB2X, HBY1, HBW, HBH, running ? "STOP" : "PLAY", running, 1)
      : btn(HB2X, HBY1, HBW, HBH, running ? "PLAYING" : "STOPPED", 0, 0);
sprintf(#bp, "BPM %.1f", ffree && slider3 >= 0.5 ? slider2 : b_tempo);
btn(HBX, HBY2, HBW, HBH, #bp, drag == 4, ffree && slider3 >= 0.5);
btn(HB2X, HBY2, HBW, HBH, slider3 >= 0.5 ? "OWN TEMPO" : "PROJ TEMPO", 0, ffree);
sprintf(#t, "MASTER %s", mname(slider6)); btn(HB3X, HBY1, HBW, HBH, #t, 0, 1);
btn(HB3X, HBY2, HBW, HBH, "FILL", slider7 >= 0.5 || (running && afon), 1);
// global SWING box
rc(K_FLD, 1); gfx_rect(SWX, SWY, SWW, SWH);
drag == 8 || hreg == 8 ? rc(K_FOC, 1) : rc(K_FLDB, 1); frame(SWX, SWY, SWW, SWH);
gfx_setfont(4, "Bahnschrift", CF(S(24)), 'b'); gfx_measurestr("0", sv_w, sv_h); SWVY = floor(SWY + SWH / 2 + (SWH / 2 - sv_h) / 2) - S(1);   // v0.58.3: value centered in the lower half (below the DENSITY zero line)
gfx_setfont(3, "Bahnschrift", CF(S(11)), 'b'); rc(K_LBL, 1); ctxt("SWING", SWX, SWY + S(5), SWW);
gfx_setfont(4, "Bahnschrift", CF(S(24)), 'b');
gsw() == 50 ? (rc(K_DIM, 1); ctxt("OFF", SWX, SWVY, SWW);)
            : (rc(K_TXT, 1); sprintf(#t, "%d%%", gsw()); ctxt(#t, SWX, SWVY, SWW););
// DENSITY box (v0.53): bar from the middle line, up = busier, down = thinner
rc(K_FLD, 1); gfx_rect(DNX, SWY, DNW, SWH);
dn_ = (SWH - 2) / 2 * abs(slider24) / 100; rc(K_ACC, 0.18 + 0.5 * abs(slider24) / 100);
slider24 > 0 ? gfx_rect(DNX + 1, SWY + SWH / 2 - dn_, DNW - 2, dn_) : slider24 < 0 ? gfx_rect(DNX + 1, SWY + SWH / 2, DNW - 2, dn_);
rc(K_FLDB, 1); gfx_rect(DNX + 1, SWY + floor(SWH / 2), DNW - 2, 1);
drag == 31 || hreg == 31 ? rc(K_FOC, 1) : rc(K_FLDB, 1); frame(DNX, SWY, DNW, SWH);
gfx_setfont(3, "Bahnschrift", CF(S(11)), 'b'); rc(K_LBL, 1); ctxt("DENSITY", DNX, SWY + S(5), DNW);
gfx_setfont(4, "Bahnschrift", CF(S(24)), 'b');
slider24 == 0 ? (rc(K_DIM, 1); ctxt("0", DNX, SWVY, DNW);) : (rc(K_TXT, 1); sprintf(#t, slider24 > 0 ? "+%d" : "%d", slider24); ctxt(#t, DNX, SWVY, DNW););
// CHAOS box: red fill rises with the amount
rc(K_FLD, 1); gfx_rect(CHX, SWY, CHW, SWH);
slider15 > 0 ? (rc(K_ACC, 0.18 + 0.5 * slider15 / 100); ch_ = (SWH - 2) * slider15 / 100; gfx_rect(CHX + 1, SWY + SWH - 1 - ch_, CHW - 2, ch_););
drag == 25 || hreg == 25 ? rc(K_FOC, 1) : rc(K_FLDB, 1); frame(CHX, SWY, CHW, SWH);
gfx_setfont(3, "Bahnschrift", CF(S(11)), 'b'); rc(K_LBL, 1); ctxt("CHAOS", CHX, SWY + S(5), CHW);
gfx_setfont(4, "Bahnschrift", CF(S(24)), 'b');
slider15 == 0 ? (rc(K_DIM, 1); ctxt("OFF", CHX, SWVY, CHW);) : (rc(K_TXT, 1); sprintf(#t, "%d%%", slider15); ctxt(#t, CHX, SWVY, CHW););

// ---- pattern row (aligned with the step columns) ----
gfx_setfont(3, "Bahnschrift", CF(S(12)), 'b'); rc(K_LBL, 1); txt("PATTERN", MG, PTY + (PTH - S(12)) / 2);
gfx_setfont(4, "Bahnschrift", CF(S(19)), 'b'); rc(K_TXT, 1);
sprintf(#t, "%02d", curpat + 1); rtxt(#t, MG + TW, PTY + (PTH - S(19)) / 2);
k = 0;
loop(NPAT,
  x = cellx(k); pu = patused(k);
  k == curpat ? (rc(K_FOC, 1); gfx_rect(x, PTY, CW, PTH);)
  : pu ? (rc(K_PU, 1); gfx_rect(x, PTY, CW, PTH); rc(K_FLDB, 1); frame(x, PTY, CW, PTH);)
  : (rc(K_CEL, 1); gfx_rect(x, PTY, CW, PTH); rc(K_PNLB, 1); frame(x, PTY, CW, PTH););
  // queued: blinking frame until the switch
  k == dnext && dnext != curpat ? (rc(K_FOC, 0.5 + 0.5 * sin(now * 10)); frame(x, PTY, CW, PTH); frame(x + 1, PTY + 1, CW - 2, PTH - 2););
  // in the chain: line at the bottom · fill pattern: F in the corner
  i = 0; inch = 0; loop(chlen, CHL[i] == k ? (inch = 1;); i += 1;);
  inch ? (rc(K_ALT, slider10 >= 0.5 ? 1 : 0.45); gfx_rect(x + S(4), PTY + PTH - S(4), CW - S(8), S(2)););
  k == fillp ? (gfx_setfont(3, "Bahnschrift", CF(S(10)), 'b'); rc(K_HOT, 1); txt("F", x + CW - S(9), PTY + S(1)););
  kithas(k) ? (gfx_setfont(3, "Bahnschrift", CF(S(10)), 'b'); k == curpat ? rc(K_FOCT, 1) : rc(K_ALT, 1); txt("K", x + S(3), PTY + S(1)););
  gfx_setfont(5, "Consolas", CF(S(12)));
  k == curpat ? rc(K_FOCT, 1) : pu ? rc(K_TXT, 1) : rc(K_DIM2, 1);
  sprintf(#t, "%d", k + 1); ctxt(#t, x, PTY + (PTH - S(12)) / 2, CW);
  k += 1;
);

// ---- song row: CHAIN · CLEAR · FILL PAT | chain slots ----
btn(MG, SOY, SGCW, SOH, "CHAIN", slider10 >= 0.5, 1);
btn(SGRX, SOY, SGRW, SOH, "REGIONS", slider22 >= 0.5, 1);
slider22 >= 0.5 && !rgalive ? (rc(K_HOT, 1); frame(SGRX, SOY, SGRW, SOH); frame(SGRX + 1, SOY + 1, SGRW - 2, SOH - 2););   // no helper
btn(SGLX, SOY, SGLW, SOH, "CLEAR", 0, chlen > 0);
fpx_ = SGFX; fpw_ = MG + TW - SGFX;
rc(K_FLD, 1); gfx_rect(fpx_, SOY, fpw_, SOH); fphit ? rc(K_FOC, 1) : rc(K_FLDB, 1); frame(fpx_, SOY, fpw_, SOH);
gfx_setfont(3, "Bahnschrift", CF(S(12)), 'b');
fillp >= 0 ? sprintf(#t, "%02d", fillp + 1) : strcpy(#t, "--");
gfx_measurestr("FILL PAT", fw1_, fh_); gfx_measurestr(#t, fw2_, fh_);
fxx_ = fpx_ + (fpw_ - fw1_ - S(6) - fw2_) / 2; fyy_ = SOY + (SOH - S(12)) / 2;
rc(K_LBL, 1); txt("FILL PAT", fxx_, fyy_); fillp >= 0 ? rc(K_HOT, 1) : rc(K_DIM2, 1); txt(#t, fxx_ + fw1_ + S(6), fyy_);
ca_ = (slider10 >= 0.5 ? 1 : 0.45);   // chain off: dimmed
k = 0;
loop(16,
  x = cellx(k);
  k < chlen ? (
    k == chdisp ? (rc(K_ALT, ca_); gfx_rect(x, SOY, CW, SOH); rc(K_BG2, 1);)
                : (rc(K_ALT, 0.16 * ca_); gfx_rect(x, SOY, CW, SOH); rc(K_ALT, 0.6 * ca_); frame(x, SOY, CW, SOH); rc(K_TXT, 0.9 * ca_););
    gfx_setfont(5, "Consolas", CF(S(12))); sprintf(#t, "%d", CHL[k] + 1); ctxt(#t, x, SOY + (SOH - S(12)) / 2, CW);
  ) : k == chlen ? (
    rc(K_FLDB, 1); dframe(x, SOY, CW, SOH);
    gfx_setfont(5, "Consolas", CF(S(13))); rc(K_DIM2, 1); ctxt("+", x, SOY + (SOH - S(13)) / 2, CW);
  ) : (rc(K_OUTB, 1); frame(x, SOY, CW, SOH););
  chslot == k && k <= chlen ? (rc(K_FOC, 0.8); frame(x - 1, SOY - 1, CW + 2, SOH + 2););
  k += 1;
);

// ---- pages + step numbers ----
// tap record button (v0.42): red when on, hit counter while recording
RCX > 0 ? (
  slider17 >= 0.5 ? (rc(K_ACC, 1); gfx_rect(RCX, PGY, RRW, PGH);) : (rc(K_BTN, 1); gfx_rect(RCX, PGY, RRW, PGH); rc(K_FLDB, 1); frame(RCX, PGY, RRW, PGH););
  rc(slider17 >= 0.5 ? K_CTX : K_ACC, 1); gfx_circle(RCX + S(9), PGY + PGH / 2, S(3), 1, 1);
  gfx_setfont(4, "Bahnschrift", CF(S(12)), 'b'); slider17 >= 0.5 ? rc(K_CTX, 1) : rc(K_TXT, 1);
  slider17 >= 0.5 && trecn > 0 ? sprintf(#t, "%d", trecn) : strcpy(#t, "REC");
  ctxt(#t, RCX + S(14), PGY + (PGH - S(12)) / 2 - 1, RRW - S(14));
  // CAL: orange while calibrating (taps so far), else the compensation in ms (grey = 0)
  cx_ = RCX + RRW + S(4); cw_ = RCW - RRW - S(4);
  calon ? (rc(K_FOC, 1); gfx_rect(cx_, PGY, cw_, PGH);) : (rc(K_BTN, 1); gfx_rect(cx_, PGY, cw_, PGH); rc(K_FLDB, 1); frame(cx_, PGY, cw_, PGH););
  gfx_setfont(4, "Bahnschrift", CF(S(11)), 'b');
  calon ? (rc(K_FOCT, 1); sprintf(#t, "%d/8", caln);) : slider18 != 0 ? (rc(K_TXT, 1); sprintf(#t, "%dms", slider18);) : (rc(K_DIM, 1); strcpy(#t, "CAL"););
  ctxt(fit(#t, cw_ - S(2)), cx_, PGY + (PGH - S(11)) / 2 - 1, cw_);
  caldone ? (caldone = 0; sprintf(#rd, "CAL DONE · you play %d ms %s · recorded hits are corrected", abs(slider18), slider18 >= 0 ? "late" : "early"); msgt = now;);
  trecn != ltrecn ? (ltrecn = trecn; bump(););   // recorded hits mark the project changed
);
gfx_setfont(3, "Bahnschrift", CF(S(12)), 'b'); rc(K_LBL, 1); txt("PAGE", MG, PGY + (PGH - S(12)) / 2);
i = 0;
loop(4,
  x = pbx(i);
  btn(x, PGY, PBW, PGH, "", i == page, 1);
  gfx_setfont(4, "Bahnschrift", CF(S(13)), 'b');
  i == page ? rc(K_FOCT, 1) : i * 16 < LEN[focus] ? rc(K_TXT, 1) : rc(K_DIM2, 1);
  sprintf(#n, "%d", i + 1); ctxt(#n, x, PGY + (PGH - S(13)) / 2 - 1, PBW);
  CUR[focus] >= 0 && floor(CUR[focus] / 16) == i ? (
    i == page ? rc(K_FOCT, 1) : rc(K_ACC, 1);
    gfx_circle(x + PBW - S(6), PGY + S(6), S(2), 1, 1);
  );
  i += 1;
);
gfx_setfont(5, "Consolas", CF(S(12)));
k = 0;
loop(16,
  k % 4 == 0 ? rc(K_TXT, 0.85) : rc(K_DIM2, 1);
  sprintf(#n, "%02d", page * 16 + k + 1); ctxt(#n, cellx(k), PGY + (PGH - S(12)) / 2, CW);
  k += 1;
);

// ---- view tabs ----
gfx_setfont(3, "Bahnschrift", CF(S(12)), 'b'); rc(K_LBL, 1); txt("VIEW", MG, TBY + (TBH - S(12)) / 2);
i = 0; loop(NTAB, btn(GX + i * (TABW + S(6)), TBY, TABW, TBH, tabname(tabat(i)), tabat(i) == tab, tabat(i) != 6 || anypit); i += 1;);
// v0.41.1 pitch hints: L1/L2 PITCH lock on a PIT lane = knob pitch on a note-playing part (use the PITCH tab instead);
// PITCH tab on a PIT-off lane = semitones are stored but not played
tab == 5 ? (
  pwarn = (plk == 4 || plk == 11) && PON[focus];
  plgroup(pwarn);
  gfx_setfont(3, "Bahnschrift", CF(S(10)), 'b');   // v0.58.5: hint (or the PIT warning) right of RANGE
  pwarn ? (rc(K_HOT, 1); sprintf(#t, "PART %d PIT ON: use the PITCH tab", focus + 1);) : (rc(K_DIM, 1); strcpy(#t, "height = value · Alt = reset"););
  txt(fit(#t, PHW), PHX, TBY + (TBH - S(10)) / 2);
);
(tab > 0 && tab < 5) || tab == 6 ? (
  gfx_setfont(3, "Bahnschrift", CF(S(10)), 'b');
  tab == 6 && !PON[focus] ? (
    rc(K_HOT, 1); sprintf(#t, "PART %d PIT OFF: semitones not played · turn PIT on", focus + 1);
    txt(fit(#t, PARW - S(6)), PARX + S(6), TBY + (TBH - S(10)) / 2);
  ) : (
    rc(K_DIM, 1); txt(fit(tab == 6 ? "height = semitones · Alt = 0" : "height = value · Alt = reset", PARW - S(6)), PARX + S(6), TBY + (TBH - S(10)) / 2);
  );
);

// ---- lanes ----
mw = (GW - (NSTEP - 1)) / NSTEP;
p = 0;
loop(NP,
  y0 = laney(p); act = p == focus; ly1_ = lrow1(p); ly2_ = lrow2(p);
  // lane strip: everything for this lane visible
  act ? (
    rc(K_FOC, 0.25); frame(MG - 2, y0 - 2, TW + 4, LH + 4); frame(MG - 1, y0 - 1, TW + 2, LH + 2);
    rc(K_PNLF, 1); gfx_rect(MG, y0, TW, LH);
    rc(K_FOC, 1); frame(MG, y0, TW, LH);
  ) : (
    rc(K_PNL, 1); gfx_rect(MG, y0, TW, LH);
    rc(K_PNLB, 1); frame(MG, y0, TW, LH);
  );
  // row 1: name · LEN · RATE · M · S
  gfx_setfont(4, "Bahnschrift", S(18), 'b'); rc(K_TXT, 1);
  lm_ = lmute(p); ls_ = (slider14 | 0) & (2 ^ p);
  sprintf(#t, "PART %d", p + 1);
  ls_ ? (gfx_setfont(4, "Bahnschrift", S(20), 'b'); rc(K_ALT, 1); txt(#t, LSX, ly1_ + (R1H - S(20)) / 2);)
      : (lm_ ? rc(K_DIM2, 1); txt(#t, LSX, ly1_ + (R1H - S(18)) / 2););
  lm_ ? (gfx_measurestr(#t, nw_, nh_); rc(K_DIM2, 1); gfx_rect(LSX - S(2), ly1_ + R1H / 2, nw_ + S(4), S(2)););   // silent = struck through
  // M / S buttons
  BTNFS = S(12); btn(MUTX, ly1_, MSBW, R1H, "M", (slider13 | 0) & (2 ^ p), 1);
  ls_ ? (rc(K_ALT, 1); gfx_rect(SOLX, ly1_, SOLW, R1H); gfx_setfont(4, "Bahnschrift", S(12), 'b'); rc(K_BG2, 1); ctxt("S", SOLX, ly1_ + (R1H - S(12)) / 2 - 1, SOLW);)
      : btn(SOLX, ly1_, SOLW, R1H, "S", 0, 1);
  BTNFS = 0;
  gfx_setfont(4, "Bahnschrift", S(18), 'b'); rc(K_TXT, 1);
  // soloed lane: blue-grey bar on the left edge · silent lane: grey bar + dimmed cells (end of the lane)
  (slider14 | 0) & (2 ^ p) ? (rc(K_ALT, 1); gfx_rect(MG + 1, y0 + 1, S(4), LH - 2);) : lm_ ? (rc(K_DIM2, 1); gfx_rect(MG + 1, y0 + 1, S(4), LH - 2););
  gfx_setfont(3, "Bahnschrift", CF(S(11)), 'b'); rc(K_LBL, 1);
  txt("LEN", LSX + S(66), ly1_ + (R1H - S(13)) / 2); txt("RATE", LSX + S(144), ly1_ + (R1H - S(13)) / 2);
  lhot = (drag == 5 && (dlane == p || dall)) || (drag == 2 && dall) || (hreg == 5 && hp == p);
  sprintf(#t, "%d", LEN[p]); vbox(LENX, ly1_, LENW, R1H, #t, lhot, S(13));
  rhot = (drag == 3 && (dlane == p || dall)) || (hreg == 4 && hp == p);
  vbox(RATX, ly1_, RATW, R1H, rname(RATE[p]), rhot, S(13));
  // row 2: direction · swing · humanize time + velocity
  rc(K_FLD, 1); gfx_rect(DIRX, ly2_, DIRW, R2H);
  hreg == 10 && hp == p ? rc(K_FOC, 1) : rc(K_FLDB, 1); frame(DIRX, ly2_, DIRW, R2H);
  DIR[p] == 0 ? rc(K_LBL, 1) : rc(K_TXT, 1);
  dcx = DIRX + DIRW / 2; dcy = ly2_ + R2H / 2;
  DIR[p] == 0 ? gfx_triangle(dcx - S(3), dcy - S(4), dcx - S(3), dcy + S(4), dcx + S(4), dcy)
  : DIR[p] == 1 ? gfx_triangle(dcx + S(3), dcy - S(4), dcx + S(3), dcy + S(4), dcx - S(4), dcy)
  : DIR[p] == 2 ? (gfx_triangle(dcx - S(7), dcy, dcx - S(1), dcy - S(4), dcx - S(1), dcy + S(4));
                   gfx_triangle(dcx + S(7), dcy, dcx + S(1), dcy - S(4), dcx + S(1), dcy + S(4));)
  : (gfx_setfont(3, "Bahnschrift", CF(S(12)), 'b'); ctxt("?", DIRX, ly2_ + (R2H - S(12)) / 2 - 1, DIRW););
  gfx_setfont(3, "Bahnschrift", CF(S(10)), 'b'); rc(K_LBL, 1);
  txt(DIR[p] == 0 ? "FWD" : DIR[p] == 1 ? "BACK" : DIR[p] == 2 ? "P-P" : "RAND", LSX + S(30), ly2_ + (R2H - S(10)) / 2);
  gfx_setfont(3, "Bahnschrift", CF(S(11)), 'b'); rc(K_LBL, 1);
  txt("HUM", LSX + S(144), ly2_ + (R2H - S(13)) / 2);
  GRV[p] ? (rc(K_ACC, 1); txt("GRV", LSX + S(66), ly2_ + (R2H - S(13)) / 2);) : txt("SWG", LSX + S(66), ly2_ + (R2H - S(13)) / 2);
  GRV[p] ? vboxc(SWGX, ly2_, SWGW, R2H, gshort(GRV[p]), ((drag == 9 || drag == 24) && (focus == p || dall)) || (hreg == 9 && hp == p), S(12), K_ACC)   // v0.56: groove in the box
  : (sprintf(#t, "%d%%", lsw(p));
     vboxc(SWGX, ly2_, SWGW, R2H, #t, (drag == 9 && (focus == p || dall)) || (hreg == 9 && hp == p), S(12), SW[p] >= 50 ? K_TXT : K_DIM););   // grey = follows global
  sprintf(#t, "%d%%", HT[p]); vboxc(HTX, ly2_, HTW, R2H, #t, (drag == 6 && focus == p) || (hreg == 6 && hp == p), S(12), HT[p] > 0 ? K_TXT : K_DIM);
  sprintf(#t, "%d%%", HV[p]); vboxc(HVX, ly2_, HVW, R2H, #t, (drag == 7 && focus == p) || (hreg == 7 && hp == p), S(12), HV[p] > 0 ? K_TXT : K_DIM);
  // pitch: OFF (grey) or the base note (lane plays base + step pitch on ch 11-16)
  gfx_setfont(3, "Bahnschrift", CF(S(11)), 'b'); rc(K_LBL, 1); txt("PIT", LSX + S(260), ly2_ + (R2H - S(13)) / 2);
  vboxc(PITX, ly2_, PITW, R2H, PON[p] ? nname(PBNOTE[p]) : "OFF", (drag == 19 && (dlane == p || dall)) || (hreg == 19 && hp == p), S(12), PON[p] ? K_TXT : K_DIM);

  // overview strip: all 64 steps (drag = length)
  s = 0;
  loop(NSTEP,
    x = GX + s * (mw + 1);
    CUR[p] == s ? rc(K_PLY, 1)
    : s < LEN[p] ? (ON[p * NSTEP + s] ? rc(K_OVON, 1) : rc(K_OVIN, s >= page * 16 && s < page * 16 + 16 ? 1 : 0.55))
    : rc(K_PNL, 1);
    gfx_rect(x, y0, max(1, mw), OVH);
    s += 1;
  );
  x = GX + LEN[p] * (mw + 1) - 1;
  lhot = (drag == 2 && dlane == p) || (hreg == 2 && hp == p);
  lhot ? (rc(K_ACC, 0.3); gfx_rect(x - S(4), y0 - S(3), S(7), OVH + S(6)););
  rc(K_ACC, 1); gfx_rect(x - S(1), y0 - S(2), S(3), OVH + S(4));

  // step cells of the current page
  k = 0;
  loop(16,
    s = page * 16 + k; idx = p * NSTEP + s; x = cellx(k); y = y0 + CY0;
    s >= LEN[p] ? (
      rc(K_OUT, 1); gfx_rect(x, y, CW, CH); rc(K_OUTB, 1); frame(x, y, CW, CH);
    ) : (
      rc(K_CEL, 1); gfx_rect(x, y, CW, CH);
      ON[idx] && tab == 5 ? (
        // P-LOCK tab: bar = locked value, thin line = panel value, "-" = not locked
        rc(K_ACC, 0.16); gfx_rect(x, y, CW, CH);
        lv = PL[idx * NPL + plk]; lr_ = (lv >= 128 ? floor(lv / 128) : 0); lv >= 0 ? (lv = lv % 128;);
        gfx_setfont(5, "Consolas", CF(S(11)));
        lv >= 0 ? (
          bh = max(1, lv / 127 * (CH - S(2))); rc(K_ALT, lr_ > 0 ? 0.35 : 0.95); gfx_rect(x + S(2), y + CH - bh - S(1), CW - S(4), bh);
          lr_ > 0 ? (   // random range: band value - range .. value + range; RANGE mode = edges lit, VALUE mode = value line lit
            yt_ = y + CH - S(1) - min(127, lv + lr_) / 127 * (CH - S(2)); yb_ = y + CH - S(1) - max(0, lv - lr_) / 127 * (CH - S(2));
            rc(K_TXT, 0.2); gfx_rect(x + S(2), yt_, CW - S(4), max(1, yb_ - yt_));
            plrng ? rc(K_FOC, 1) : rc(K_TXT, 0.6); ew_ = (plrng ? S(2) : 1); gfx_rect(x + S(2), yt_, CW - S(4), ew_); gfx_rect(x + S(2), yb_ - ew_ + 1, CW - S(4), ew_);
            yv_ = y + CH - S(1) - bh; plrng ? rc(K_TXT, 0.8) : rc(K_FOC, 1); gfx_rect(x + S(2), yv_ - (plrng ? 0 : S(1)), CW - S(4), plrng ? 1 : S(3));
            // last value really sent (tick on the right edge): jumps every loop while playing
            yr_ = y + CH - S(1) - LKR[idx * NPL + plk] / 127 * (CH - S(2)); rc(K_TXT, 1); gfx_rect(x + CW - S(10), yr_ - S(1), S(8), S(3));
          );
          rc(K_TXT, 0.95); sprintf(#t, "%d", lv); ctxt(#t, x, y + S(2), CW);
          lr_ > 0 ? (sprintf(#t, "±%d", lr_); ctxt(#t, x, y + S(14), CW););
        ) : (rc(K_TXT, 0.35); ctxt("-", x, y + S(2), CW););
        pnl ? (pv = gmem[1000 + pidx(p, plk)]; rc(K_TXT, 0.6); gfx_rect(x + S(2), y + CH - S(1) - pv / 127 * (CH - S(2)), CW - S(4), 1););
      ) : ON[idx] && tab > 0 ? (
        // value tab: the step's value as a bar (offset from the middle line), value text on top
        rc(K_ACC, 0.16); gfx_rect(x, y, CW, CH);
        tab == 1 ? (bv = VEL[idx] / 127; rc(K_ACC, 0.95);)
        : tab == 2 ? (bv = CHN[idx] / 100; rc(K_ALT, 0.95);)
        : tab == 3 ? (bv = min(SLC[idx], 5) / 5; rc(K_TXT, 0.85);)
        : tab == 6 ? (bv = PIT[idx] / 48; PON[p] ? rc(K_ACC, 0.95) : rc(K_TXT, 0.45);)
        : (bv = OFS[idx] / 80; rc(K_TXT, 0.85););
        tab == 4 || tab == 6 ? (
          bh = abs(bv) * CH; bv >= 0 ? gfx_rect(x + S(2), y + CH / 2 - bh, CW - S(4), max(1, bh)) : gfx_rect(x + S(2), y + CH / 2, CW - S(4), max(1, bh));
          rc(K_TXT, 0.35); gfx_rect(x + S(2), y + CH / 2, CW - S(4), 1);
        ) : (
          bh = max(1, bv * (CH - S(2))); gfx_rect(x + S(2), y + CH - bh - S(1), CW - S(4), bh);
        );
        gfx_setfont(5, "Consolas", CF(S(11))); rc(K_TXT, 0.95);
        tab == 1 ? sprintf(#t, "%d", VEL[idx]) : tab == 2 ? sprintf(#t, "%d", CHN[idx]) :
        tab == 3 ? strcpy(#t, slname(SLC[idx])) : tab == 6 ? sprintf(#t, "%+d", PIT[idx]) : sprintf(#t, "%+d", OFS[idx]);
        ctxt(#t, x, y + S(2), CW);
        // PITCH tab: the played note at the bottom (lane PIT on)
        tab == 6 && PON[p] ? (rc(K_TXT, 0.7); ctxt(nname(max(0, min(127, PBNOTE[p] + PIT[idx]))), x, y + CH - S(13), CW););
      ) : ON[idx] == 2 ? (
        // TRIGLESS: no note fill, 2 px frame + "LOCK" and how many params it changes
        rc(K_ALT, 0.14); gfx_rect(x, y, CW, CH);
        rc(K_ALT, 1); frame(x, y, CW, CH); frame(x + 1, y + 1, CW - 2, CH - 2);
        gfx_setfont(5, "Consolas", CF(S(10)));
        ctxt("LOCK", x, y + CH / 2 - S(10), CW);
        sprintf(#t, "%d", haslk(idx)); haslk(idx) ? ctxt(#t, x, y + CH / 2 + S(1), CW) : (rc(K_ACC, 1); ctxt("0", x, y + CH / 2 + S(1), CW););
        CHN[idx] < 100 ? (rc(K_TXT, 0.92); sprintf(#t, "%d%%", CHN[idx]); txt(#t, x + S(4), y + S(4)););
        CND[idx] > 0 ? (rc(K_TXT, 0.92); rtxt(CNM[CND[idx]], x + CW - S(4), y + S(4 + (CHN[idx] < 100) * 11)););
      ) : ON[idx] ? (
        rc(K_ACC, 0.22 + 0.78 * VEL[idx] / 127); gfx_rect(x, y, CW, CH);
        rc(K_ACC, 0.6); frame(x, y, CW, CH);
        rc(K_CTX, 0.6); gfx_rect(x + S(4), y + CH - S(5), max(1, (CW - S(8)) * VEL[idx] / 127), S(2));
        gfx_setfont(5, "Consolas", CF(S(10)));
        CHN[idx] < 100 ? (rc(K_CTX, 0.92); sprintf(#t, "%d%%", CHN[idx]); txt(#t, x + S(4), y + S(3)););
        CND[idx] > 0 || (CHN[idx] < 100 && CTG[idx] > 0) ? (
          rc(K_CTX, 0.92); strcpy(#t, CND[idx] > 0 ? CNM[CND[idx]] : ""); CTG[idx] == 1 ? strcat(#t, ">S") : CTG[idx] == 2 ? strcat(#t, ">L");
          rtxt(#t, x + CW - S(4), y + S(3 + (CHN[idx] < 100 && CND[idx] > 0) * 11));
        );
        SLC[idx] > 0 ? (rc(K_CTX, 0.92); ctxt(slname(SLC[idx]), x, y + CH - S(19), CW););
        PON[p] && PIT[idx] != 0 ? (rc(K_CTX, 0.92); sprintf(#t, "%+d", PIT[idx]); ctxt(#t, x, y + CH / 2 - S(9), CW););   // step pitch
        SLC[idx] > 0 && RMP[idx] != 0 ? (
          rc(K_CTX, 0.85); wx = x + CW - S(15); wy = y + CH / 2 - S(4);
          RMP[idx] > 0 ? gfx_triangle(wx, wy + S(8), wx + S(11), wy + S(8), wx + S(11), wy)
                       : gfx_triangle(wx, wy, wx, wy + S(8), wx + S(11), wy + S(8));
        );
        haslk(idx) ? (rc(K_ALT, 1); gfx_circle(x + S(7), y + CH - S(12), S(3), 1, 1););   // has p-locks
        OFS[idx] != 0 ? (rc(K_CTX, 0.9); gfx_rect(x + CW / 2 + OFS[idx] / 100 * CW - S(1), y + S(2), S(2), S(7)););
      );
      // frames: current step (2 px), hover, empty cell border
      CUR[p] == s ? (
        rc(K_PLY, ON[idx] ? 1 : 0.5); frame(x, y, CW, CH); frame(x + 1, y + 1, CW - 2, CH - 2);
      ) : hreg == 3 && hp == p && hk == k ? (
        rc(K_LBL, 1); frame(x, y, CW, CH);
      ) : !(ON[idx] && tab == 0) ? (
        rc(K_CELB, 1); frame(x, y, CW, CH);
      );
      SELM[idx] ? (
        rc(K_SEL, 1); frame(x - 2, y - 2, CW + 4, CH + 4);
        selp == p && sels == s ? frame(x - 3, y - 3, CW + 6, CH + 6);   // main step: thicker
      );
      s == LEN[p] - 1 ? (rc(K_ACC, 1); gfx_rect(x + CW - S(3), y, S(3), CH););   // lane ends here
    );
    k += 1;
  );
  lm_ ? (rc(K_BG2, 0.6); gfx_rect(GX, y0, GW, LH););   // silent lane: cells dimmed
  p += 1;
);
// ---- ACCENT row (v0.39, Classic): strip = LEN, RATE, PARTS, AMT; cells = accent steps of the current page ----
ACH > 0 ? (
  // own color: FOC (the orange of active buttons) instead of the red note color, so the row reads apart from the lanes
  rc(K_PNL, 1); gfx_rect(MG, ACY, TW, ACH); rc(K_FOC, 0.07); gfx_rect(MG, ACY, TW, ACH);
  rc(K_FOC, 0.6); frame(MG, ACY, TW, ACH); rc(K_FOC, 1); gfx_rect(MG + 1, ACY + 1, S(4), ACH - 2);
  gfx_setfont(4, "Bahnschrift", S(16), 'b'); (theme == 7 || theme == 8 || theme == 13) ? rc(K_HOT, 1) : rc(K_FOC, 1); txt("ACCENT", LSX, AY1 + (R1H - S(16)) / 2);   // light themes: darker orange
  gfx_setfont(3, "Bahnschrift", CF(S(11)), 'b'); rc(K_LBL, 1);
  txt("LEN", LSX + S(66), AY1 + (R1H - S(13)) / 2); txt("RATE", LSX + S(144), AY1 + (R1H - S(13)) / 2);
  txt("PARTS", LSX, AY2 + (R2H - S(13)) / 2);
  sprintf(#t, "%d", AC[64]); vbox(LENX, AY1, LENW, R1H, #t, drag == 91 || hreg == 91, S(13));
  vbox(RATX, AY1, RATW, R1H, rname(AC[65]), drag == 92 || hreg == 92, S(13));
  // PARAM box (accent colored when any param has an amount) + amount of the shown param
  acany = (AC[69] != 0); i = 0; loop(26, ACP[i] != 0 ? (acany += 1;); i += 1;);
  rc(K_FLD, 1); gfx_rect(APX, AY2, APW, R2H); hreg == 95 ? rc(K_FOC, 1) : rc(K_FLDB, 1); frame(APX, AY2, APW, R2H);
  gfx_setfont(5, "Consolas", CF(S(11))); acget(acsel) != 0 ? rc(K_TXT, 1) : rc(K_DIM, 1);
  acoth = acany - (acsel > 0 && acget(acsel) != 0);   // other params with an amount
  strcpy(#t, acsel == 0 ? "VEL" : acsel == NPL + 1 ? "NOTE" : pname(acsel - 1)); acoth > 0 ? (sprintf(#n, " +%d", acoth); strcat(#t, #n););
  ctxt(fit(#t, APW - S(6)), APX, AY2 + (R2H - S(11)) / 2, APW);
  sprintf(#t, "%+d", acget(acsel)); vboxc(AMX, AY2, AMW, R2H, #t, drag == 93 || hreg == 93, S(12), acget(acsel) != 0 ? K_TXT : K_DIM);
  BTNFS = S(12); i = 0;
  loop(6, sprintf(#t, "%d", i + 1); btn(AKX0 + i * (AKW + S(4)), AY2, AKW, R2H, #t, (AC[67] | 0) & (2 ^ i), 1); i += 1;);
  BTNFS = 0;
  // overview strip: all 64 accent steps (drag = length), like the lanes
  s = 0;
  loop(NSTEP,
    x = GX + s * (mw + 1);
    ACUR == s ? rc(K_PLY, 1)
    : s < AC[64] ? (AC[s] ? rc(K_FOC, 1) : rc(K_OVIN, s >= page * 16 && s < page * 16 + 16 ? 1 : 0.55))
    : rc(K_PNL, 1);
    gfx_rect(x, ACY, max(1, mw), OVH);
    s += 1;
  );
  x = GX + AC[64] * (mw + 1) - 1;
  drag == 96 || hreg == 96 ? (rc(K_FOC, 0.3); gfx_rect(x - S(4), ACY - S(3), S(7), OVH + S(6)););
  rc(K_FOC, 1); gfx_rect(x - S(1), ACY - S(2), S(3), OVH + S(4));
  ACCH = ACH - CY0;
  k = 0;
  loop(16,
    s = page * 16 + k; x = cellx(k); y = ACY + CY0;
    s >= AC[64] ? (
      rc(K_OUT, 1); gfx_rect(x, y, CW, ACCH); rc(K_OUTB, 1); frame(x, y, CW, ACCH);
    ) : (
      rc(K_CEL, 1); gfx_rect(x, y, CW, ACCH); rc(K_FOC, 0.05); gfx_rect(x, y, CW, ACCH);
      AC[s] ? (
        rc(K_FOC, 0.85); gfx_rect(x, y, CW, ACCH); rc(K_FOC, 1); frame(x, y, CW, ACCH);
        rc(K_FOCT, 0.95); ax_ = x + CW / 2; ay_ = y + ACCH / 2;   // accent mark ">"
        gfx_triangle(ax_ - S(6), ay_ - S(7), ax_ - S(6), ay_ - S(4), ax_ + S(6), ay_ + S(1), ax_ + S(6), ay_ - S(2));
        gfx_triangle(ax_ - S(6), ay_ + S(7), ax_ - S(6), ay_ + S(4), ax_ + S(6), ay_ - S(1), ax_ + S(6), ay_ + S(2));
      );
      ACUR == s ? (rc(K_PLY, AC[s] ? 1 : 0.5); frame(x, y, CW, ACCH); frame(x + 1, y + 1, CW - 2, ACCH - 2);)
      : hreg == 90 && hk == k ? (rc(K_LBL, 1); frame(x, y, CW, ACCH);)
      : !AC[s] ? (rc(K_CELB, 1); frame(x, y, CW, ACCH););
      s == AC[64] - 1 ? (rc(K_FOC, 1); gfx_rect(x + CW - S(3), y, S(3), ACCH););   // row ends here
    );
    k += 1;
  );
  !(AC[67] | 0) || (AC[66] == 0 && !acany) ? (rc(K_BG2, 0.6); gfx_rect(GX, ACY, GW, ACH););   // no part listens / nothing to do: dimmed
);
// Ctrl+drag rectangle
drag == 20 && dmoved ? (
  ka = max(0, min(bs0, bs1) - page * 16); kb = min(15, max(bs0, bs1) - page * 16);
  ka <= kb ? (
    x = cellx(ka) - S(3); x2 = cellx(kb) + CW + S(3);
    y = laney(min(bp0, bp1)) + CY0 - S(3); y2 = laney(max(bp0, bp1)) + LH + S(3);
    rc(K_TXT, 0.08); gfx_rect(x, y, x2 - x, y2 - y);
    rc(K_SEL, 0.9); frame(x, y, x2 - x, y2 - y);
  );
);

// ---- bottom strip (layout B, v0.45): full width, mode tabs STEP GEN TOOLS BEAT FEEL ROUTE on top ----
rc(K_PNL, 1); gfx_rect(BCX, EY, BCW, EDH); rc(K_PNLB, 1); frame(BCX, EY, BCW, EDH); gfx_rect(BCX, EY + BTH - 1, BCW, 1);
BTNFS = CF(S(15)); i = 0;   // mode tabs: bigger than the buttons below (13)
loop(NMB, btn(MBX + i * (MBW + MBG), MBY, MBW, MBH, mbname(mbat(i)), mbat(i) == smode, 1); i += 1;);
BTNFS = 0;
gfx_setfont(3, "Bahnschrift", CF(S(12))); rc(K_LBL, 1);
rtxt(smode == 0 ? "values of the selected steps" : smode == 1 ? "euclid rhythms + randomize" : smode == 2 ? "copy, clear, reset, undo"
   : smode == 3 ? "roll a whole beat in a genre style" : smode == 4 ? "groove of the focused lane" : smode == 5 ? "send the hits to other tracks" : "the sound of each pattern", BCX + BCW - S(12), EY + (BTH - S(12)) / 2);
// LOOK icon (half-filled square) + COLOR swatch (accent color) in the title block; hover = name in the readout
lkhit ? rc(K_FOC, 1) : rc(K_LBL, 0.8); frame(LKX, THY, LKW, THH); gfx_rect(LKX + S(3), THY + S(3), (LKW - S(6)) / 2, THH - S(6));
rc(K_ACC, 1); gfx_rect(THX + S(2), THY + S(2), THW - S(4), THH - S(4)); thhit ? rc(K_FOC, 1) : rc(K_LBL, 0.8); frame(THX, THY, THW, THH);
icohov = (lkhit ? 1 : thhit ? 2 : 0);
icohov != lasthov ? (
  icohov == 1 ? (strcpy(#rd, "LOOK · CLASSIC · click = SLEEVE"); msgt = now;) : icohov == 2 ? (sprintf(#rd, "COLOR · %s · click = list, wheel = next", thname(theme)); msgt = now;);
  lasthov = icohov;
);

six = selidx();
smode == 0 ? (
  // STEP: values of the selected step(s)
  x = fldx(0);
  gfx_setfont(3, "Bahnschrift", CF(S(13)), 'b'); rc(K_LBL, 1); txt("SELECTED", x, BCY + S(8));
  gfx_setfont(4, "Bahnschrift", CF(S(17)), 'b'); rc(K_TXT, 1);
  nsel > 1 ? sprintf(#t, "%d STEPS", nsel) : sprintf(#t, "P%d · STEP %02d", selp + 1, sels + 1);
  txt(fit(#t, FW + S(8)), x, FBY + (FBH - S(17)) / 2);
  // v0.58.5: TRIGLESS toggle button (lit = trigless) replaces the ON / OFF / TRIGLESS status line
  btn(x, TGY, FW, TGH, "TRIGLESS", ON[six] == 2, 1);
  hreg == 81 ? (rc(K_TXT, 0.7); frame(x - 1, TGY - 1, FW + 2, TGH + 2););
  f = 1;
  loop(8,
    x = fldx(fldpos(f));
    gfx_setfont(3, "Bahnschrift", CF(S(13)), 'b'); rc(K_LBL, 1);
    txt(f == 1 ? "VELOCITY" : f == 2 ? "SLICE" : f == 3 ? "CONDITION" : f == 4 ? "OFFSET" : f == 6 ? "RAMP" : f == 7 ? "PITCH" : f == 8 ? "IF → ONLY" : "CHANCE", x, BCY + S(8));
    f == 1 ? sprintf(#t, "%d", VEL[six]) : f == 2 ? strcpy(#t, slname(SLC[six])) :
    f == 3 ? strcpy(#t, CNM[CND[six]]) : f == 4 ? sprintf(#t, "%+d%%", OFS[six]) :
    f == 8 ? strcpy(#t, tgname(CTG[six])) :
    f == 7 ? (PON[selp] ? sprintf(#t, "%+d %s", PIT[six], nname(max(0, min(127, PBNOTE[selp] + PIT[six])))) : sprintf(#t, "%+d", PIT[six])) :
    f == 6 ? (RMP[six] == 0 ? strcpy(#t, "-") : sprintf(#t, "%+d%%", RMP[six])) : sprintf(#t, "%d%%", CHN[six]);
    vboxc(x, FBY, FW, FBH, #t, drag == 10 + f || hreg == 10 + f, S(16), (f == 7 && !PON[selp]) || (f == 8 && CTG[six] == 0) ? K_DIM : K_TXT);
    f == 1 ? (rc(K_ACC, 0.9); gfx_rect(x + 1, FBY + FBH - S(3), max(1, (FW - 2) * VEL[six] / 127), S(2)););
    f == 5 ? (rc(K_ALT, 0.9); gfx_rect(x + 1, FBY + FBH - S(3), max(1, (FW - 2) * CHN[six] / 100), S(2)););
    f == 4 ? (rc(K_TXT, 0.8); gfx_rect(x + FW / 2 + OFS[six] / 100 * FW - S(1), FBY + FBH - S(5), S(2), S(4)););
    gfx_setfont(3, "Bahnschrift", CF(S(11))); rc(K_DIM, 1);
    txt(fit(f == 1 ? "63 = panel level" : f == 2 ? "o = hit  _ = rest" : f == 3 ? "A:B · 1st · fill · pre · nei" : f == 4 ? "early - / late +" : f == 6 ? "+ louder / - softer" : f == 7 ? (PON[selp] ? "semitones" : "lane PIT is off") : f == 8 ? "what the IF hits" : "dice roll per step", FW),
        x, FBY + FBH + S(4));
    f += 1;
  );
);
);

skin ? (
  // ================= SLEEVE LOOK (flat, condensed font, outlined numbers; colors = theme 1-12) =================
  rc(K_BG2, 1); gfx_rect(0, 0, gfx_w, gfx_h);
  ta_ = TINTA[theme];

  // ---- header: inverted title block · status with 2 slanted stripes · TRANSPORT / PATTERN / FEEL groups ----
  rc(K_PLY, 1); gfx_rect(0, HDY, TTW, HDH);
  rc(K_BG2, 1);
  gfx_setfont(1, #sf, S(36), 'b'); txt("VOLCA", S(16), HDY + S(4)); txt("DRUM", S(16), HDY + S(34));
  sfont(3, S(14)); slcur_ = 0; txt("S E Q U E N C E R", S(17), HDY + S(68));
  gfx_setfont(5, #sf, S(14)); rc(K_BG2, 0.7); txt("v1.0 · sleeve", S(17), HDY + S(86));   // bump on every change
  // LOOK icon (half-filled square) + COLOR swatch in the title block, like Classic; hover = name in the status
  rc(K_BG2, lkhit ? 1 : 0.75); frame2(LKX, THY, LKW, THH, S(2)); gfx_rect(LKX + S(4), THY + S(4), (LKW - S(8)) / 2, THH - S(8));
  rc(K_BG2, 1); gfx_rect(THX, THY, THW, THH); rc(K_ACC, 1); gfx_rect(THX + S(3), THY + S(3), THW - S(6), THH - S(6));
  thhit ? (rc(K_BG2, 1); frame(THX - S(2), THY - S(2), THW + S(4), THH + S(4)););
  icohov = (lkhit ? 1 : thhit ? 2 : 0);
  icohov != lasthov ? (
    icohov == 1 ? (strcpy(#rd, "LOOK · SLEEVE · click = CLASSIC"); msgt = now;) : icohov == 2 ? (sprintf(#rd, "COLOR · %s · click = list, wheel = next", thname(theme)); msgt = now;);
    lasthov = icohov;
  );
  // status
  rc(K_ACC, 1);
  sd_ = 0.17 * HDH;
  slant(RDX + 0.86 * RDW - sd_ / 2, HDY, 0.02 * RDW, HDH, sd_);
  slant(RDX + 0.92 * RDW - sd_ / 2, HDY, 0.01 * RDW, HDH, sd_);
  sfont(3, S(15)); rc(K_DIM, 1); txt("S T A T U S", RDX + S(20), HDY + S(10));
  perr ? (rc(K_HOT, 0.55 + 0.45 * sin(now * 6)); gfx_rect(RDX + S(110), HDY + S(12), 0.84 * RDW - S(140), S(6)););   // v0.57.3 panel error
  sfont(2, S(28)); rc(K_TXT, (fresh ? 1 : 0.75) * (0.15 + 0.85 * r1e)); txt(fit(#r1, 0.84 * RDW - S(30)), RDX + S(20), HDY + S(28) + r1y);
  sfont(5, S(17)); rc(K_LBL, 1); txt(fit(#rd2, 0.84 * RDW - S(30)), RDX + S(20), HDY + S(66));
  // group labels + header buttons
  sfont(3, S(13)); rc(K_DIM, 1);
  txt("TRANSPORT", HBX + S(8), HDY + S(2)); txt("PATTERN", HB3X + S(8), HDY + S(2)); txt("FEEL · ALL LANES", DNX + S(8), HDY + S(2));
  shbtn(HBX, HBY1, HBW, HBH, ffree ? "SYNC FREE" : "SYNC REAPER", 0, 1);
  ffree ? shbtn(HB2X, HBY1, HBW, HBH, running ? "STOP" : "PLAY", running, 1)
        : shbtn(HB2X, HBY1, HBW, HBH, running ? "PLAYING" : "STOPPED", 0, 0);
  sprintf(#bp, "BPM %.1f", ffree && slider3 >= 0.5 ? slider2 : b_tempo);
  shbtn(HBX, HBY2, HBW, HBH, #bp, drag == 4, ffree && slider3 >= 0.5);
  shbtn(HB2X, HBY2, HBW, HBH, slider3 >= 0.5 ? "OWN TEMPO" : "PROJ TEMPO", 0, ffree);
  sprintf(#t, "MASTER %s", mname(slider6)); shbtn(HB3X, HBY1, HBW, HBH, #t, 0, 1);
  shbtn(HB3X, HBY2, HBW, HBH, "FILL", slider7 >= 0.5 || (running && afon), 1);
  // density (v0.53): bar from the middle, up = busier, down = thinner
  dn_ = SWH / 2 * abs(slider24) / 100; rc(K_ACC, 0.15 + 0.45 * abs(slider24) / 100);
  slider24 > 0 ? gfx_rect(DNX + S(4), SWY + SWH / 2 - dn_, DNW - S(4), dn_) : slider24 < 0 ? gfx_rect(DNX + S(4), SWY + SWH / 2, DNW - S(4), dn_);
  rc(K_LINE, 1); gfx_rect(DNX + S(4), SWY + floor(SWH / 2), DNW - S(4), 1);
  rc(K_PLY, 1); gfx_rect(DNX, SWY, S(4), SWH);
  sfont(4, S(32)); gfx_measurestr("0", sv_w, sv_h); SWVY = floor(SWY + SWH / 2 + (SWH / 2 - sv_h) / 2) - S(1);   // v0.58.3: value centered in the lower half (below the DENSITY zero line)
  sfont(3, S(15)); rc(K_LBL, 1); ctxt("DENSITY", DNX + S(4), SWY + S(4), DNW - S(4));
  sfont(4, S(32)); drag == 31 || hreg == 31 ? rc(K_FOC, 1) : slider24 == 0 ? rc(K_DIM, 1) : rc(K_TXT, 1);
  slider24 == 0 ? strcpy(#t, "0") : sprintf(#t, slider24 > 0 ? "+%d" : "%d", slider24); ctxt(#t, DNX + S(4), SWVY, DNW - S(4));
  // chaos: accent fill rises with the amount
  slider15 > 0 ? (rc(K_ACC, 0.15 + 0.45 * slider15 / 100); ch_ = SWH * slider15 / 100; gfx_rect(CHX + S(4), SWY + SWH - ch_, CHW - S(4), ch_););
  rc(K_PLY, 1); gfx_rect(CHX, SWY, S(4), SWH);
  sfont(3, S(15)); rc(K_LBL, 1); ctxt("CHAOS", CHX + S(4), SWY + S(4), CHW - S(4));
  sfont(4, S(32)); drag == 25 || hreg == 25 ? rc(K_FOC, 1) : slider15 == 0 ? rc(K_DIM, 1) : rc(K_TXT, 1);
  slider15 == 0 ? strcpy(#t, "OFF") : sprintf(#t, "%d%%", slider15); ctxt(#t, CHX + S(4), SWVY, CHW - S(4));
  // swing
  rc(K_PLY, 1); gfx_rect(SWX, SWY, S(4), SWH);
  sfont(3, S(15)); rc(K_LBL, 1); ctxt("SWING", SWX + S(4), SWY + S(4), SWW - S(4));
  sfont(4, S(32)); drag == 8 || hreg == 8 ? rc(K_FOC, 1) : gsw() == 50 ? rc(K_DIM, 1) : rc(K_TXT, 1);
  gsw() == 50 ? strcpy(#t, "OFF") : sprintf(#t, "%d%%", gsw()); ctxt(#t, SWX + S(4), SWVY, SWW - S(4));
  rc(K_PLY, 1); gfx_rect(0, HDY + HDH, gfx_w, S(6));

  // ---- pattern row ----
  sfont(3, S(16)); rc(K_LBL, 1); txt("PATTERN", MG, PTY + (PTH - S(16) * SFK) / 2);
  sfont(4, S(26)); rc(K_TXT, 1); sprintf(#t, "%02d", curpat + 1); rtxt(#t, MG + TW, PTY + (PTH - S(26) * SFK) / 2);
  k = 0;
  loop(NPAT,
    x = cellx(k); pu = patused(k);
    k == curpat ? (rc(K_FOC, 1); gfx_rect(x, PTY, CW, PTH);)
    : pu ? (rc(K_PLY, 1); frame2(x, PTY, CW, PTH, S(2));)
    : (rc(K_LINE, 1); frame2(x, PTY, CW, PTH, S(2)););
    k == dnext && dnext != curpat ? (rc(K_FOC, 0.5 + 0.5 * sin(now * 10)); frame2(x, PTY, CW, PTH, S(2)););
    i = 0; inch = 0; loop(chlen, CHL[i] == k ? (inch = 1;); i += 1;);
    inch ? (rc(K_ACC, slider10 >= 0.5 ? 1 : 0.45); gfx_rect(x + S(4), PTY + PTH - S(5), CW - S(8), S(3)););
    k == fillp ? (sfont(3, S(13)); k == curpat ? rc(K_FOCT, 1) : rc(K_FOC, 1); txt("F", x + CW - S(9), PTY + S(2)););
    kithas(k) ? (sfont(3, S(13)); k == curpat ? rc(K_FOCT, 1) : rc(K_ACC, 1); txt("K", x + S(4), PTY + S(2)););
    sfont(5, S(19));
    k == curpat ? rc(K_FOCT, 1) : pu ? rc(K_PLY, 1) : rc(K_DIM, 1);
    sprintf(#t, "%d", k + 1); ctxt(#t, x, PTY + (PTH - S(19)) / 2, CW);
    k += 1;
  );

  // ---- song row ----
  BTNBOLD = 1; btn(MG, SOY, SGCW, SOH, "CHAIN", slider10 >= 0.5, 1);
  btn(SGRX, SOY, SGRW, SOH, "REGIONS", slider22 >= 0.5, 1); BTNBOLD = 0;
  slider22 >= 0.5 && !rgalive ? (rc(K_HOT, 1); frame2(SGRX, SOY, SGRW, SOH, S(3)););   // no helper
  rc(K_LINE, 1); frame2(SGLX, SOY, SGLW, SOH, S(2));
  sfont(4, S(18)); chlen ? rc(K_LBL, 1) : rc(K_DIM, 1); ctxt("CLEAR", SGLX, SOY + (SOH - S(18) * SFK) / 2, SGLW); ctxt("CLEAR", SGLX + 1, SOY + (SOH - S(18) * SFK) / 2, SGLW);   // v0.58.7 bold
  fpx_ = SGFX; fpw_ = MG + TW - SGFX;
  fphit ? rc(K_FOC, 1) : rc(K_LINE, 1); frame2(fpx_, SOY, fpw_, SOH, S(2));
  sfont(3, S(15)); fw1_ = swid("FILL PAT");
  sfont(4, S(19)); fillp >= 0 ? sprintf(#t, "%02d", fillp + 1) : strcpy(#t, "--"); fw2_ = swid(#t);
  fxx_ = fpx_ + (fpw_ - fw1_ - S(6) - fw2_) / 2;
  fillp >= 0 ? rc(K_FOC, 1) : rc(K_DIM, 1); txt(#t, fxx_ + fw1_ + S(6), SOY + (SOH - S(16)) / 2);
  sfont(3, S(15)); rc(K_LBL, 1); txt("FILL PAT", fxx_, SOY + (SOH - S(15) * SFK) / 2); txt("FILL PAT", fxx_ + 1, SOY + (SOH - S(15) * SFK) / 2);   // v0.58.7 bold
  ca_ = (slider10 >= 0.5 ? 1 : 0.45);
  k = 0;
  loop(16,
    x = cellx(k);
    k < chlen ? (
      k == chdisp ? (rc(K_ACC, ca_); gfx_rect(x, SOY, CW, SOH); rc(K_BG2, 1);)
                  : (rc(K_ACC, ta_ * ca_); gfx_rect(x, SOY, CW, SOH); rc(K_ACC, ca_); frame2(x, SOY, CW, SOH, S(2)); rc(K_TXT, ca_););
      sfont(5, S(18)); sprintf(#t, "%d", CHL[k] + 1); ctxt(#t, x, SOY + (SOH - S(18) * SFK) / 2, CW);
    ) : k == chlen ? (
      rc(K_LINE, 1); dframe(x, SOY, CW, SOH); dframe(x + 1, SOY + 1, CW - 2, SOH - 2);
      sfont(5, S(19)); rc(K_DIM, 1); ctxt("+", x, SOY + (SOH - S(19) * SFK) / 2, CW);
    ) : (rc(K_LINE2, 1); gfx_rect(x, SOY, CW, SOH););
    chslot == k && k <= chlen ? (rc(K_FOC, 0.9); frame(x - 1, SOY - 1, CW + 2, SOH + 2););
    k += 1;
  );

  // ---- pages + step numbers (bottom aligned, beats bigger) ----
  // tap record: REC (accent fill when on, hit counter while recording) + CAL (focus fill while calibrating, else ms)
  rby_ = PGY + (PGH - S(28)) / 2; rbh_ = S(28);
  slider17 >= 0.5 ? (rc(K_ACC, 1); gfx_rect(RCX, rby_, RRW, rbh_);) : (rc(K_PLY, 1); frame2(RCX, rby_, RRW, rbh_, S(2)););
  rc(slider17 >= 0.5 ? K_BG2 : K_ACC, 1); gfx_circle(RCX + S(9), rby_ + rbh_ / 2, S(3), 1, 1);
  sfont(4, S(16)); slider17 >= 0.5 ? rc(K_BG2, 1) : rc(K_PLY, 1);
  slider17 >= 0.5 && trecn > 0 ? sprintf(#t, "%d", trecn) : strcpy(#t, "REC");
  ctxt(#t, RCX + S(14), rby_ + (rbh_ - S(16) * SFK) / 2, RRW - S(14));
  cx_ = RCX + RRW + S(4); cw_ = RCW - RRW - S(4);
  calon ? (rc(K_FOC, 1); gfx_rect(cx_, rby_, cw_, rbh_);) : (rc(K_LINE, 1); frame2(cx_, rby_, cw_, rbh_, S(2)););
  sfont(4, S(14));
  calon ? (rc(K_FOCT, 1); sprintf(#t, "%d/8", caln);) : slider18 != 0 ? (rc(K_TXT, 1); sprintf(#t, "%dms", slider18);) : (rc(K_DIM, 1); strcpy(#t, "CAL"););
  ctxt(fit(#t, cw_ - S(2)), cx_, rby_ + (rbh_ - S(14) * SFK) / 2, cw_);
  caldone ? (caldone = 0; sprintf(#rd, "CAL DONE · you play %d ms %s · recorded hits are corrected", abs(slider18), slider18 >= 0 ? "late" : "early"); msgt = now;);
  trecn != ltrecn ? (ltrecn = trecn; bump(););   // recorded hits mark the project changed
  sfont(3, S(16)); rc(K_LBL, 1); txt("PAGE", MG, PGY + (PGH - S(16) * SFK) / 2);
  i = 0;
  loop(4,
    x = pbx(i); pby_ = PGY + (PGH - S(28)) / 2;
    btn(x, pby_, PBW, S(28), "", i == page, i == page || i * 16 < LEN[focus]);
    sfont(4, S(18)); i == page ? rc(K_FOCT, 1) : i * 16 < LEN[focus] ? rc(K_PLY, 1) : rc(K_DIM, 1);
    sprintf(#n, "%d", i + 1); ctxt(#n, x, pby_ + (S(28) - S(18) * SFK) / 2, PBW);
    CUR[focus] >= 0 && floor(CUR[focus] / 16) == i ? (i == page ? rc(K_FOCT, 1) : rc(K_ACC, 1); gfx_circle(x + PBW - S(6), pby_ + S(6), S(2), 1, 1););
    i += 1;
  );
  k = 0;
  loop(16,
    x = cellx(k); s = page * 16 + k;
    cu_ = CUR[focus] == s; db_ = k % 4 == 0;
    cu_ ? rc(K_FOC, 1) : db_ ? rc(K_PLY, 1) : rc(K_LINE, 1); gfx_rect(x, PGY + PGH - S(3), CW, S(3));
    fs_ = db_ ? S(23) : S(19); sfont(4, fs_);
    cu_ ? rc(K_FOC, 1) : db_ ? rc(K_TXT, 1) : rc(K_DIM, 1);
    sprintf(#n, "%02d", s + 1); ctxt(#n, x, PGY + PGH - S(5) - fs_ * SFK, CW);
    k += 1;
  );

  // ---- view tabs ----
  sfont(3, S(16)); rc(K_LBL, 1); txt("VIEW", MG, TBY + (TBH - S(16) * SFK) / 2);
  BTNFS = S(17); BTNBOLD = 1; i = 0; loop(NTAB, btn(GX + i * (TABW + S(6)), TBY, TABW, TBH, tabname(tabat(i)), tabat(i) == tab, tabat(i) != 6 || anypit); i += 1;); BTNFS = 0; BTNBOLD = 0;
  tab == 5 ? (
    pwarn = (plk == 4 || plk == 11) && PON[focus];
    plgroup(pwarn);
    sfont(5, S(14));   // v0.58.5: hint (or the PIT warning) right of RANGE
    pwarn ? (rc(K_HOT, 1); sprintf(#t, "PART %d PIT ON: use the PITCH tab", focus + 1);) : (rc(K_DIM, 1); strcpy(#t, "drag · height = value · Alt = reset"););
    txt(fit(#t, PHW), PHX, TBY + (TBH - S(14) * SFK) / 2);
  );
  (tab > 0 && tab < 5) || tab == 6 ? (
    sfont(5, S(14));
    tab == 6 && !PON[focus] ? (rc(K_HOT, 1); sprintf(#t, "PART %d PIT OFF · turn PIT on", focus + 1); txt(fit(#t, PARW - S(6)), PARX + S(6), TBY + (TBH - S(14) * SFK) / 2);)
    : (rc(K_DIM, 1); txt(fit(tab == 6 ? "height = semitones · Alt = 0" : "drag · height = value · Alt = reset", PARW - S(6)), PARX + S(6), TBY + (TBH - S(14) * SFK) / 2););
  );

  // ---- lanes ----
  mw = (GW - (NSTEP - 1) * S(2)) / NSTEP;
  p = 0;
  loop(NP,
    y0 = laney(p); act = p == focus; ly1_ = lrow1(p); ly2_ = lrow2(p);
    rc(K_LINE, 1); gfx_rect(MG, y0 - S(8), gfx_w - 2 * MG, S(2));
    // big part number: outlined, focused lane = filled block
    sfont(1, S(50)); sprintf(#t, "%02d", p + 1);
    gfx_measurestr(#t, nw_, nh_); nx_ = LSX + (NUMW - nw_) / 2; ny_ = y0 + (LH - nh_) / 2;
    act ? (rc(K_FOC, 1); gfx_rect(LSX, y0, NUMW, LH); rc(K_FOCT, 1); txt(#t, nx_, ny_);)
        : otxt(#t, nx_, ny_, max(1, S(1)));
    hreg == 1 && hp == p && !act ? (rc(K_LINE, 1); frame(LSX, y0, NUMW, LH););
    // silent lane: number block dimmed · soloed lane: focus bar under the number
    lm_ = lmute(p); ls_ = (slider14 | 0) & (2 ^ p);
    ls_ ? (rc(K_FOC, 1); gfx_rect(LSX, y0 + LH - S(4), NUMW, S(4));) : lm_ ? (rc(K_BG2, 0.6); gfx_rect(LSX, y0, NUMW, LH); hcross(LSX + S(8), y0 + S(5), NUMW - S(16), LH - S(10), p););
    // row 1: position · LEN · RATE · M · S
    sfont(5, S(15));
    CUR[p] >= 0 ? (rc(K_ACC, 1); sprintf(#t, "%02d/%02d", CUR[p] + 1, LEN[p]);) : (rc(K_DIM, 1); sprintf(#t, "--/%02d", LEN[p]););
    txt(#t, KX, ly1_ + (R1H - S(17)) / 2);
    sfont(3, S(15)); rc(K_LBL, 1);
    txt("LEN", KX + S(38), ly1_ + (R1H - S(17)) / 2); txt("RATE", KX + S(92), ly1_ + (R1H - S(17)) / 2);
    sprintf(#t, "%d", LEN[p]);
    sval(LENX, ly1_, LENW, R1H, #t, (drag == 5 && (dlane == p || dall)) || (drag == 2 && dall) || (hreg == 5 && hp == p), K_TXT);
    sval(RATX, ly1_, RATW, R1H, rname(RATE[p]), (drag == 3 && (dlane == p || dall)) || (hreg == 4 && hp == p), K_TXT);
    BTNFS = S(14); btn(MUTX, ly1_, MSBW, R1H, "M", (slider13 | 0) & (2 ^ p), 1); btn(SOLX, ly1_, SOLW, R1H, "S", ls_, 1); BTNFS = 0;
    // row 2: direction · swing · humanize · pitch
    hreg == 10 && hp == p ? rc(K_FOC, 1) : DIR[p] == 0 ? rc(K_LBL, 1) : rc(K_TXT, 1);
    dcx = DIRX + DIRW / 2; dcy = ly2_ + R2H / 2;
    DIR[p] == 0 ? gfx_triangle(dcx - S(3), dcy - S(5), dcx - S(3), dcy + S(5), dcx + S(5), dcy)
    : DIR[p] == 1 ? gfx_triangle(dcx + S(3), dcy - S(5), dcx + S(3), dcy + S(5), dcx - S(5), dcy)
    : DIR[p] == 2 ? (gfx_triangle(dcx - S(8), dcy, dcx - S(1), dcy - S(5), dcx - S(1), dcy + S(5));
                     gfx_triangle(dcx + S(8), dcy, dcx + S(1), dcy - S(5), dcx + S(1), dcy + S(5));)
    : (sfont(4, S(16)); ctxt("?", DIRX, ly2_ + (R2H - S(16)) / 2, DIRW););
    sfont(3, S(15)); rc(K_LBL, 1);   // direction = arrow only (no room for the word at this size)
    txt("HUM", KX + S(92), ly2_ + (R2H - S(17)) / 2);
    GRV[p] ? (rc(K_ACC, 1); txt("GRV", KX + S(22), ly2_ + (R2H - S(17)) / 2); rc(K_LBL, 1);) : txt("SWG", KX + S(22), ly2_ + (R2H - S(17)) / 2);
    GRV[p] ? sval(SWGX, ly2_, SWGW, R2H, gshort(GRV[p]), ((drag == 9 || drag == 24) && (focus == p || dall)) || (hreg == 9 && hp == p), K_ACC)   // v0.56: groove in the box
    : (sprintf(#t, "%d%%", lsw(p)); sval(SWGX, ly2_, SWGW, R2H, #t, (drag == 9 && (focus == p || dall)) || (hreg == 9 && hp == p), SW[p] >= 50 ? K_TXT : K_DIM););
    sprintf(#t, "%d%%", HT[p]); sval(HTX, ly2_, HTW, R2H, #t, (drag == 6 && focus == p) || (hreg == 6 && hp == p), HT[p] > 0 ? K_TXT : K_DIM);
    sprintf(#t, "%d%%", HV[p]); sval(HVX, ly2_, HVW, R2H, #t, (drag == 7 && focus == p) || (hreg == 7 && hp == p), HV[p] > 0 ? K_TXT : K_DIM);
    sfont(3, S(15)); rc(K_LBL, 1); txt("PIT", KX + S(196), ly2_ + (R2H - S(17)) / 2);
    pith_ = (drag == 19 && (dlane == p || dall)) || (hreg == 19 && hp == p);
    sfont(4, S(17)); pith_ ? rc(K_FOC, 1) : PON[p] ? rc(K_TXT, 1) : rc(K_DIM, 1);
    rtxt(PON[p] ? nname(PBNOTE[p]) : "OFF", PITX + PITW, ly2_ + (R2H - S(17) * SFK) / 2);
    pith_ ? gfx_rect(PITX, ly2_ + R2H - S(2), PITW, S(2));

    // overview strip
    s = 0;
    loop(NSTEP,
      x = GX + s * (mw + S(2));
      CUR[p] == s ? rc(K_ACC, 1)
      : s < LEN[p] ? (ON[p * NSTEP + s] ? rc(K_BAR, 1) : rc(K_LINE, s >= page * 16 && s < page * 16 + 16 ? 1 : 0.6))
      : rc(K_LINE2, 1);
      gfx_rect(x, y0, max(1, mw), OVH);
      s += 1;
    );
    x = GX + LEN[p] * (mw + S(2)) - S(1);
    (drag == 2 && dlane == p) || (hreg == 2 && hp == p) ? (rc(K_ACC, 0.3); gfx_rect(x - S(4), y0 - S(3), S(7), OVH + S(6)););
    rc(K_ACC, 1); gfx_rect(x - S(1), y0 - S(2), S(3), OVH + S(4));

    // step cells
    k = 0;
    loop(16,
      s = page * 16 + k; idx = p * NSTEP + s; x = cellx(k); y = y0 + CY0;
      s >= LEN[p] ? (
        rc(K_LINE2, 1); frame(x, y, CW, CH);
      ) : (
        rc(K_LINE2, 1); gfx_rect(x, y, CW, CH); rc(K_LINE, 1); frame(x, y, CW, CH);
        ON[idx] && tab == 5 ? (
          rc(K_ACC, ta_); gfx_rect(x, y, CW, CH);
          lv = PL[idx * NPL + plk]; lr_ = (lv >= 128 ? floor(lv / 128) : 0); lv >= 0 ? (lv = lv % 128;);
          sfont(5, S(17));
          lv >= 0 ? (
            bh = max(1, lv / 127 * CH); rc(K_FOC, lr_ > 0 ? 0.3 : 0.9); gfx_rect(x, y + CH - bh, CW, bh);
            lr_ > 0 ? (   // random range: band value - range .. value + range; RANGE mode = edges lit, VALUE mode = value line lit
              yt_ = y + CH - min(127, lv + lr_) / 127 * CH; yb_ = y + CH - max(0, lv - lr_) / 127 * CH;
              rc(K_TXT, 0.2); gfx_rect(x, yt_, CW, max(1, yb_ - yt_));
              plrng ? rc(K_FOC, 1) : rc(K_TXT, 0.6); ew_ = (plrng ? S(3) : S(1)); gfx_rect(x, yt_, CW, ew_); gfx_rect(x, yb_ - ew_, CW, ew_);
              yv_ = y + CH - bh; plrng ? rc(K_TXT, 0.8) : rc(K_FOC, 1); gfx_rect(x, yv_ - (plrng ? 0 : S(2)), CW, plrng ? S(1) : S(4));
              // last value really sent (tick on the right edge): jumps every loop while playing
              yr_ = y + CH - LKR[idx * NPL + plk] / 127 * CH; rc(K_TXT, 1); gfx_rect(x + CW - S(10), yr_ - S(2), S(10), S(4));
            );
            rc(K_TXT, 1); sprintf(#t, "%d", lv); ctxt(#t, x, y + S(3), CW);
            lr_ > 0 ? (sfont(5, S(14)); sprintf(#t, "±%d", lr_); ctxt(#t, x, y + S(20), CW););
          ) : (rc(K_DIM, 1); ctxt("-", x, y + S(3), CW););
          pnl ? (pv = gmem[1000 + pidx(p, plk)]; rc(K_PLY, 0.8); gfx_rect(x, y + CH - pv / 127 * CH, CW, S(2)););
        ) : ON[idx] && tab > 0 ? (
          rc(K_ACC, ta_); gfx_rect(x, y, CW, CH);
          tab == 1 ? (bv = VEL[idx] / 127; rc(K_ACC, 1);)
          : tab == 2 ? (bv = CHN[idx] / 100; rc(K_FOC, 0.9);)
          : tab == 3 ? (bv = min(SLC[idx], 5) / 5; rc(K_BAR, 1);)
          : tab == 6 ? (bv = PIT[idx] / 24; PON[p] ? rc(K_ACC, 1) : rc(K_BAR, 0.5);)
          : (bv = OFS[idx] / 40; rc(K_BAR, 1););
          tab == 4 || tab == 6 ? (
            bh = abs(bv) * CH / 2; bv >= 0 ? gfx_rect(x, y + CH / 2 - bh, CW, max(1, bh)) : gfx_rect(x, y + CH / 2, CW, max(1, bh));
            rc(K_PLY, 0.5); gfx_rect(x, y + CH / 2, CW, 1);
          ) : (
            bh = max(1, bv * CH); gfx_rect(x, y + CH - bh, CW, bh);
          );
          sfont(5, S(17)); rc(K_TXT, 1);
          tab == 1 ? sprintf(#t, "%d", VEL[idx]) : tab == 2 ? sprintf(#t, "%d", CHN[idx]) :
          tab == 3 ? strcpy(#t, slname(SLC[idx])) : tab == 6 ? sprintf(#t, "%+d", PIT[idx]) : sprintf(#t, "%+d", OFS[idx]);
          ctxt(#t, x, y + S(3), CW);
          tab == 6 && PON[p] ? (sfont(5, S(13)); rc(K_TXT, 0.75); ctxt(nname(max(0, min(127, PBNOTE[p] + PIT[idx]))), x, y + CH - S(17), CW););
        ) : ON[idx] == 2 ? (
          // TRIGLESS: focus frame + LOCK + number of locked params
          rc(K_FOC, 1); frame2(x, y, CW, CH, S(2));
          sfont(3, S(14)); ctxt("LOCK", x, y + CH / 2 - S(14), CW);
          sfont(4, S(18)); haslk(idx) ? (sprintf(#t, "%d", haslk(idx)); ctxt(#t, x, y + CH / 2, CW);) : (rc(K_ACC, 1); ctxt("0", x, y + CH / 2, CW););
          sfont(5, S(14)); rc(K_TXT, 0.9);
          CHN[idx] < 100 ? (sprintf(#t, "%d%%", CHN[idx]); txt(#t, x + S(4), y + S(4)););
          CND[idx] > 0 ? rtxt(CNM[CND[idx]], x + CW - S(4), y + S(4));
        ) : ON[idx] ? (
          // hit: tint + bar from the bottom (= velocity), value on top, slice on the bar
          rc(K_ACC, ta_); gfx_rect(x, y, CW, CH);
          bh = VEL[idx] / 127 * CH; rc(K_ACC, 1); gfx_rect(x, y + CH - bh, CW, bh);
          // top number: velocity, or the step pitch on a PIT lane (velocity still shows as the bar)
          sfont(4, S(21)); rc(K_TXT, 1); PON[p] && PIT[idx] != 0 ? sprintf(#t, "%+d", PIT[idx]) : sprintf(#t, "%d", VEL[idx]); ctxt(#t, x, y + S(2), CW);
          sfont(5, S(14));
          CHN[idx] < 100 ? (rc(K_TXT, 0.9); sprintf(#t, "%d%%", CHN[idx]); txt(#t, x + S(3), y + S(26)););
          CND[idx] > 0 || (CHN[idx] < 100 && CTG[idx] > 0) ? (
            rc(K_TXT, 0.9); strcpy(#t, CND[idx] > 0 ? CNM[CND[idx]] : ""); CTG[idx] == 1 ? strcat(#t, ">S") : CTG[idx] == 2 ? strcat(#t, ">L");
            rtxt(#t, x + CW - S(3), y + S(26));
          );
          SLC[idx] > 0 ? (
            sfont(4, S(16)); slcur_ = 0; rc(K_BG2, 1); strcpy(#t, slname(SLC[idx]));
            RMP[idx] != 0 ? (gfx_measurestr(#t, sw_, sh_); txt(#t, x + (CW - sw_) / 2 - S(6), y + CH - S(18));
              wx = x + (CW + sw_) / 2 - S(2); wy = y + CH - S(15);
              RMP[idx] > 0 ? gfx_triangle(wx, wy + S(8), wx + S(9), wy + S(8), wx + S(9), wy)
                           : gfx_triangle(wx, wy, wx, wy + S(8), wx + S(9), wy + S(8));)
            : ctxt(#t, x, y + CH - S(18), CW);
          );
          haslk(idx) ? (rc(K_FOC, 1); gfx_circle(x + S(7), y + S(9), S(3), 1, 1););
          OFS[idx] != 0 ? (rc(K_PLY, 0.9); gfx_rect(x + CW / 2 + OFS[idx] / 100 * CW - S(1), y, S(2), S(6)););
        );
        // current step: fg bar on top · hover frame
        CUR[p] == s ? (rc(K_PLY, 1); gfx_rect(x, y, CW, S(4));)
        : hreg == 3 && hp == p && hk == k ? (rc(K_LBL, 0.7); frame(x, y, CW, CH););
        SELM[idx] ? (
          rc(K_SEL, 1); frame2(x - S(3), y - S(3), CW + S(6), CH + S(6), S(2));
          selp == p && sels == s ? frame(x - S(4), y - S(4), CW + S(8), CH + S(8));
        );
        s == LEN[p] - 1 ? (rc(K_ACC, 1); gfx_rect(x + CW - S(3), y, S(3), CH););
      );
      k += 1;
    );
    lm_ ? (rc(K_BG2, 0.6); gfx_rect(GX, y0, GW, LH););   // silent lane: cells dimmed
    p += 1;
  );
  // ---- ACCENT row (Sleeve): strip = LEN, RATE, PARTS, PARAM + amount; cells = accent steps of the current page ----
  ACH > 0 ? (
    rc(K_LINE, 1); gfx_rect(MG, ACY - S(8), gfx_w - 2 * MG, S(2));
    rc(K_FOC, 1); gfx_rect(LSX, ACY, S(4), ACH);
    sfont(4, S(20)); rc(K_FOC, 1); txt("ACCENT", LSX + S(10), AY1 + (R1H - S(20) * SFK) / 2);
    sfont(3, S(15)); rc(K_LBL, 1);
    txt("LEN", KX + S(38), AY1 + (R1H - S(17)) / 2); txt("RATE", KX + S(92), AY1 + (R1H - S(17)) / 2);
    txt("PARTS", LSX + S(10), AY2 + (R2H - S(17)) / 2);
    sprintf(#t, "%d", AC[64]); sval(LENX, AY1, LENW, R1H, #t, drag == 91 || hreg == 91, K_TXT);
    sval(RATX, AY1, RATW, R1H, rname(AC[65]), drag == 92 || hreg == 92, K_TXT);
    acany = (AC[69] != 0); i = 0; loop(26, ACP[i] != 0 ? (acany += 1;); i += 1;);
    hreg == 95 ? rc(K_FOC, 1) : rc(K_LINE, 1); frame2(APX, AY2, APW, R2H, S(2));
    sfont(5, S(14)); acget(acsel) != 0 ? rc(K_TXT, 1) : rc(K_DIM, 1);
    acoth = acany - (acsel > 0 && acget(acsel) != 0);   // other params with an amount
    strcpy(#t, acsel == 0 ? "VEL" : acsel == NPL + 1 ? "NOTE" : pname(acsel - 1)); acoth > 0 ? (sprintf(#n, " +%d", acoth); strcat(#t, #n););
    ctxt(fit(#t, APW - S(6)), APX, AY2 + (R2H - S(14) * SFK) / 2, APW);
    sprintf(#t, "%+d", acget(acsel)); sval(AMX, AY2, AMW, R2H, #t, drag == 93 || hreg == 93, acget(acsel) != 0 ? K_TXT : K_DIM);
    BTNFS = S(14); i = 0;
    loop(6, sprintf(#t, "%d", i + 1); btn(AKX0 + i * (AKW + S(4)), AY2, AKW, R2H, #t, (AC[67] | 0) & (2 ^ i), 1); i += 1;);
    BTNFS = 0;
    // overview strip: all 64 accent steps (drag = length)
    s = 0;
    loop(NSTEP,
      x = GX + s * (mw + S(2));
      ACUR == s ? rc(K_ACC, 1)
      : s < AC[64] ? (AC[s] ? rc(K_FOC, 1) : rc(K_LINE, s >= page * 16 && s < page * 16 + 16 ? 1 : 0.6))
      : rc(K_LINE2, 1);
      gfx_rect(x, ACY, max(1, mw), OVH);
      s += 1;
    );
    x = GX + AC[64] * (mw + S(2)) - S(1);
    drag == 96 || hreg == 96 ? (rc(K_FOC, 0.3); gfx_rect(x - S(4), ACY - S(3), S(7), OVH + S(6)););
    rc(K_FOC, 1); gfx_rect(x - S(1), ACY - S(2), S(3), OVH + S(4));
    ACCH = ACH - CY0;
    k = 0;
    loop(16,
      s = page * 16 + k; x = cellx(k); y = ACY + CY0;
      s >= AC[64] ? (
        rc(K_LINE2, 1); frame(x, y, CW, ACCH);
      ) : (
        rc(K_LINE2, 1); gfx_rect(x, y, CW, ACCH); rc(K_LINE, 1); frame(x, y, CW, ACCH);
        AC[s] ? (
          rc(K_FOC, 1); gfx_rect(x, y, CW, ACCH);
          rc(K_FOCT, 1); ax_ = x + CW / 2; ay_ = y + ACCH / 2;   // accent mark ">"
          gfx_triangle(ax_ - S(6), ay_ - S(7), ax_ - S(6), ay_ - S(4), ax_ + S(6), ay_ + S(1), ax_ + S(6), ay_ - S(2));
          gfx_triangle(ax_ - S(6), ay_ + S(7), ax_ - S(6), ay_ + S(4), ax_ + S(6), ay_ - S(1), ax_ + S(6), ay_ + S(2));
        );
        ACUR == s ? (rc(K_PLY, 1); gfx_rect(x, y, CW, S(4));)
        : hreg == 90 && hk == k ? (rc(K_LBL, 0.7); frame(x, y, CW, ACCH););
        s == AC[64] - 1 ? (rc(K_ACC, 1); gfx_rect(x + CW - S(3), y, S(3), ACCH););   // row ends here
      );
      k += 1;
    );
    !(AC[67] | 0) || (AC[66] == 0 && !acany) ? (rc(K_BG2, 0.6); gfx_rect(GX, ACY, GW, ACH););   // nobody listens / nothing to do: dimmed
  );
  drag == 20 && dmoved ? (
    ka = max(0, min(bs0, bs1) - page * 16); kb = min(15, max(bs0, bs1) - page * 16);
    ka <= kb ? (
      x = cellx(ka) - S(3); x2 = cellx(kb) + CW + S(3);
      y = laney(min(bp0, bp1)) + CY0 - S(3); y2 = laney(max(bp0, bp1)) + LH + S(3);
      rc(K_PLY, 0.08); gfx_rect(x, y, x2 - x, y2 - y);
      rc(K_SEL, 0.9); frame(x, y, x2 - x, y2 - y);
    );
  );

  // ---- bottom (layout B): thick rule · full-width mode tabs · 9 big value columns ----
  rc(K_PLY, 1); gfx_rect(0, EY - S(6), gfx_w, S(6));
  BTNFS = S(21); i = 0;   // mode tabs: bigger than the buttons below (19)
  BTNDY = -max(1, S(1)); BTNBOLD = 1; loop(NMB, btn(MBX + i * (MBW + MBG), MBY, MBW, MBH, mbname(mbat(i)), mbat(i) == smode, 1); i += 1;); BTNDY = 0; BTNBOLD = 0;   // v0.58.7: 1 px up
  BTNFS = 0;
  rc(K_LINE, 1); gfx_rect(MG, BCY - S(2), BCW, S(2));
  sfont(5, S(16)); rc(K_LBL, 1);
  rtxt(smode == 0 ? "values of the selected steps" : smode == 1 ? "euclid rhythms + randomize" : smode == 2 ? "copy, clear, reset, undo"
     : smode == 3 ? "roll a whole beat in a genre style" : smode == 4 ? "groove of the focused lane" : smode == 5 ? "send the hits to other tracks" : "the sound of each pattern", BCX + BCW, MBY + (MBH - S(14) * SFK) / 2);
  six = selidx();
  smode == 0 ? (
    c_ = 0; loop(8, rc(K_LINE, 1); gfx_rect(BCX + (c_ + 1) * COLW - S(2), BCY, S(2), EDH - BTH); c_ += 1;);
    x = fldx(0);
    sfont(3, S(15)); rc(K_LBL, 1); txt("SELECTED", x, BCY + S(4));
    sfont(4, S(24)); rc(K_FOC, 1);
    nsel > 1 ? sprintf(#t, "%d STEPS", nsel) : sprintf(#t, "P%d · STEP %02d", selp + 1, sels + 1);
    txt(fit(#t, FW), x, BCY + S(24));
    // v0.58.5: TRIGLESS toggle button (lit = trigless) replaces the ON / OFF / TRIGLESS status line
    btn(x, TGY, FW, TGH, "", ON[six] == 2, 1); sfont(4, S(16)); ON[six] == 2 ? rc(K_FOCT, 1) : rc(K_PLY, 1);
    ctxt("TRIGLESS", x, TGY + (TGH - S(16) * SFK) / 2, FW);
    hreg == 81 ? (rc(K_TXT, 0.7); frame(x - 1, TGY - 1, FW + 2, TGH + 2););
    f = 1;
    loop(8,
      x = fldx(fldpos(f)); hot_ = drag == 10 + f || hreg == 10 + f;
      sfont(3, S(15)); rc(K_LBL, 1);
      txt(f == 1 ? "VELOCITY" : f == 2 ? "SLICE" : f == 3 ? "CONDITION" : f == 4 ? "OFFSET" : f == 6 ? "RAMP" : f == 7 ? "PITCH" : f == 8 ? "IF > ONLY" : "CHANCE", x, BCY + S(4));
      f == 1 ? sprintf(#t, "%d", VEL[six]) : f == 2 ? strcpy(#t, slname(SLC[six])) :
      f == 3 ? strcpy(#t, CNM[CND[six]]) : f == 4 ? sprintf(#t, "%+d%%", OFS[six]) :
      f == 8 ? strcpy(#t, tgname(CTG[six])) :
      f == 7 ? (PON[selp] ? sprintf(#t, "%+d %s", PIT[six], nname(max(0, min(127, PBNOTE[selp] + PIT[six])))) : sprintf(#t, "%+d", PIT[six])) :
      f == 6 ? (RMP[six] == 0 ? strcpy(#t, "-") : sprintf(#t, "%+d%%", RMP[six])) : sprintf(#t, "%d%%", CHN[six]);
      sfont(4, S(30)); slsp_ = S(2); hot_ ? rc(K_ACC, 1) : (f == 7 && !PON[selp]) || (f == 8 && CTG[six] == 0) ? rc(K_DIM, 1) : rc(K_TXT, 1);
      txt(fit(#t, FW), x, BCY + S(16));
      // bar under the value (velocity, chance, ramp) · offset / pitch = tick
      rc(K_LINE, 1); gfx_rect(x, BCY + S(56), FW, S(4));
      bw_ = (f == 1 ? VEL[six] / 127 : f == 5 ? CHN[six] / 100 : f == 6 ? abs(RMP[six]) / 100 : 0);
      rc(K_ACC, 1); bw_ > 0 ? gfx_rect(x, BCY + S(56), FW * bw_, S(4));
      f == 4 ? gfx_rect(x + FW / 2 + OFS[six] / 100 * FW - S(1), BCY + S(54), S(3), S(8));
      f == 7 ? gfx_rect(x + FW / 2 + PIT[six] / 48 * FW - S(1), BCY + S(54), S(3), S(8));
      sfont(5, S(15)); rc(K_DIM, 1);
      txt(fit(f == 1 ? "63 = panel level" : f == 2 ? "o = hit  _ = rest" : f == 3 ? "A:B · 1st · fill · pre · nei" : f == 4 ? "early - / late +" : f == 6 ? "+ louder / - softer" : f == 7 ? (PON[selp] ? "semitones" : "lane PIT is off") : f == 8 ? "what the IF hits" : "dice roll per step", FW),
          x, BCY + S(64));
      f += 1;
    );
  );
);

// ---- explanation text on the right of a bottom-strip mode: line n (0-2), readable size + label color ----
function expl(s, x, n) (
  skin ? sfont(5, S(15)) : gfx_setfont(3, "Bahnschrift", CF(S(12)));
  rc(K_LBL, 1); txt(s, x, BCY + S(skin ? 8 : 12) + n * S(skin ? 22 : 21));
);
function exsep(x) ( rc(K_FLDB, 1); gfx_rect(x - S(14), BCY + S(8), 1, EDH - BTH - S(16)); );
// ---- GEN / TOOLS (both looks; btn and vbox draw in the current look) ----
spk_ = (smode == 1 || smode == 2 || smode == 3 || smode == 5 || smode == 6 ? 0.5 : 1);   // v0.58.10: GEN TOOLS BEAT ROUTE KIT = half letter spacing (user)
smode == 1 ? (
  // GEN: Euclid (live) + shift + randomize
  skin ? sfont(3, S(15)) : gfx_setfont(3, "Bahnschrift", CF(S(13)), 'b'); rc(K_LBL, 1);
  sprintf(#t, "EUCLID · PART %d", focus + 1); txt(#t, G_HX, BLY);
  txt("RANDOMIZE", G_WX, BLY);
  rc(K_FLDB, 1); gfx_rect(G_WX - S(12), BCY + S(8), 1, EDH - BTH - S(16));
  sprintf(#t, "%d / %d", EUH[focus], LEN[focus]); vbox(G_HX, FBY, S(70), FBH, #t, drag == 61 || hreg == 61, S(16));
  btn(G_SLX, FBY, S(36), FBH, "<", 0, 1); btn(G_SRX, FBY, S(36), FBH, ">", 0, 1);
  vbox(G_WX, FBY, S(110), FBH, wname(rwhat), hreg == 65, S(15));
  sprintf(#t, "%d%%", ramt); vbox(G_AX, FBY, S(70), FBH, #t, drag == 66 || hreg == 66, S(16));
